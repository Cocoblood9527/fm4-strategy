[{"w":0.1401273837456336,"h":0.0203488364803468,"text":"雷霆任務4","conf":0.5,"x":0.7154989408107064,"y":0.9447674422557745},{"w":0.15304864369905913,"h":0.026664030189482824,"text":"戰術方針","conf":1,"x":0.3905669731609397,"y":0.8965517066398688},{"w":0.7244407947246845,"h":0.0237006388831158,"text":"本關敵方的進攻路線主要分成左右兩路，左路是1台直昇機加1台敵方機","conf":0.5,"x":0.10592982524202323,"y":0.810272057905045},{"w":0.7223002360417292,"h":0.023557282121042467,"text":"甲、右路是1台直昇機加2台敵方機甲。雖然說本關敗北條件有一條是","conf":0.5,"x":0.10804329543038599,"y":0.7825526118890321},{"w":0.7156661106989934,"h":0.023765382163330684,"text":"『運輸機被擊破』，但是因為我方運輸機皮厚血多，因此玩家基本上不用","conf":1,"x":0.11245044853323094,"y":0.7539830001254333},{"w":0.7244529724121094,"h":0.024356476870735055,"text":"太擔心運輸機會被打爆。另一方面，敵方的直昇機會一直以我方的運輸機","conf":1,"x":0.10593145800430662,"y":0.7265916876257186},{"w":0.7223833524263821,"h":0.024100860808849767,"text":"作為攻擊目標，所以玩家可以先把攻略重點擺在其他3台敵方機甲上，左","conf":0.5,"x":0.10801202813678817,"y":0.6986524496299626},{"w":0.7181155865009013,"h":0.02421874028302251,"text":"路的格鬥型機甲就交給哈米茲對付，右路的兩台機甲就交給愛爾莎處理，","conf":1,"x":0.10803611435037304,"y":0.6708642972326242},{"w":0.7223033905029297,"h":0.023674467301505908,"text":"至於吉德就讓他待在中間隨時用飛彈支援其他人，等到敵軍機甲消滅之後","conf":1,"x":0.10806217704462366,"y":0.642999046236802},{"w":0.47174937908466047,"h":0.02155720061127442,"text":"，剩下來的兩台直昇機就只能任玩家們宰割了。","conf":1,"x":0.11020241442497454,"y":0.6153149429116083},{"w":0.18066314550546497,"h":0.023975629344178406,"text":"敵方機體資料","conf":1,"x":0.15276821577025318,"y":0.496733115702479},{"w":0.0700636918728168,"h":0.013247405689273961,"text":"腳部HP","conf":0.30000001192092896,"x":0.766454353532806,"y":0.4576828269355243},{"w":0.0700636918728168,"h":0.01453488364803468,"text":"右手HP","conf":0.30000001192092896,"x":0.6772823790268448,"y":0.45639534892956046},{"w":0.0700636918728168,"h":0.013202021919319407,"text":"左手HP","conf":0.5,"x":0.5881104044915374,"y":0.4563953488120892},{"w":0.0424628441150372,"h":0.014790468364831555,"text":"移動","conf":1,