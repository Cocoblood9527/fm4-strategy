[{"y":0.8893317737247619,"h":0.028022499460923056,"w":0.17945577762576448,"x":0.44508223682097603,"text":"劇情提要","conf":1},{"y":0.8182565787338396,"h":0.01895272339645182,"w":0.7194092962224045,"x":0.183544296835638,"text":"打倒來襲的委內瑞拉軍、達利爾一行人成功俘虜了當中一名士兵。經過盤","conf":1},{"y":0.7859679334943268,"h":0.02108738767473317,"w":0.7406933768552356,"x":0.1623537371175011,"text":"問之後才知道，原來委內瑞拉軍真的知道是達利爾他們偷走了黃金、而且原","conf":1},{"y":0.755516438243719,"h":0.02033158038791849,"w":0.7406825973765662,"x":0.16235737767487,"text":"因還是因為奇佛當初忘了把無線電關掉、結果才會導致達利爾一行人的行蹤","conf":1},{"y":0.7170085114854589,"h":0.03289219893907247,"w":0.7412421834212783,"x":0.15995615150930786,"text":"曝光、就連好不容易才『A』來的卡車也因為剛才的戰鬥而報銷了。可想而","conf":1},{"y":0.692895807902985,"h":0.02104801096414266,"w":0.7407169023390887,"x":0.16023176469829475,"text":"知，奇佛自然是被生氣的達利爾給狠狠K了一頓。在不得已的情況下，達利","conf":0.5},{"y":0.6627906978800715,"h":0.01895272339645193,"w":0.7405063383334577,"x":0.16033754793815044,"text":"爾竟然異想天開的想潛入附近的委內瑞拉軍基地再偷一輛卡車，於是乎，為","conf":1},{"y":0.6271103591361309,"h":0.03014034817093303,"w":0.7389642902092035,"x":0.16006256175765915,"text":"了一圓黃金夢，達利爾一行人便開始往距離最近『奇尼拉馬基地』前進。","conf":1},{"y":0.5686790057172769,"h":0.020589848882273665,"w":0.7174898935104043,"x":0.18134733571158057,"text":"或許是因為那些黃金真的很重要的緣故吧，當眾人潛入基地內部之後，想","conf":1},{"y":0.5318769796180294,"h":0.030962882857573648,"w":0.7411636680293482,"x":0.15788598480799945,"text":"不到連迪亞茲州長本人也來到『奇尼拉馬基地』關切黃金的去處。發現迪亞","conf":1},{"y":0.5025296823700218,"h":0.02849657284586049,"w":0.7429990927757683,"x":0.15594393632697837,"text":"茲州長『確實』不是什麼好人的達利爾，這下子他總算是可以『放心』的把","conf":1},{"y":0.4745380007807267,"h":0.022282934502551477,"w":0.7408140633157443,"x":0.1580762341097543,"text":"黃金A走了。只是基地裡頭的衛兵也不是省油的燈，達利爾偷卡車的行動馬","conf":1},{"y":0.4434167005093934,"h":0.02177637501766816,"w":0.7428621642629399,"x":0.15599581888556333,"text":"上就被衛兵視破，為求脫身，達利爾一行人只好硬著跟基地裡頭的機甲部隊","conf":1},{"y":0.4152718774445311,"h":0.01829345445883901,"w":0.1141923344505146,"x":0.15598400141960897,"text":"展開激戰。","conf":1},{"y":0.35073639877925944,"h":0.020698359138087263,"w":0.7196184763760441,"x":0.17711483208607384,"text":"打倒基地內部的機甲跟基地加農砲之後，迪亞茲州長氣急敗壞的要求基地","conf":1},{"y":0.3193182785691425,"h":0.021897378720735272,"w":0.7428441013527372,"x":0.1538975077904509,"text":"指揮官再派人去追回黃金，但是因為奇尼拉馬基地裡頭所有可以行動的機甲","conf":1},{"y":0.2889680220812312,"h":0.020703833354146828,"w":0.7428075385264394,"x":0.15391680582941075,"text":"都已經被達利爾一行人破壞，結果迪亞茲州長只能眼睜睜的看著達利爾帶著","conf":1},{"y":0.2601744187219994,"h":0.01614137072312205,"w":0.3797468308332711,"x":0.1540084409417217,"text":"價值2 500萬美元的黃金揚長而去…","conf":0.5},{"y":0.04934210508006631,"h":0.014802631578947456,"w":0.052742614381922154,"x":0.15189873534595874,"text":"060","conf":1}]