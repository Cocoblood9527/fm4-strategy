[{"text":"戰術方針","w":0.14978903176391895,"y":0.8909883721499406,"conf":0.5,"x":0.4556962013137816,"h":0.026363601810053816},{"text":"我軍一開始就處於被分斷的局面，由於敵方的右側防守非常嚴密，因此玩","w":0.7215190150003729,"y":0.8037790695335545,"conf":1,"x":0.17088606198928055,"h":0.017441860939327092},{"text":"家必須儘快操縱左側的達利爾一行人往右側跟游擊隊會合。另外，高速公","w":0.7172995774444362,"y":0.7746710528168747,"conf":1,"x":0.1729957807889795,"h":0.018933598148195396},{"text":"路工地內部的地形非常的狹窄，玩家的機體在此地很容易成為敵方飛彈兵","w":0.7194092962224046,"y":0.7470930230212888,"conf":1,"x":0.1708860690832026,"h":0.017441860939327092},{"text":"狙擊的目標，建議玩家不妨在工地安排幾隻飛彈型的機體，這樣一來玩家","w":0.7194092962224045,"y":0.7194767439515288,"conf":1,"x":0.17088606908289058,"h":0.017441860939327203},{"text":"就可以利用飛彈引導背包的功能來牽制敵軍。至於本關的頭目•瓦維諾夫","w":0.7194092962224046,"y":0.6918604648818572,"conf":0.5,"x":0.17088606907899564,"h":0.01744186093932698},{"text":"仍然是駕駛著純格鬥型的機體，只要拉遠距離跟他打射擊戰應該是可以無","w":0.7215190150003729,"y":0.66279069787938,"conf":1,"x":0.16877635732774676,"h":0.01895272339645182},{"text":"傷過關才是。","w":0.1332498336464238,"y":0.634592205506982,"conf":0.5,"x":0.1707168543295685,"h":0.020059776149297992},{"text":"敵方機體資料","w":0.17932489436110904,"y":0.4825581394016908,"conf":1,"x":0.21308016874903413,"h":0.020348837501124373},{"text":"腳部HP","w":0.06977229243531147,"y":0.437305270102855,"conf":1,"x":0.8227087903486985,"h":0.013470855198408516},{"text":"石手HP","w":0.06972368918626004,"y":0.43736812006630066,"conf":0.30000001192092896,"x":0.7341254970402126,"h":0.013345155276750287},{"text":"機疆名稱","w":0.07391883194588819,"y":0.43739312655809615,"conf":0.5,"x":0.2024920607116489,"h":0.013295142274153848},{"text":"移動","w":0.03797468308332708,"y":0.43750000006184353,"conf":0.5,"x":0.5021097047733857,"h":0.013157894736842035},{"text":"等級","w":0.03797468308332713,"y":0.43750000005911827,"conf":0.5,"x":0.449367088732598,"h":0.013157894736842146},{"text":"左手HP","w":0.06962025080205148,"y":0.4375000000479693,"conf":0.5,"x":0.6455696212953684,"h":0.013157894736842146},{"te