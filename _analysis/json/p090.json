[{"h":0.0278842292333904,"x":0.4556502338565761,"conf":0.5,"w":0.1688683084201129,"text":"劇情提要","y":0.8894009086615791},{"h":0.01744186093932698,"x":0.18143459229322287,"conf":1,"w":0.7194092962224045,"text":"有了伊凡諾娃部隊的幫助，委內瑞拉獨立軍的勢力一口氣增加了不少。此","y":0.8197674416260514},{"h":0.01895272339645182,"x":0.1582278433474363,"conf":1,"w":0.7405063383334577,"text":"時路易斯開始擔心逮捕迪亞茲計劃難度可能會增加。不過當達利爾一行人","y":0.787790697880445},{"h":0.01744186093932698,"x":0.15822784338601387,"conf":1,"w":0.7405063383334578,"text":"來到官邸附近時，眾人卻發現四周警衛士兵的鬥志與士氣都不高，看樣子長","y":0.757267441625873},{"h":0.017680921052631415,"x":0.15822784337887325,"conf":1,"w":0.7405063383334576,"text":"期以來的內亂已經讓他們無心戀戰了。果不其然，戰鬥才剛剛打到一半，敵","y":0.7265624998750113},{"h":0.02626226842403412,"x":0.155954788282648,"conf":0.5,"w":0.7535811904506639,"text":"方就開始出現士兵逃亡的情況。眼看機不可失，打倒衛兵眾人隨即衝進官","y":0.6903950961299377},{"h":0.01895272339645182,"x":0.15611813919776824,"conf":0.5,"w":0.3164557045001119,"text":"邸之內將迪亞茲州長生擒活捉。","y":0.6627906978820968},{"h":0.017680921052631637,"x":0.17932488764829138,"conf":0.5,"w":0.7194092962224046,"text":"看到貪污腐敗、追害無辜人民的迪亞茲州長就在自已的眼前，憤怒路易","y":0.6015624998749156},{"h":0.017680921052631637,"x":0.15611813162912888,"conf":1,"w":0.7426160571114261,"text":"斯恨不得現在就殺了迪亞茲。但是，目前委內瑞拉的戰亂還沒有結束，就算","y":0.5711348687347624},{"h":0.026162054977918903,"x":0.15599465751730943,"conf":1,"w":0.7428829220428103,"text":"要給迪亞兹州長定罪也要等『委內瑞獨立宣言撤回』、『局勢穩定』、以及","y":0.5359398362785701},{"h":0.027403094266590378,"x":0.1622455526854222,"conf":0.5,"w":0.736603220209017,"text":"『政權𨍭移』之後才能來處理。另一方面，貪生怕死的迪亞玆也是不斷磕","y":0.5017286565736565},{"h":0.01907703515730408,"x":0.15611814088397047,"conf":1,"w":0.7172995774444361,"text":"頭求饒，最後路易斯才在眾人的要求之下打消了當場格殺迪亞茲的念頭。","y":0.4765624996832505},{"h":0.011675718975694527,"x":0.29535865260670063,"conf":0.5,"w":0.10126581852077582,"text":"001000111","y":0.3793604652342696},{"h":0.011627907031460882,"x":0.2932489464690195,"conf":1,"w":0.14767932209023998,"text":"0010001111100","y":0.36337209300826756},{"h":0.0386412535843097,"x":0.4640090192441745,"conf":0.5,"w":0.26607478831434583,"text":"雷霆任務4","y":0.251028211218432},{"h":0.01744186093932698,"x":0.1582278485826222,"conf":0.5,"w":0.05696202462499067,"text":"090","y":0.047965116166549304}]