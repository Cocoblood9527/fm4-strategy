[{"text":"雷霆任務4","h":0.024250983408267368,"conf":0.5,"x":0.6983427773308287,"y":0.941362880414119,"w":0.14259257683387172},{"text":"劇情提要","h":0.02773093393618875,"conf":1,"x":0.37791932070425216,"y":0.8952341827668201,"w":0.15074309935936558},{"text":"場景再度轉回歐洲，自從愛爾莎一行人從德國調查本部回到『迪蘭達爾』","h":0.023746738104714393,"conf":1,"x":0.10393279274697544,"y":0.8239265976876408,"w":0.7177881094125601},{"text":"之後已經過了數天。某日，英國首相諾蘭德竟然親臨『迪蘭達爾』，只是諾","h":0.023418241577650045,"conf":1,"x":0.08067942373878842,"y":0.7949876749310616,"w":0.7452228986299955},{"text":"蘭德的臉色似乎不是很好看。在眾人的詢問之下，英國首相諾蘭德拿出一份","h":0.02354582705846453,"conf":1,"x":0.08047552334651517,"y":0.7633586201433236,"w":0.7456391407893255},{"text":"由歐聯議會所公布的官方新聞報導，上面赫然寫著：『布拉尼貝爾』部隊司","h":0.02419418218984104,"conf":1,"x":0.08268492190978599,"y":0.7336625900502836,"w":0.7433169438288763},{"text":"令官•葛雷薩准將認為此次德國軍事基地的攻擊事件，US N合眾國涉嫌重","h":0.023160100668889072,"conf":0.5,"x":0.08049067671721256,"y":0.7032306784368392,"w":0.7456285770122821},{"text":"大等等之類的文章。吉德等人聞言大吃一驚，因為當初他們交給葛雷薩准將","h":0.023681413373108695,"conf":1,"x":0.08048043801925882,"y":0.6728279649339782,"w":0.7477419192974384},{"text":"的晶片證據明明就是指向『薩夫特拉共和國』的『多米特里公社』，而非新","h":0.029301429441353388,"conf":1,"x":0.08046101907803714,"y":0.6395630823487943,"w":0.7477989196777344},{"text":"聞上所說的US N合眾國，為什麼葛雷薩准將要扭曲證據、公然說謊呢？","h":0.02470930188820808,"conf":0.5,"x":0.08280256621958551,"y":0.6133720934184375,"w":0.7197451958289514},{"text":"英國首相諾蘭德表示，他剛才曾經試圖向葛雷薩准將提出『新聞更正要求","h":0.02716973303964898,"conf":1,"x":0.10378735887986618,"y":0.5510953671060563,"w":0.724484737102802},{"text":"』，但是葛雷薩准將並不同意，不僅如此，葛雷薩還認為「迪蘭達爾』的人","h":0.028845885001741345,"conf":1,"x":0.08249254440985801,"y":0.5187998004779886,"w":0.7457887209378756},{"text":"員都是一群只會妄想瘋子、『迪蘭達爾』的人員所說的話都是不可信的。","h":0.02325581446375724,"conf":1,"x":0.08492569917507777,"y":0.49127906951830114,"w":0.7409766270564153},{"text":"愛爾莎聞言之後非常的生氣，原本愛爾莎還擔心葛雷薩准將可能會在證據不","h":0.023729955944352787,"conf":1,"x":0.08259659421561019,"y":0.46062673624679484,"w":0.7456527123084435},{"text":"足的情況下就直指『薩夫特拉共和國』就是幕後的黑手，想不到葛雷薩竟然","h":0.023418241577649934,"conf":1,"x":0.08492570560347848,"y":0.43015612132342507,"w":0.7452228986299956},{"text":"會把基地攻擊事件扯到U S N合眾國身上去，生氣的愛爾莎立刻就向英國首","h":0.024188359056032338,"conf":0.5,"x":0.08469956109649157,"y":0.39989336339233617,"w":0.7435767100407528},{"text":"相諾蘭德提出『再度展開調查』的申請，而諾蘭德也在『物證只能交給他一","h":0.029798644041564515,"conf":1,"x":0.08255058200868262,"y":0.36696483991597084,"w":0.7478623756995568},{"text":"個人』的前提之下答應了眾人請求。","h":0.02714728838905711,"conf":1,"x":0.08444366038882915,"y":0.33628783584896504,"w":0.38315813358013445},{"text":"•為了找出這一連串奇怪事件的謎底與答案，哈米茲提議用電腦來分析神祕","h":0.02382730595283844,"conf":0.5,"x":0.08471807792820663,"y":0.27879128686000765,"w":0.7477397185105544},{"text":"敵人攻擊德國軍事基地的『可能動機』與『最終目的』，經過一連串討論","h":0.0311794704164553,"conf":1,"x":0.0846017178258068,"y":0.24509828717820625,"w":0.7458791732788086},{"text":"與情報分析，哈米茲認為神祕敵人的下一個目標很有可能就是位於波蘭巨","h":0.02416787817523247,"conf":1,"x":0.08470091670228787,"y":0.21789784652208122,"w":0.7456850638756385},{"text":"大資源平台。由於波蘭的資源平台是整個歐聯相當重要的經濟命脈，因此愛","h":0.0235169049453422,"conf":1,"x":0.08471846850075283,"y":0.18809275413962812,"w":0.745637453519381},{"text":"爾莎一行人立刻就趕向波蘭進行備戰布署，令人感到遺憾的是，眾人努力","h":0.02400461884924099,"conf":1,"x":0.08682030960795882,"y":0.15749736618128463,"w":0.743551621070275},{"text":"最後還是沒能阻止神秘敵人的入侵，在最新銳的『火箭高速推進器』幫助之","h":0.023255812896502803,"conf":0.5,"x":0.08704884974728098,"y":0.1293604658385702,"w":0.7452228986299955},{"text":"下，神秘敵軍還是攻破了波蘭國防軍的最後防線：","h":0.022775476059173183,"conf":0.5,"x":0.0868081715797134,"y":0.0968884963968053,"w":0.49302563300499547},{"text":"063","h":0.01453488364803468,"conf":1,"x":0.7770700641526722,"y":0.05668604658110943,"w":0.05307855514379656}]