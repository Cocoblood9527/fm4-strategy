[{"w":0.26160338044451065,"y":0.8851744186574807,"x":0.4050632885277447,"h":0.026162790624718935,"text":"戰鬥畫面的看法","conf":0.5},{"w":0.7176035878766408,"y":0.8167825593789959,"x":0.18339177555496256,"h":0.021850836904425353,"text":"兩軍進入戰鬥畫面之後，遊戲就會以動畫來顯示戰鬥結果。雖然玩家在此","conf":1},{"w":0.7408303053680638,"y":0.7853578119308957,"x":0.16018263163423013,"h":0.02220223844051361,"text":"只需要靜觀戰鬥結果就可以了，不過筆者還是來為玩家們稍微解說一下戰鬥","conf":1},{"w":0.31466547344635665,"y":0.756336534379887,"x":0.1580716501573645,"h":0.01992818242625194,"text":"畫面中各種表格所代表的意義。","conf":1},{"w":0.21308017630565707,"y":0.6656976743817771,"x":0.2130801648608034,"h":0.023447062624128323,"text":"攻擊側部隊視窗","conf":0.5},{"w":0.72186060793929,"y":0.618416089960906,"x":0.17706002747135247,"h":0.022956943041399946,"text":"顯示在畫面的上側。其中最大的一個視窗就是這場戰鬥的主攻者，其他較","conf":1},{"w":0.5171632607398569,"y":0.5919038582908045,"x":0.15386423832431198,"h":0.02084935025164958,"text":"小的視窗則是配合主攻者進行聯合攻擊的僚機部隊。","conf":1},{"w":0.21097045752768873,"y":0.5028782896336561,"x":0.21308017180460387,"h":0.0234375,"text":"防禦側部隊視窗","conf":0.5},{"w":0.7196991039631191,"y":0.45600529914811994,"x":0.1749641821368322,"h":0.021870278998425197,"text":"顯示在畫面的下側。其中最大的一個視窗就是這場戰鬥的主要被攻擊目標","conf":1},{"w":0.7154354559777745,"y":0.4283431893405695,"x":0.1559902363990494,"h":0.02147713617274638,"text":"，其他較小的視窗則是配合被攻擊者進行聯合防禦（反擊）的僚機部隊。","conf":1},{"w":0.24326213390559742,"y":0.33657689327143436,"x":0.2085857338270562,"h":0.025785243040637007,"text":"戰鬥時發動钓技能","conf":0.30000001192092896},{"w":0.719698885460173,"y":0.2912919585305098,"x":0.17285716052606948,"h":0.021966636180877686,"text":"不管是我方還是敵方，只要駕駛員身上裝備了技能就隨時可能在戰鬥中發","conf":1},{"w":0.7429616559376864,"y":0.26285524108822067,"x":0.14962870774997525,"h":0.02289784033047526,"text":"動。這時如果攻擊側發動了技能的話，攻擊側主攻者視窗下方就會出現發動","conf":1},{"w":0.7407641718097405,"y":0.23584995051820545,"x":0.14966905244353093,"h":0.02167382836341858,"text":"的技能名稱；反之，如果是防禦側發動了技能的話，那麼主要被攻擊者上方","conf":1},{"w":0.27040611758721467,"y":0.20964240184352168,"x":0.1496003537905056,"h":0.020130626465144963,"text":"就會出現發動的技能名稱。","conf":1},{"w":0.05274261438192218,"y":0.04505813923961777,"x":0.15189873490244127,"h":0.0145635714656428,"text":"026","conf":1}]