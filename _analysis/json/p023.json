[{"w":0.14437367365910458,"text":"雷霆任務4","h":0.023418241577649934,"x":0.7048832268518477,"conf":1,"y":0.9490550537186191},{"w":0.3020900762998141,"text":"駕駛員＆機體基本資料","h":0.026073966735488674,"x":0.3075522866056076,"conf":0.5,"y":0.9049363442364559},{"w":0.7245628650371845,"text":"標示在畫面下方。這與前面章節（戰場畫面的看法）中敘述過的內容一模","h":0.025578105459471923,"x":0.10587235106232473,"conf":1,"y":0.84835825273833},{"w":0.06794055150105402,"text":"一樣。","h":0.016114969966640857,"x":0.08280254793767439,"conf":1,"y":0.8183139533292164},{"w":0.48058212720430815,"text":"裝備中的技能（Ski｜1）一覽表","h":0.028047099305452905,"x":0.22256303868059335,"conf":0.30000001192092896,"y":0.7268174996237375},{"w":0.7225031485924354,"text":"只要在開啟狀態畫面後按下•鈕就能叫出技能一覽表（再按一次就能關閉","h":0.02584012453930251,"x":0.11004837483851994,"conf":0.5,"y":0.66987486333836},{"w":0.6311352069561298,"text":"）。在這裡玩家能夠確認該名駕駛員身上裝備了什麼樣技能。","h":0.025488677922094527,"x":0.08675081700979949,"conf":0.5,"y":0.6379630408015182},{"w":0.3353658456068773,"text":"關於「狀態異常」","h":0.03750000062690184,"x":0.2743902477705731,"conf":1,"y":0.49999999975120424},{"w":0.4719113569993239,"text":"本遊戲中主要會出現的異常狀態共有以下數種：","h":0.023156028941898166,"x":0.10801023432403917,"conf":1,"y":0.4366956336890516},{"w":0.11040339103111857,"text":"Down","h":0.01766639276910431,"x":0.27388535234006706,"conf":0.5,"y":0.37058340169056037},{"w":0.08380226905529317,"text":"SyS","h":0.018018876908740378,"x":0.15222088475724968,"conf":0.30000001192092896,"y":0.36750307460521714},{"w":0.7225489983191857,"text":"系統故障。當陷入這種狀態時，就算目前應該輪到該機體移動，它也無法","h":0.026463233552805776,"x":0.11430258144165101,"conf":1,"y":0.32139973575661696},{"w":0.7458572387695312,"text":"移動、進行攻擊或執行任何動作。當然，如果它在這種狀態下被敵人攻擊","h":0.02547439631616477,"x":0.09100063449671417,"conf":1,"y":0.2942535051684694},{"w":0.24696509654705345,"text":"話也無法進行反擊動作。","h":0.02046094454010683,"x":0.0930642315468207,"conf":1,"y":0.266534006705204},{"w":0.44212337640615607,"text":"Attack Sys Down","h":0.02332357627599091,"x":0.15473269182070248,"conf":0.30000001192092896,"y":0.19556411068150203},{"w":0.7246237534743089,"text":"攻擊系統故障。當陷入這種狀態時，不管玩家機體上裝備的是什麼樣的武","h":0.026095002424354585,"x":0.11644631116572987,"conf":1,"y":0.15021478699762225},{"w":0.7458663353553184,"text":"器都無法發動攻擊。當然，如果它在這種狀態下被敵人攻擊的話也無法進行","h":0.026690132811898137,"x":0.09518462073211616,"conf":1,"y":0.12192475251008594},{"w":0.11264252662658691,"text":"反擊動作。","h":0.01779398765344542,"x":0.09548340749708492,"conf":1,"y":0.09575416899480027},{"w":0.055201700100531936,"text":"023","h":0.016039728432673428,"x":0.789808916302545,"conf":1,"y":0.06244864396846561}]