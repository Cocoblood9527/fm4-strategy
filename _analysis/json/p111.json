[{"y":0.9345930230339021,"text":"雷霆任務4","h":0.02325581446375724,"conf":0.5,"w":0.14649681861584007,"x":0.7154989367430354},{"y":0.888081395277843,"text":"劇情提要","h":0.026162790879913245,"conf":0.30000001192092896,"w":0.18046709207388073,"x":0.39278131583305803},{"y":0.8156662736591939,"text":"打倒基地上層的敵軍後，眾人準備搭乘巨型電進入地底基地掃蕩其他敵","h":0.023499582082204595,"conf":1,"w":0.7244011072012093,"x":0.11654149384870537},{"y":0.7842221954938289,"text":"機，同時路易斯也安排了其他游擊隊員準備炸毀甲板上的敵方運輸機、讓伊","h":0.024578864787970778,"conf":1,"w":0.7477980393629807,"x":0.09319227096169666},{"y":0.7539356835165637,"text":"凡諾娃等人無法逃走。然而，路易斯的計劃卻被伊凡諾娃視破了，算準眾人","h":0.023652785903817808,"conf":1,"w":0.7477606993455154,"x":0.09320404413645757},{"y":0.722858609130137,"text":"一定會搭乘巨型電样進入地下的伊凡諾娃早就在電様的必經之路上埋伏了士","h":0.023912508172291402,"conf":0.5,"w":0.749873528113732,"x":0.09109178592899805},{"y":0.6917314296515416,"text":"兵，當達利爾一行人忙於跟士兵交戰的同時，伊凡諾娃與瓦維諾夫就利用這","h":0.02385613403069553,"conf":1,"w":0.7456704653226411,"x":0.09530390463432568},{"y":0.6611003917086689,"text":"個機會回到甲板上打倒其他的游擊隊員、並且奪回運輸機揚長而去。雖然達","h":0.023336366639337136,"conf":1,"w":0.7456074494581956,"x":0.09534250526456886},{"y":0.6299641341259253,"text":"利爾未能生擒伊凡諾娃，但是達利爾也在基地的電腦室裡頭取得了不少有關","h":0.023351144281291814,"conf":1,"w":0.7456337855412409,"x":0.09533700751266344},{"y":0.5969837355458163,"text":"『薩夫特拉共和國』機甲資料，這些證據應該是足以化解USN跟歐聯之","h":0.025193713587037703,"conf":0.5,"w":0.7390243090116061,"x":0.10183263320571247},{"y":0.5682004926313411,"text":"間的戰爭了⋯","h":0.016101833240067087,"conf":0.30000001192092896,"w":0.15286624431610107,"x":0.09554139998897707},{"y":0.250000000390625,"text":"44","h":0.12510271158586694,"conf":0.30000001192092896,"w":0.2134146323570838,"x":0.35975609816978127},{"y":0.1737441521392603,"text":"雷霆住將","h":0.09905734410908928,"conf":0.30000001192092896,"w":0.4541321901174692,"x":0.24729826731062}]