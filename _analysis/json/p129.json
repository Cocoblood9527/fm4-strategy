[{"x":0.7133757962914669,"conf":0.5,"y":0.9404069774664773,"w":0.14437367365910458,"text":"雷霆任務4","h":0.023438544575072884},{"x":0.3906581742039553,"conf":1,"y":0.8938953487671889,"w":0.15074309935936558,"text":"劇情提要","h":0.026162790879913245},{"x":0.11243262524363248,"conf":1,"y":0.8202249423975253,"w":0.7220541147085336,"text":"場景轉回歐洲。認為『薩夫特拉共和國』部隊沒有那麼簡單就撤退達利","h":0.024915748477080113},{"x":0.08902256638430951,"conf":1,"y":0.7906142500229726,"w":0.7455184643085186,"text":"爾立刻連絡愛爾莎一行人。聽完達利爾的報告之後，哈米茲發現達利爾當初","h":0.022282859783439135},{"x":0.08898951433758807,"conf":1,"y":0.7595525883893097,"w":0.7476782431969275,"text":"傳來的飛航資料當中有一條預定路線是敵軍至今都還沒有走過的，而該條路","h":0.02286037736577684},{"x":0.0891719751098906,"conf":1,"y":0.7296511631621923,"w":0.747346071096567,"text":"線最終目地赫然是法國的歐聯中央議會！由於英國首相諾蘭德即將在歐","h":0.0203488364803468},{"x":0.08917196851484636,"conf":1,"y":0.6976170908472761,"w":0.7430997995229868,"text":"聯議會發表『薩夫特拉共和國』就是最近一連串事件幕後黑手正式證據，","h":0.021859653287964464},{"x":0.08897868973674103,"conf":1,"y":0.6666544919949219,"w":0.7222516720111553,"text":"擔心敵軍可能會在歐聯議會大開殺戒的迪蘭達爾眾人立刻火速趕回法國。","h":0.023056531011225734},{"x":0.11235444807595595,"conf":1,"y":0.6048175550546544,"w":0.7243046393761268,"text":"不過，就在愛爾莎眾人來到巴黎附近時，迪蘭達爾的運輸機竟然遭到不明","h":0.022620292795223484},{"x":0.08899606908494043,"conf":1,"y":0.5736852519372666,"w":0.747681030860314,"text":"的飛彈攻擊，原來瓦古納早就埋伏在巴黎附近等待眾人自投羅網，雖然死裡","h":0.02271025711724073},{"x":0.09114092039615958,"conf":1,"y":0.5427400084151818,"w":0.7455170704768254,"text":"逃生的葛雷薩准將（他在上次的爆炸中並沒有死）一直用無線電要求瓦古納","h":0.022170051944578995},{"x":0.09111099137881581,"conf":1,"y":0.5115365338886819,"w":0.7455631402822641,"text":"暫時撤退、等改天時局穩定之後再捲土重來，但是瓦古納已經下定決心要跟","h":0.022969173033313917},{"x":0.09129511628076528,"conf":0.5,"y":0.4811010678503118,"w":0.1804670920738807,"text":"愛爾莎決一死戰。","h":0.017445443591428966},{"x":0.11435768544260945,"conf":1,"y":0.41641563592733855,"w":0.7224437273465669,"text":"巧合的是，正當雙方一觸即發之際，從委內瑞拉撤退出來『薩夫特拉共","h":0.02662601486619809},{"x":0.0910489414506688,"conf":1,"y":0.3848113970360525,"w":0.7456936469444863,"text":"和國』部隊卻因為兵力太少而無法執行『議會攻擊作戰』，瓦古納此好暫時","h":0.028605327120352242},{"x":0.09113250567105756,"conf":0.5,"y":0.355888334600984,"w":0.6669911604661208,"text":"離開前往支援、然後將迪蘭達爾眾人留給自己的部下們去收拾了⋯•","h":0.022297655448819564},{"x":0.7940552012030585,"conf":1,"y":0.05377906953042089,"w":0.05095541477203369,"text":"129","h":0.016064809205204922}]