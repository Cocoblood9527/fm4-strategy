[{"w":0.15189873233330847,"h":0.02770234095422841,"x":0.4556962033049607,"conf":0.5,"y":0.8836348679052686,"text":"劇情提要"},{"w":0.7197176767135294,"h":0.02247347800355215,"x":0.17916554392501988,"conf":1,"y":0.8146034489102745,"text":"場景回到歐洲，在歐聯議會裡頭，各國領導者正為了波蘭資源平台遭到攻"},{"w":0.7429270596379027,"h":0.025011868853318076,"x":0.15596714954634336,"conf":1,"y":0.7888466897785982,"text":"擊一事而傷透腦筋，會中葛雷薩准將對於迪蘭達爾眾人無視他『事件調查本"},{"w":0.7405063383334577,"h":0.0219170741344753,"x":0.1561181384912922,"conf":1,"y":0.7615131581425296,"text":"部司令官』身份、擅自對神祕敵人進行追蹤、以及參與波蘭資源平台之役"},{"w":0.7408473485978521,"h":0.022966889958632608,"x":0.15597326265602576,"conf":1,"y":0.7354778605541515,"text":"一事感到非常的不滿。同時，針對最近這一連串的恐怖攻擊事件，葛雷薩准"},{"w":0.7428943570303177,"h":0.02220456694301809,"x":0.15388458255324805,"conf":0.5,"y":0.7092042521536428,"text":"將仍然堅持這是US N合眾國所犯下的罪行。在各會員國一致的決定下，歐"},{"w":0.7407964374114335,"h":0.026729947642276097,"x":0.153874340455606,"conf":0.5,"y":0.6804993685266437,"text":"聯議會竟然作出了『迪蘭達爾無限期停止活動』、以及『公開譴責USN合"},{"w":0.7405063383334576,"h":0.021897949670490413,"x":0.15400843401503894,"conf":1,"y":0.6554276314387738,"text":"眾國攻擊波蘭資源平台的暴行』兩項決議。看到歐聯議會各會員國成員們竟"},{"w":0.7407522998163409,"h":0.021595614521127016,"x":0.15389092058287734,"conf":1,"y":0.6301002374926395,"text":"然相信德國總理與葛雷薩准將的說詞，英國首相諾蘭德雖然有百般的不滿與"},{"w":0.5192309541178775,"h":0.019493998665558565,"x":0.15387532842594828,"conf":0.30000001192092896,"y":0.6046514264419127,"text":"不願，但是他現在也只能照議會的決議行事了⋯⋯⋯⋯"},{"w":0.717581154907518,"h":0.021669461538917134,"x":0.17496821333569876,"conf":0.5,"y":0.5505881579988958,"text":"歐聯議會的官方新聞稿發布之後，U S N合眾國總統•克里夫多立刻提出"},{"w":0.7534847578171613,"h":0.022525875191939493,"x":0.15383351735224587,"conf":1,"y":0.52372233111658,"text":"最嚴正的抗議，克里夫多總統甚至表示，如果歐聯不收回這份發言的話，USN"},{"w":0.7408312522141633,"h":0.022120282838219096,"x":0.15174280556213,"conf":1,"y":0.4975493570438049,"text":"合眾國不排除透過武力來解決這次的事件。除此之外，受到波蘭資源平台遇"},{"w":0.7405063383334577,"h":0.020348837501124373,"x":0.15189872944294705,"conf":1,"y":0.4723837207877821,"text":"襲受損的影響，歐聯各國也開始出現了資源危機的徵兆。此時『薩夫特拉共"},{"w":0.7406256409419748,"h":0.02230478823184967,"x":0.14973540020525353,"conf":1,"y":0.44463621563375844,"text":"和國』的發言人表示，如果歐聯有需要的話，歐聯可以向『薩夫特拉共和國"},{"w":0.24780420926988553,"h":0.023667904891465752,"x":0.1492400953781675,"conf":1,"y":0.41839769739120936,"text":"』進口任何所需的資源。"},{"w":0.7175703754288484,"h":0.024531345618398648,"x":0.17287320780956883,"conf":1,"y":0.36577852904590247,"text":"反觀迪蘭達爾這邊，愛爾莎一行人正為了迪蘭達爾被裁定『無限期停止活"},{"w":0.7405063383334577,"h":0.02055921052631582,"x":0.14978902419403065,"conf":0.5,"y":0.34004934214385085,"text":"動』而煩惱。就在這個時候，自由新聞記者．弗雷迪瑞克來到迪蘭達爾，並"},{"w":0.7391340669982474,"h":0.031310978688691815,"x":0.14942880061161617,"conf":1,"y":0.30809261602245697,"text":"且表示他手上有愛爾莎想要的『情報』，經過詢問之後，弗雷迪瑞克說出了"},{"w":0.10970463900691285,"h":0.017441860939327092,"x":0.14767932588644828,"conf":1,"y":0.290697674213799,"text":"他的推測："},{"w":0.7175645486836217,"h":0.022158483141347052,"x":0.16021654391103018,"conf":0.5,"y":0.23363695852823863,"text":"1•神祕敵人的真正目的是要破壞波蘭的資源平台、讓歐聯出現資源危機"},{"w":0.014767932436631215,"h":0.011627907031460882,"x":0.2067510547732456,"conf":0.30000001192092896,"y":0.2136627907865951,"text":"。"},{"w":0.7155254791915274,"h":0.022591517159813335,"x":0.1601731449553808,"conf":0.5,"y":0.1808622529903422,"text":"2•攻擊德國軍事基地是為了避開德國方面的偵測，不過這只是假象，因"},{"w":0.6269343337466438,"h":0.022135404379744372,"x":0.20235900920824912,"conf":1,"y":0.15491588557576907,"text":"為根據弗雷迪瑞克的情報，德國軍方跟神祕敵人似乎有所勾結。"},{"w":0.7137280011233964,"h":0.02969062955755941,"x":0.1600440648550406,"conf":0.5,"y":0.12630323512334296,"text":"3•神秘敵人的真正身份很有可能是『薩夫特拉共和國』的機甲軍團。因"},{"w":0.6754135095418781,"h":0.02469898838745921,"x":0.20028126317391795,"conf":1,"y":0.10310978475598986,"text":"為自從波蘭發現大片的新資源地帶之後，歐聯就再也沒有向『薩夫特"},{"w":0.6734782289491348,"h":0.026766159032520553,"x":0.20018019409013582,"conf":1,"y":0.07451699275898815,"text":"拉共和國』進口過資源，結果導致『薩夫特拉共和國』的經濟日漸蕭"},{"w":0.052742614381922154,"h":0.013081395312359412,"x":0.14978903025150156,"conf":1,"y":0.045058139582853096,"text":"080"}]