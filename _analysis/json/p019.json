[{"x":0.7197034855354644,"y":0.928657700571031,"conf":0.5,"w":0.1444571476716261,"text":"雷霆任務4","h":0.0234985523960487},{"x":0.09755760956724199,"y":0.8961226731574019,"conf":1,"w":0.7454434908353365,"text":"兩種感應器也各自會因為天候、時間的不同而會出現感應上的誤差。不過遊","h":0.02078979134853498},{"x":0.09753403412091782,"y":0.8683824815229966,"conf":1,"w":0.745484865628756,"text":"戲中也會出現同時具備雷達、聲納兩種感應機能的感應器。所以如果玩家裝","h":0.02185337094860973},{"x":0.0975331729077195,"y":0.8409611000080679,"conf":1,"w":0.7454845721905049,"text":"備的是多功能感應器，而且發現目前使用感應器的感應效果不佳的話，也可","h":0.021674197721207045},{"x":0.09962760854262441,"y":0.8136482141617241,"conf":0.5,"w":0.3824786039499136,"text":"以直接以選單切換感應器感應顃型。","h":0.02017994444195914},{"x":0.4115979851531793,"y":0.6854358701261665,"conf":0.5,"w":0.1237576007843017,"text":"通信背包","h":0.024984640279752668},{"x":0.12093135832226351,"y":0.6304881241771327,"conf":0.5,"w":0.7199161236102765,"text":"裝備通信背包（TYPE：Radio）的機體可以在戰鬥中以無線電申","h":0.0187974364030723},{"x":0.09746395669861628,"y":0.600375220122424,"conf":1,"w":0.74347657423753,"text":"請空中支援（Air Support）。而在本作中，只有デュランダル","h":0.023367023703105727},{"x":0.09755347620368712,"y":0.5717239802719114,"conf":1,"w":0.7454365216768706,"text":"小隊能夠使用本指令。而只要利用「空中支援」指令，玩家就可以要求航空","h":0.025377152880979748},{"x":0.09752933573008835,"y":0.543269445887109,"conf":0.5,"w":0.7412777680617113,"text":"部隊進行「Air Strike（轟炸）」「Supply Drop（","h":0.024734797983161694},{"x":0.09766454908325733,"y":0.5172555466109013,"conf":0.30000001192092896,"w":0.7409766270564153,"text":"空投補給物資）」「Armor Coating（防禦支援）」等作戰。","h":0.020542317173377067},{"conf":0.30000001192092896,"text":"關於「AirStrike（轟炸）」","x":0.15903967651648632,"y":0.43593735621954655,"w":0.5312287257267878,"h":0.02766401530683482},{"conf":1,"text":"當玩家在戰場上要求空中部隊進行轟炸時，畫面上會立刻顯示一大塊實心","x":0.12089087057044352,"y":0.39156134996079184,"w":0.7221294549795297,"h":0.021571232240123694},{"h":0.022512970346844186,"text":"的紅色方塊，這個方塊就是預定進行轟炸的目標地點。基本上，玩家無法任","x":0.09751157297194488,"conf":1,"y":0.36339323250160405,"w":0.7455362173227164},{"h":0.0212065227323609,"text":"意設定轟炸目標，但關卡中還是會有數個內定的轟炸點供玩家自由選擇（請","x":0.09757618485078723,"conf":1,"y":0.3357022756766551,"w":0.7454125330998347},{"h":0.02157721758476505,"text":"按口鈕切換）。確定轟炸地點並按鈕決定之後，剛剛的實心方塊就會變化成","x":0.09754015581581453,"conf":1,"y":0.3076578186030241,"w":0.7475809684166541},{"h":0.026276853305938874,"text":"一堆「♥」的符號，這就代表轟炸設定已經完成。當玩家完成轟炸申請手續","x":0.0890992211256086,"conf":0.5,"y":0.2762086161443076,"w":0.7559716884906474},{"h":0.0205795621911129,"text":"之後，只要下一輪的玩家回合一結束航空部隊就會立刻執行轟炸任務。因為","x":0.09968564019659716,"conf":1,"y":0.2521958685025917,"w":0.743302271916316},{"h":0.02143066519092318,"text":"炸彈不長眼睛，所以請玩家務必在轟炸申請完成後，盡速離開轟炸範圍。","x":0.09753740081571223,"conf":1,"y":0.22367580549510369,"w":0.7221164703369141},{"h":0.026294165198295527,"text":"關於「Supply","x":0.15923566866967853,"conf":0.30000001192092896,"y":0.14379622081827514,"w":0.2653927803039551},{"h":0.023418241577649934,"text":"Drop（空投補給物資）」","x":0.46072187504473117,"conf":0.30000001192092896,"y":0.14379622053495889,"w":0.3779193071218637},{"h":0.021858644759743195,"text":"利用本指令，玩家就能要求航空部隊在指定地點空投補給物資。而當補給","x":0.1208810104362352,"conf":1,"y":0.09760097595102746,"w":0.7221536636352538},{"h":0.02176777378104211,"text":"物資抵達後，玩家只要把機體移動到補給物資旁結束行動，那麼補給物資就","x":0.09755194127010366,"conf":1,"y":0.06987878935644709,"w":0.7475821421696589},{"h":0.016043311176284325,"text":"019","x":0.7961783436603891,"conf":1,"y":0.04354971246709061,"w":0.05095541477203369}]