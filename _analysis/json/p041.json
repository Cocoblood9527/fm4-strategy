[{"conf":0.5,"w":0.1424053540596596,"h":0.022278059283141416,"text":"雷霆任務4","x":0.7196678111868595,"y":0.9401691099115388},{"conf":1,"w":0.18046709207388073,"h":0.032046014790468424,"text":"角色介紹","x":0.2717622077150501,"y":0.8705834016025531},{"conf":1,"w":0.5966029533973107,"h":0.026294165198295638,"text":"達利爾（Darri1ダリル）／32歳","x":0.17622081273112933,"y":0.7760887435073349},{"conf":0.5,"w":0.7199384982769306,"h":0.0209725316470043,"text":"USN陸軍332機動中隊第五分隊隊長，階級是中士。他出生於美國西","x":0.12093019015842502,"y":0.7224044188601491},{"conf":1,"w":0.7453931661752554,"h":0.020779344814178202,"text":"部，曾經是一個靠著戰功而出人頭地的士官，但後來因為他過剩的正義感與","x":0.09546333666426225,"y":0.6948333360027139},{"conf":1,"w":0.7458381652832031,"h":0.02747930496955575,"text":"長官發生衝突，因此才被貶到今天這個職位。也正因為如此，他目前對於「","x":0.0952926832439451,"y":0.6630466542273475},{"conf":1,"w":0.7477338497455303,"h":0.02610683362799382,"text":"軍隊」這種組織總是抱持著非常不屑的態度，而且講話口氣也漸漸變得非","x":0.09535351333877316,"y":0.6362185112048484},{"conf":1,"w":0.7452228986299954,"h":0.01906374819276757,"text":"常喜歡諷刺人。不過，由於他是一個天性樂觀開朗的人，所以儘管到了這種","x":0.09554141688389904,"y":0.6117502054092618},{"conf":0.5,"w":0.6477295802189753,"h":0.020497613591842212,"text":"田地，他的內心裡似乎還是渴望著能專心致力於某樣事物上•••","x":0.09757765684921957,"y":0.5829918731072298},{"conf":0.30000001192092896,"w":0.3320295260502742,"h":0.02425264939971894,"text":"製測斯（Renges","x":0.14611376490335337,"y":0.49322724528261896},{"conf":1,"w":0.33545648134671724,"h":0.01617826902190478,"text":"レイス）／35歳","x":0.47133757668128784,"y":0.49835661498007044},{"conf":0.5,"w":0.7197451958289512,"h":0.018919235580557192,"text":"USN軍下士伍長，雖然職位上是達利爾的部下，但其實他同時也可以稱","x":0.12101912177440952,"y":0.4404069766389863},{"conf":1,"w":0.7454252243041993,"h":0.021106111875986988,"text":"為是達利爾最要好的朋友。雖然性格開朗，但他的講話口氣中也是會帶著幾","x":0.09544149725729924,"y":0.4115010753641948},{"conf":1,"w":0.7475014466505784,"h":0.020873068195929156,"text":"分挖苦人的態度，並隨時與他人保持一定程度的距離。平常的他總是露出一","x":0.09545833693115711,"y":0.38367539865774025},{"conf":1,"w":0.7452228986299956,"h":0.018998060641762793,"text":"附冷靜的態度，不管面對什麼狀況也不太會露出自己的感情。不過也正因為","x":0.0955414168684558,"y":0.35610465105736766},{"conf":1,"w":0.7454556685227616,"h":0.021279794227518578,"text":"如此，當他情緒激昂的時候在外人看來就會好像變了一個人一樣，落差相當","x":0.09543054925510103,"y":0.3272999537939748},{"conf":0.5,"w":0.04246284411503719,"h":0.014790468364831555,"text":"大。","x":0.0955414015093604,"y":0.3007395238006667},{"conf":0.30000001192092896,"w":0.36357875970693737,"h":0.026237064634274554,"text":"奇佛（Chaeffer","x":0.10799754167625632,"y":0.21726710157676388},{"conf":1,"w":0.3573701565082257,"h":0.026318809490470274,"text":"チェイファー）／24歲三","x":0.4774212623090808,"y":0.2166109273070782},{"conf":0.5,"w":0.722048539381761,"h":0.02095631213098048,"text":"USN軍一等上兵。因為年紀最輕，所以他的感覺就好像是大家的弟弟一","x":0.12304893184149172,"y":0.16375577481401604},{"conf":1,"w":0.7453993283785307,"h":0.020568218403599126,"text":"樣。他的性格不但神經大條、缺乏注意力，做事也常常出槌。雖然他給人","x":0.09757465191051022,"y":0.13607623230963128},{"conf":1,"w":0.7454346143282377,"h":0.020904037143328003,"text":"印象是講話不夠實在而且還非常輕浮，但他對待他人倒是相當溫柔，而且看","x":0.09755321414818183,"y":0.10807925495862947},{"conf":1,"w":0.42917585372924805,"h":0.02096976857745647,"text":"到他人有困難的時候也絕對不會放手不管。","x":0.09751048509938251,"y":0.07996315095392481},{"text":"041","w":0.0488322698152982,"x":0.7919320603253911,"y":0.05377906953215117,"h":0.01606480920520481,"conf":0.5}]