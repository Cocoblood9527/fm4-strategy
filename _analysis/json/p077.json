[{"y":0.9396957596008377,"text":"雷霆任務4","w":0.14485110686375546,"conf":0.5,"h":0.024678248309070394,"x":0.7152602214907884},{"y":0.8938953487665295,"text":"劇情提要","w":0.16772824067335862,"conf":0.5,"h":0.026162790879913356,"x":0.38004246130643377},{"y":0.8220713083357515,"text":"再度被打倒的伊凡諾娃，這次她成了達利爾一行人的『俘虜』。達利爾他","w":0.7242415501521183,"conf":1,"h":0.024541902659658388,"x":0.12088319187664989},{"y":0.7905701322197717,"text":"們一邊盤問著伊凡諾娃、一邊躲進了山區。在一名好心的軍火私梟指點之下","w":0.7456268163827748,"conf":1,"h":0.023628973040114576,"x":0.0995641388742144},{"y":0.7603132035281981,"text":"，眾人總算是通過了委內瑞拉的邊界。但是，達利爾他們卻在彎延曲折的山","w":0.7434046085064228,"conf":1,"h":0.02263219765982083,"x":0.10176041232539486},{"y":0.7290475403295826,"text":"路裡頭迷了路、並且誤打誤撞的來到一處山間小村，正當達利爾準備下車問","w":0.7456564536461463,"conf":1,"h":0.023534933072970055,"x":0.09956702868053924},{"y":0.6981272672953631,"text":"路的時候，一群由委內瑞拉兵所駕駛的機甲部隊卻突然闖進村莊、同時不分","w":0.745631951552171,"conf":1,"h":0.02321403459534843,"x":0.09958721307532709},{"y":0.6669560815019919,"text":"青紅皂白的就開始大肆破壞。看不慣委內瑞拉軍這種濫殺無辜行為的雷凱斯","w":0.743575903085562,"conf":1,"h":0.023884441780083976,"x":0.10166047780886284},{"y":0.6365411654112052,"text":"，他立刻就要求達利與奇佛坐上雷霆機甲與對方戰鬥。","w":0.5375304955702561,"conf":1,"h":0.021727262605088837,"x":0.10383869587014871},{"y":0.5740071114861702,"text":"就在戰鬥途中，兩名該村的村民・路易斯（ルイス）與伊妮斯（イネス）","w":0.7137798896202674,"conf":1,"h":0.022104313457805613,"x":0.12292869091340634},{"y":0.54220227912872,"text":"也駕駛機甲前來支援，至於被關在卡車中的伊凡諾娃則是被瓦維洛夫給救了","w":0.7435293197631836,"conf":1,"h":0.024130908210647783,"x":0.1016885893588507},{"y":0.5130813960711285,"text":"出去。聽伊凡諾娃的口氣，他對於達利爾這群『逃兵』見義勇為幫助村莊的","w":0.7430997995229868,"conf":1,"h":0.023255812896502803,"x":0.10191082355768553},{"y":0.4805175913029629,"text":"動作似乎非常欣賞，不過伊凡諾娃在離去之前還是表示：『這群傻蛋改天也","w":0.7456779479980469,"conf":1,"h":0.025046060196963538,"x":0.1016465771493403},{"y":0.4490550533698878,"text":"許可以好好利用一番⋯⋯⋯』","w":0.30997877854567313,"conf":0.30000001192092896,"h":0.017666392769104422,"x":0.10191082290338427},{"y":0.38738239642629047,"text":"打倒敵軍、跟路易斯兩人交談之後，眾人才得知此地原來是反對迪亞茲州","w":0.7243840877826397,"conf":1,"h":0.023200194171538846,"x":0.12293595527901441},{"y":0.3556477902380969,"text":"長反對派勢力根據地。根據路易斯的說法，這群人自稱為『委內瑞拉公正","w":0.7456855040330153,"conf":1,"h":0.02624789592959209,"x":0.10166364319365069},{"y":0.3223522588538581,"text":"軍』，簡單的說就是反對迪亞茲一派的游擊隊（編註：雖然他們是稱呼自己","w":0.7457483731783353,"conf":0.5,"h":0.02658633982047942,"x":0.1016624445154514},{"y":0.2904302441037291,"text":"為『革命家』啦⋯•⋯）。反正達利爾一行人暫時也無處可去，眾人於是決","w":0.7475033539992112,"conf":0.30000001192092896,"h":0.02647475130556054,"x":0.10183921872315974},{"y":0.25919123937891586,"text":"定先跟『委內瑞拉公正軍』的成員們見見面之後再說。","w":0.539494147667518,"conf":1,"h":0.02599600836597904,"x":0.10391293717334148},{"y":0.05377906953215117,"text":"077","w":0.05095541477203369,"conf":0.5,"h":0.01606480920520481,"x":0.7961783434682952}]