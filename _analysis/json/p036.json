[{"w":0.2664500124983685,"text":"View／檢視機體","h":0.025668401467172752,"conf":0.30000001192092896,"y":0.894019882262507,"x":0.3984379239888801},{"w":0.4704641191942311,"text":"在這裡，玩家可以檢視調整完成後的機體外觀。","h":0.017441860939327092,"conf":1,"y":0.8502906974422683,"x":0.17721519765559351},{"w":0.6455696488337186,"text":"關於人物技能設定-Pilot Setup","h":0.026325351313540746,"conf":0.30000001192092896,"y":0.7454769742396041,"x":0.20253163108694877},{"w":0.7194092962224046,"text":"在本作中，只要消耗EP（經驗值）點數，玩家就能夠讓角色取得各式各","h":0.017441860939327092,"conf":1,"y":0.6874999997662488,"x":0.1751054783351625},{"w":0.7426160571114261,"text":"樣的技能，提昇角色們在戰場上的戰鬥能力。在此選項中，玩家可以執行以","h":0.019019660196806232,"conf":1,"y":0.658305921000622,"x":0.15189872239395633},{"w":0.11234369027586144,"text":"下的指令。","h":0.018865808060294587,"conf":1,"y":0.6315321319862743,"x":0.15368086503656164},{"w":0.5949367259168966,"text":"Get Abilities／取得特殊能力","h":0.0234375,"conf":0.30000001192092896,"y":0.5579769733603659,"x":0.22995779726755683},{"w":0.7195461519009174,"text":"利用本指令可以消費EP幫人物取得技能，強化角色的能力。選擇本指令","h":0.020429463762986044,"conf":0.5,"y":0.5113705562157976,"x":0.17293723403902986},{"w":0.266251101983191,"text":"之後會出現以下兩個選項：","h":0.01957692284333079,"conf":1,"y":0.4836115204455872,"x":0.1516836981043953},{"w":0.4873417601665051,"text":"1）Buy Abilities／購買特殊能力","h":0.017680921052631526,"conf":0.30000001192092896,"y":0.4547697369192534,"x":0.17721519576012215},{"w":0.6963571625848374,"text":"消費EP瞒買角色特殊能力。可以睛買特殊能力包含了「提昇角色","h":0.021894898069532265,"conf":0.5,"y":0.42717929171937774,"x":0.17292506526173332},{"w":0.696202535333383,"text":"基本能力」「提昇角色武器熟練度」以及「增加角色技能」等三大種顃","h":0.02471886418367686,"conf":0.5,"y":0.39679276334886315,"x":0.17299577859004775},{"w":0.01687763642012932,"text":"。","h":0.011627907031460882,"conf":0.30000001192092896,"y":0.37500000008892076,"x":0.1856540087097666},{"w":0.26582278158328987,"text":"2）Upgrade／升級","h":0.01613180809899384,"conf":0.30000001192092896,"y":0.34447674430203234,"x":0.17510548674000068},{"w":0.7004219728893198,"text":"消費EP幫自己的電腦升級。只要升級後，角色就有可能可以購買新的","h":0.018924035524067073,"conf":1,"y":0.3153782898597881,"x":0.1814345830618346},{"w":0.11239472892233182,"text":"特殊能力。","h":0.019302608935456544,"conf":0.5,"y":0.28831381222859753,"x":0.18325411220245952},{"w":0.32700422555563846,"text":"SkiIIs／設定技能","h":0.0234375,"conf":0.30000001192092896,"y":0.21217105279118165,"x":0.42194092623061963},{"w":0.08084971352807091,"text":"Set","h":0.017950545800359596,"conf":0.5,"y":0.21484387537739924,"x":0.30330969111255146},{"w":0.7177134220241645,"text":"選擇本指令後，只要把游標對準「E q u ip Ski1丨」並按鈕決定","h":0.026742216787840167,"conf":0.30000001192092896,"y":0.16179273749010648,"x":0.17067942247378248},{"w":0.7383966195554892,"text":"，那麼角色的技能視窗就會開啟。每一個角色所擁有的技能點數都不同，而","h":0.017680921052631526,"conf":1,"y":0.1393914472621942,"x":0.15189873650855473},{"w":0.742616057111426,"text":"裝備每一種技能所會消耗的點數也不盡相同。請玩家斟酌角色的能力自由進","h":0.017680921052631526,"conf":1,"y":0.11184210499254099,"x":0.14767931309157878},{"w":0.13502110046532387,"text":"行裝配動作。","h":0.017451422779183656,"conf":0.5,"y":0.08429276352187509,"x":0.14767932305847734},{"w":0.05274261438192218,"text":"036","h":0.014802631578947345,"conf":1,"y":0.04934210493298741,"x":0.1518987348976465}]