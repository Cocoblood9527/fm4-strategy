[{"text":"雷霆任務4","x":0.7110583378613177,"w":0.1447623051129855,"conf":0.5,"y":0.9354708385019723,"h":0.024407160311521126},{"text":"劇情提要","x":0.38216560926628207,"w":0.15923566084641672,"conf":1,"y":0.8894823334518026,"h":0.027668829912422366},{"text":"雖然達利爾一行人成功的逃出卡拉卡斯市，但是在逃亡的途中，委內瑞拉","x":0.11235534863373609,"w":0.7243210719181941,"conf":1,"y":0.8177415667026953,"h":0.022649728967796712},{"text":"獨立軍卻傳出『迪亞州長強硬表示—一委內瑞拉絕對不會向US N低頭、委","x":0.08892365779008002,"w":0.7477907767662635,"conf":0.5,"y":0.7862141996231881,"h":0.027272339619469732},{"text":"內瑞拉的獨立運動將會一直持續下去』的官方新聞報導。根據達利爾的推測","x":0.09108899434716132,"w":0.7456285770122821,"conf":1,"y":0.7535070418969003,"h":0.025464497537228903},{"text":"，這則新聞很有是伊凡諾娃假冒迪亞茲州長散布出來的。","x":0.09322034239514142,"w":0.5609243833101712,"conf":1,"y":0.7244221571265594,"h":0.022280848996014346},{"text":"此外，由於路易斯擔心敵人會跟蹤他們回程的道路找到村莊根據地的位置","x":0.11445872705593554,"w":0.7201331945566031,"conf":1,"y":0.6627490263535751,"h":0.02283674943809544},{"text":"，因此眾人最近這幾天都是躲在山中逃避敵人的追捕。正當眾人煩惱要如何","x":0.09532961627136026,"w":0.7413682937622071,"conf":1,"y":0.631885593663281,"h":0.023439275699261408},{"text":"脫困的時候，在村莊學校當老師的沙蒙德突然出現在眾人的面前、並且提出","x":0.09110826529574591,"w":0.745575684767503,"conf":1,"y":0.6007944178497112,"h":0.022614493953858505},{"text":"了『前後夾擊敵人』的策略。在得知沙蒙德以前曾經是『戰爭英雄』過","x":0.09318605444518745,"w":0.7435474395751953,"conf":0.5,"y":0.5671790153727427,"h":0.028320281154911475},{"text":"去之後，達利爾決定按照沙蒙德的計策放手一搏。","x":0.09104831283472148,"w":0.4972651188190167,"conf":1,"y":0.5380135689336578,"h":0.022450621831387685},{"text":"很巧的是，就在達利爾一行人打倒敵軍之後，達利爾竟然巧遇了之前愛爾","x":0.11445796871054878,"w":0.7222302510188175,"conf":1,"y":0.4763841586029326,"h":0.02279556120823123},{"text":"莎所連絡的US N通信兵。通信兵除了告訴達利爾有一群自稱是『迪蘭達爾","x":0.09107094225959042,"w":0.7456637162428635,"conf":0.5,"y":0.444644561611545,"h":0.026956989222505445},{"text":"』的人在找他之外，通信兵也告訴眾人有關U S N部隊在卡拉卡斯兵敗如山","x":0.0909152651232771,"w":0.7459138723520132,"conf":0.5,"y":0.4111886813801654,"h":0.028215278243078123},{"text":"倒的戰況。於是乎，已經兵疲馬乏的眾人決定先回村莊、然後再慢慢來整理","x":0.09322308849234417,"w":0.7455667349008414,"conf":1,"y":0.3828905091493471,"h":0.02311684601406827},{"text":"其他相關的情報。","x":0.09307614029225277,"w":0.18110262430631197,"conf":0.5,"y":0.3515405493914818,"h":0.019983424058975352},{"text":"099","x":0.7898089162979292,"w":0.05520170010053205,"conf":1,"y":0.04930156107020345,"h":0.016105415983677984}]