[{"x":0.7152627504665128,"y":0.9425832462678763,"text":"雷霆任務4","w":0.14059976431039656,"h":0.023263740853001647,"conf":0.30000001192092896},{"x":0.39259076677435545,"y":0.8964412148925399,"text":"戰術方針","w":0.1511103740105263,"h":0.027396249888662183,"conf":0.5},{"x":0.10604745766723664,"y":0.80309941806995,"text":"敵軍的數量高達8隻，而且幾乎每一架敵機都會使用LIN K攻擊，再加","w":0.722092188321627,"h":0.02108626573322825,"conf":0.5},{"x":0.10815269764832126,"y":0.7751027375089736,"text":"上本關有首度出現的頭目級角色•達蘭斯，因此玩家在遊戲開始之前一定","w":0.7200073095468374,"h":0.0216567291034081,"conf":0.5},{"x":0.10603838245797578,"y":0.7472636750121766,"text":"要在機體整備畫面作好技能的買、以及新裝備的添瞒，這樣子才會有勝","w":0.7221177908090445,"h":0.021444828469144084,"conf":0.5},{"x":0.10606913764747149,"y":0.7201839212085407,"text":"算。首先，先善用我方的LINK攻擊先將前方的一台坦克擊破，而且動","w":0.7199290348933293,"h":0.019202943110720683,"conf":0.5},{"x":0.10603448033413955,"y":0.6916886132937032,"text":"作一定要快，否則坦克的火砲連攜攻勢不但會造成我方的大損傷，而且後","w":0.7221309221707859,"h":0.02159566573657834,"conf":1},{"x":0.10604447119913633,"y":0.6636287873426565,"text":"方緊接著還會有2台敵方機甲會趕來支援。打倒坦克之後，接下來敵方的","w":0.724179928119366,"h":0.021370007742989028,"conf":1},{"x":0.10603781520449097,"y":0.6359963837276008,"text":"攻勢會以一前一後的遠近交叉打過來，建議玩家最好是一邊補血一邊交戰","w":0.7242406698373647,"h":0.021688019337963604,"conf":1},{"x":0.10815190861646097,"y":0.6077842729676598,"text":"、然後儘量以HP全滿的狀態再去挑戰本關頭目・達蘭斯。","w":0.5841362659747784,"h":0.02124209940776345,"conf":1},{"x":0.14861996027483004,"y":0.40550534107185565,"text":"敵方機體資料","w":0.1825902278606708,"h":0.023418241577649934,"conf":1},{"x":0.7617377402083861,"y":0.363971408356322,"text":"腳部HP","w":0.07331363054422235,"h":0.015709620768062038,"conf":0.30000001192092896},{"x":0.6750239089994494,"y":0.36447929062996753,"text":"石手HP","w":0.07033434739479649,"h":0.01377397692389637,"conf":0.30000001192092896},{"x":0.5859310504725003,"y":0.36468384632635376,"text":"左手HP","w":0.07017611540280855,"h":0.01336486631470224,"conf":0.5},{"x":0.4968152877227175,"y":0.36318816794