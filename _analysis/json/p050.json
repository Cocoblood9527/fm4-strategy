[{"text":"戰術方針","x":0.4493337201673174,"y":0.882176471112762,"h":0.026344733802895814,"w":0.14985576620534385,"conf":0.5},{"text":"本關玩家的身邊會多出吉德這名新同伴。吉德最大特徵就是他的機甲雙","x":0.16449111033032765,"y":0.7908693348329541,"h":0.020434527020705362,"w":0.7216631541104193,"conf":1},{"text":"肩都搭載了破壞力強大的肩射型飛彈（近距離則可按口鈕切換成格鬥戰武","x":0.16657605192787905,"y":0.7627481021099711,"h":0.0202667909233194,"w":0.7195787816741871,"conf":1},{"text":"器）。不過，由於吉德的機甲移動力很慢、再加上肩射型飛彈的射程固定","x":0.16656800217145826,"y":0.7347254671326668,"h":0.02107542282656616,"w":0.7196020158207787,"conf":1},{"text":"、敵人離得太遠或太近都射不到，因此筆者建議玩家最好把吉德擺在離敵","x":0.16868667962423814,"y":0.7070103539507139,"h":0.020317621921238094,"w":0.7174715392629402,"conf":1},{"text":"人比較遠的地方，這樣子玩家在調整飛彈射程時才會比較方便。等玩家們","x":0.16455694809115876,"y":0.6787790699708813,"h":0.019000534948549808,"w":0.721519015000373,"conf":1},{"text":"熟悉吉德的戰鬥方式之後，接下來玩家就可以讓愛爾莎跟吉德待在原地不","x":0.16656641021470378,"y":0.6506849101980194,"h":0.020957570326955666,"w":0.7196025984953013,"conf":1},{"text":"動、等敵人靠近之後再合力將其一一擊破便可過關。","x":0.1645569601502905,"y":0.6233552632778254,"h":0.019086596997160532,"w":0.516877640972274,"conf":0.5},{"text":"敵方機體資料","x":0.2088607594663337,"y":0.38939144701727,"h":0.021945762006860048,"w":0.17932489436110904,"conf":1},{"text":"左手HP","x":0.6433864543776775,"y":0.34720142330846426,"h":0.013445991434549054,"w":0.067657470703125,"conf":0.5},{"text":"等級","x":0.4451476792389272,"y":0.34580592143494526,"h":0.014802631578947345,"w":0.03797468308332708,"conf":0.5},{"text":"駕駛員","x":0.3523206756069216,"y":0.345805921398608,"h":0.014802631578947345,"w":0.054852319503456426,"conf":0.5},{"text":"移動","x":0.5000000003575604,"y":0.3458059213051695,"h":0.014802631578947345,"w":0.03586497796179289,"conf":1},{"text":"右手HP","x":0.7320675094828253,"y":0.34738372099207604,"h":0.013224831537196557,"w":0.06751055023266195,"conf":0.5},{"text":"腳部HP","x":0.8185654019229458,"y":0.347383720968911,"h":0.013224831537196557,"w":0.06962025080205148,"conf":0.5},{"text":"機疆