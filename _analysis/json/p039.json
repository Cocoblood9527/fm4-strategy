[{"text":"雷霆任務4","y":0.9415161666353118,"h":0.023944411203326466,"w":0.14460833256061256,"conf":0.5,"x":0.7068890399578974},{"text":"機體零件商店-Wen zer Shop","y":0.8948741609690004,"h":0.027069008732390487,"w":0.6477969242976263,"conf":0.30000001192092896,"x":0.13576725153366104},{"text":"在這個選項中，玩家可以自由進行各種機體零件的買賣。玩家必須先在這","y":0.8349153795163237,"h":0.02408046769429739,"w":0.7286046835092398,"conf":1,"x":0.10389063627801395},{"text":"裡購買零件之後，才能在機體整備畫面中進行零件設定的動作。","y":0.8067258455540932,"h":0.024590431125612655,"w":0.6311150330763597,"conf":1,"x":0.08676405621181055},{"text":"F電腦商店-Computer Shop","y":0.6936709506316965,"h":0.027655530191388555,"w":0.6796198624830979,"conf":0.30000001192092896,"x":0.10606190204897992},{"text":"遊戲中，每個角色都能取得屬於自己的特殊能力，不過因為每位角色的擅","y":0.6330068680295826,"h":0.024880708586317413,"w":0.7245084322415866,"conf":1,"x":0.110156203817141},{"text":"長領域不同，所以某些腳色就算是經過不斷提昇電腦等級（Upg r ad e","y":0.6055226417694084,"h":0.024002960694061493,"w":0.7435094393216648,"conf":0.5,"x":0.08894935840549562},{"text":"）還是絕對不可能取得某些特定的能力。這時，玩家就可以直接到電腦商店","y":0.5775014429482231,"h":0.02379002410462372,"w":0.7456599015455979,"conf":1,"x":0.08896341239600844},{"text":"中買這些雖然想學，可是卻學不到的能力。","y":0.5491123335028879,"h":0.022414868839862545,"w":0.45269540640024036,"conf":1,"x":0.0889389252476241},{"text":"E戰鬥模擬系統&教學系統-S imu lator","y":0.4374999996061195,"h":0.02761627987161852,"w":0.6815286783071666,"conf":0.30000001192092896,"x":0.11040338901109029},{"text":"戰鬥模擬系統","y":0.3566601049942776,"h":0.025632861410876062,"w":0.18533017085148745,"conf":0.5,"x":0.3754665548116844},{"text":"利用這個系統，玩家可以重新進行一次過去曾經遭遇過戰鬥。不過在這","y":0.30271134505139186,"h":0.02420274410075407,"w":0.7223893679105319,"conf":1,"x":0.11438703898069758},{"text":"種戰鬥中，敵我雙方的配置將會跟過去的戰鬥中有著些微的不同。值得一提","y":0.27420925666153484,"h":0.02451427118055327,"w":0.7477969389695388,"conf":1,"x":0.09106757365820606},{"text":"的是，在這種戰鬥中玩家還是可以取得金錢與經驗值。","y":0.24623834969905478,"h":0.022964352158708734,"w":0.5398249259361854,"conf":1,"x":0.09313707147033473},{"text":"教學系統","y":0.16555646300315652,"h":0.023538237628921155,"w":0.1253772607216468,"conf":1,"x":0.4075873780673457},{"text":"在這裡玩家可以查閱一些有關戰鬥或是機體設定基本教學影片。剛開始玩","y":0.11031164046907294,"h":0.024468732252410974,"w":0.7244881116426908,"conf":1,"x":0.11650425192335767},{"text":"遊戲時最好先到這裡來看看比較妥當。","y":0.08245660526620535,"h":0.021506159836479966,"w":0.38483300575843227,"conf":1,"x":0.09312812474039624},{"text":"039","y":0.05668604715513326,"h":0.016033755626067236,"w":0.05520169551555931,"conf":1,"x":0.7898089188735014}]