[{"conf":0.30000001192092896,"x":0.455605886762626,"y":0.890740741515791,"w":0.1499696608659476,"h":0.026658051892330836,"text":"戰術万針"},{"conf":0.5,"x":0.17299577456812273,"y":0.8050986842021073,"w":0.7194092962224045,"h":0.021936199382731836,"text":"在進入本關之前，遊戲會先教導玩家有關『E MP背包．解除飛彈鎖定功"},{"conf":1,"x":0.1729957738333634,"y":0.776162790650977,"w":0.7194092962224046,"h":0.023255814062921654,"text":"能』的使用方法，只要玩家在裝備有『EMP背包』的角色設定為『防禦"},{"conf":0.5,"x":0.17299577842666689,"y":0.7500000001113963,"w":0.7172995774444362,"h":0.0234375,"text":"支援』、並且打開『解除飛彈鎖定』的功能的話，那麼當其他機體站在該"},{"conf":1,"x":0.1729957807964327,"y":0.726562499875003,"w":0.7172995774444361,"h":0.017680921052631526,"text":"名角色一定範圍之內，敵方的飛彈都不會打到我方。由於本關的敵軍配備"},{"conf":1,"x":0.17081569883497066,"y":0.6990884255207431,"w":0.7195433841969348,"h":0.021925188993152767,"text":"有很多很強力的要塞防空飛彈，因此除了我方機體防禦屬性要改為『抗"},{"conf":1,"x":0.1707183454088741,"y":0.6671912032549097,"w":0.7198023830222628,"h":0.028918347860637406,"text":"炎熱』之外，玩家最好還是善用『EMP背包』的『解除飛彈鎖定』功能"},{"conf":0.5,"x":0.17281969251564452,"y":0.6430777149221871,"w":0.7176673907368735,"h":0.026305802558597824,"text":"比較安全。另外，有些EMP背包並沒有『解除飛彈鎖定』的能力，玩家"},{"conf":0.5,"x":0.17088606831010741,"y":0.6204769739624325,"w":0.42616035261131413,"h":0.017680921052631637,"text":"在購買EMP背包的時候一定要特別注意。"},{"conf":1,"x":0.2130801707823936,"y":0.5014534886773733,"w":0.18143459493049852,"h":0.021984010934829712,"text":"敵方機體資料"},{"conf":1,"x":0.5021097045337959,"y":0.45764802619050204,"w":0.040084388204861376,"h":0.016189183059491685,"text":"移動"},{"conf":0.5,"x":0.6476425332570379,"y":0.4577552736421857,"w":0.06969383622126246,"h":0.013268522526088455,"text":"左手HP"},{"conf":0.5,"x":0.8248686394172844,"y":0.45778516537203284,"w":0.06756229901370692,"h":0.013208739067378739,"text":"腳部HP"},{"conf":0.30000001192092896,"x":0.5590717310335734,"y":0.45639534853235286,"w":0.06962025080205136,"h":0.014534884377529811,"text":"身温HP"},{"conf":0.30000001192092896,"x":0.4514767936074474,"y":0.45764802608308564