[{"w":0.14386375991712042,"text":"EMP背包","conf":0.30000001192092896,"h":0.023100503181156307,"x":0.45338457566178325,"y":0.8888857949449332},{"w":0.7196053661992841,"text":"所謂的EMP，就是「電磁波障礙」的簡稱。而裝備了這種背包的機體就","conf":1,"h":0.026882933942895204,"x":0.17078088522410242,"y":0.8269849527716767},{"w":0.7407164653331966,"text":"可以在戰鬥中對一定範圍內的敵機進行電磁波攻擊，干擾對方機體的各種控","conf":1,"h":0.020979451505761304,"x":0.1496821535466959,"y":0.8037242884021165},{"w":0.7428068101832861,"text":"制系統（也就是造成對方機體狀態異常）。當玩家在戰鬥中選擇了EMP攻","conf":0.5,"h":0.02106165885925293,"x":0.14759343119142548,"y":0.7758749710248518},{"w":0.7427551706537142,"text":"擊指令後，畫面上也會出現代表主角機體攻擊範圍的紅色方塊，接著當玩家","conf":1,"h":0.020181787641424864,"x":0.14761114533974604,"y":0.7483403249109682},{"w":0.7406881327845316,"text":"選擇想要攻擊的敵方機體時，畫面上便會顯示玩家可以進行的攻擊種頻。選","conf":1,"h":0.020199819615012715,"x":0.14969398132508185,"y":0.7202511790622227},{"w":0.49184557930666395,"text":"定攻擊種瀕並按下決定鈕就可以發動電磁波攻擊。","conf":0.5,"h":0.02087879180908203,"x":0.14964775907016795,"y":0.6914949355622483},{"w":0.4158759652003468,"text":"關於EMP背包特殊防禦能力","conf":1,"h":0.023516187542363287,"x":0.20873400620939014,"y":0.6220142027348672},{"w":0.7132960207991498,"text":"遊戲中，玩家可能會在某些EMP背包的能力中找到「An tilock","conf":0.5,"h":0.021823699537076413,"x":0.1707735141583796,"y":0.5762146891263901},{"w":0.7409030668490826,"text":"」（アンチロック，解除飛彈鎖定）這個能力。顧名思義，只要這個機能一","conf":1,"h":0.023413291887233068,"x":0.14954298985283704,"y":0.5464194187451268},{"w":0.7407619867802805,"text":"發動，任何導引式的飛彈就會無法準確地命中目標。不過，這個機能只有在","conf":1,"h":0.021478145530349324,"x":0.14965697750443197,"y":0.5202807399885779},{"w":0.010548523331598919,"text":"：","conf":0.30000001192092896,"h":0.011627907031460771,"x":0.15611814326563517,"y":0.49563953500171143},{"w":0.6921929334399238,"text":"1）遭受攻擊的機體附近（4格之內）有裝備本EMP背包的機體存在","conf":0.5,"h":0.020730838963859965,"x":0.175004037651271,"y":0.4644203212361999},{"w":0.6922440631292884,"text":"2）那台裝備了EMP背包的機體必須是遭受攻擊機體的聯合防禦小隊","conf":0.5,"h":0.021492463977713316,"x":0.17496987446831802,"y":0.43607241359389937},{"w":0.09079812534669135,"text":"中的一員","conf":0.5,"h":0.016207450314571936,"x":0.21514946021613784,"y":0.4097741819785764},{"w":0.6057690822992803,"text":"滿足以上兩個條件之後，還必須進行一些基本設定才會發動。","conf":1,"h":0.021655616007353107,"x":0.1707446781391515,"y":0.35176389106914796},{"w":0.15189873233330842,"text":"感應嚣背包","conf":0.5,"h":0.0234375,"x":0.445147680168251,"y":0.23684210519476334},{"w":0.7196188405476208,"text":"如果玩家小隊中有裝備感應器背包（TYPE：Sensor）的機體存","conf":0.30000001192092896,"h":0.020203141789687296,"x":0.16867668393541865,"y":0.18043794985472095},{"w":0.742616057111426,"text":"在的話，那麼不管它距離玩家小隊其他機體有多遠，所有我方都將能以飛彈","conf":1,"h":0.01903878466079101,"x":0.14767931319086675,"y":0.15406976764725966},{"w":0.5382197705544265,"text":"攻擊那台搭載著感應器背包周圍一定範圍之內的敵人。","conf":1,"h":0.02028099016139384,"x":0.14755682878507975,"y":0.12575221787895785},{"w":0.7174670235353894,"text":"感應器種類共有雷達（Radar）、聲納（Sonar）兩種，而這","conf":0.5,"h":0.01913287451392731,"x":0.16870205975786126,"y":0.07116672198834206},{"w":0.04852320869099838,"text":"018","conf":1,"h":0.013081395312359412,"x":0.1561181423844586,"y":0.0421511628400828}]