[{"conf":0.30000001192092896,"text":"劇情提要","x":0.42170900056296523,"y":0.8916463643858963,"w":0.18400815904567236,"h":0.027753782899756274},{"conf":0.5,"text":"場景回到南美洲，回到山間小村的達利爾一行人成功透過通信兵跟愛爾","x":0.17932489144575972,"y":0.8211348685735284,"w":0.7194092962224046,"h":0.01898141048456492},{"conf":1,"text":"莎取得連絡，在愛爾莎的解說之下，達利爾才知道伊凡諾娃部隊所使用雷","x":0.1561181316766586,"y":0.7906976741840125,"w":0.742616057111426,"h":0.017441860939327092},{"conf":0.5,"text":"霆機甲跟愛爾莎她們在歐洲對抗的神祕敵人所使用的機甲是同一種纇型。也","x":0.15601812342810276,"y":0.7575387073098374,"w":0.7428252372650657,"h":0.021500819607784938},{"conf":1,"text":"就是說，伊凡諾娃他們很有可能是『薩夫特拉共和國』的人。在歐洲這邊","x":0.15600413832068788,"y":0.7244253927442448,"w":0.7428483257430265,"h":0.025509009235783697},{"conf":1,"text":"線索與證據完全被銷毀的現在，愛爾莎如今只能夠把搜尋證據的希望放在達","x":0.15603076922039044,"y":0.6956908867821274,"w":0.7427777492914678,"h":0.020804692255823376},{"conf":0.5,"text":"利爾的身上。 為了幫助愛爾莎，達利爾決定去詢問迪亞茲州長有關伊凡諾","x":0.15611813167635452,"y":0.6656976741840053,"w":0.742616057111426,"h":0.01744186093932698},{"conf":1,"text":"娃的來歷，幸運的話也許可以取得有關神祕敵人的情報、然後拿給愛爾莎他","x":0.1561181316801217,"y":0.6351744183701413,"w":0.7426160571114261,"h":0.01744186093932698},{"conf":0.5,"text":"們去阻止歐聯與US N合眾國之間的『誤會之戰』。","x":0.15603230667069048,"y":0.6016061933400987,"w":0.5149655945261224,"h":0.024584018870403845},{"conf":1,"text":"經過詢問之後，迪亞茲才說出了事情的真相。原來伊凡諾娃的部隊真的是","x":0.17923947150039235,"y":0.5402264781282025,"w":0.7195605730953536,"h":0.02038274626982839},{"conf":0.5,"text":"『薩夫特拉共和國』派來委內瑞拉的。不僅如此，主動派人跟迪亞茲州長接","x":0.1624472667935745,"y":0.5072674421557588,"w":0.7362869007775209,"h":0.021926636758603513},{"conf":1,"text":"觸的『薩夫特拉共和國』還答應提供金錢與武器裝備給迪亞茲，對方唯一","x":0.15598150680980372,"y":0.4745209803138346,"w":0.7407752426256712,"h":0.02576122001597758},{"conf":0.5,"text":"條件就是要迪亞茲州長宣布委內瑞拉州獨立、並且脫離US N合眾國。","x":0.15601875429470238,"y":0.4466735192875442,"w":0.6942831326213827,"h":0.020677726519735207},{"conf":1,"text":"在迪亞茲州長的指引下，眾人得知伊凡諾娃的部隊根據地就位在山間小村","x":0.17713210903861837,"y":0.3845223037810721,"w":0.7195824233899537,"h":0.020522596020447592},{"conf":1,"text":"的南方。想起卡波在卡拉卡斯市的犧牲，路易斯憤怒的表示：『不能讓外國","x":0.15597193353994268,"y":0.3523197792283449,"w":0.7407867504474941,"h":0.02328553168397196},{"conf":0.5,"text":"的勢力繼續在我們的委內瑞拉胡作非為！』於是乎，雖然伊凡諾娃的部隊","x":0.15611813196267155,"y":0.3211348686315002,"w":0.742616057111426,"h":0.021888387046362312},{"conf":1,"text":"擁有非常精良的裝備，但是在路易斯的堅持、以及達利爾刻意想作一份人情","x":0.15392740780732714,"y":0.2911077309294152,"w":0.7427891842789752,"h":0.020653036864180296},{"conf":1,"text":"給愛爾莎的情況之下（其實達利爾的真正目的是想跟愛爾莎借一台運輸機然","x":0.15611813874527164,"y":0.26151315760542815,"w":0.7405063383334576,"h":0.017680921052631526},{"conf":0.5,"text":"後『落跑』），眾人決定集合全游擊隊兵力朝『薩夫特拉共和國』的祕密","x":0.1560210735209206,"y":0.22646899124857423,"w":0.7406981839200477,"h":0.025672608300259192},{"conf":1,"text":"基地發動猛攻！","x":0.15396346082557485,"y":0.1975093137989672,"w":0.15620810206010408,"h":0.020679047233180037},{"conf":1,"text":"108","x":0.16244725631330403,"y":0.04934210527464944,"w":0.04852320869099838,"h":0.013157894736842146}]