[{"h":0.024075323965281115,"text":"雷霆任務4","y":0.9399972217634589,"x":0.7174807361091478,"w":0.1425332197776208,"conf":0.5},{"h":0.03412455148939819,"text":"關於「攻擊」","y":0.8912819256347544,"x":0.36044870292391873,"w":0.21559999539301944,"conf":0.5},{"h":0.025473865016915287,"text":"當玩家移動結束後（或是直接開啟戰鬥選單），如果周圍有敵機存在的話","y":0.824364624728707,"x":0.1186340521869834,"w":0.7224538509662335,"conf":1},{"h":0.024142306068439257,"text":"，玩家就可以選擇對該敵機發動攻擊。進攻的流程大略如下：","y":0.7936737095933613,"x":0.09950617838735372,"w":0.6035723319420447,"conf":1},{"h":0.020624424065344593,"text":"確認攻擊範圍","y":0.7403839498560483,"x":0.14195510515208254,"w":0.15129157213064337,"conf":1},{"h":0.02567024513062821,"text":"選擇A t tack並按鈕決定後，機體周圍就會立刻出現一些紅色方塊，","y":0.7087137115689036,"x":0.11434193930329475,"w":0.7182130813598634,"conf":0.30000001192092896},{"h":0.023207488957250777,"text":"這些方塊就是機體可以進行攻擊的區域。","y":0.6851015595392901,"x":0.11430193095550749,"w":0.40619321969839245,"conf":1},{"h":0.019075691455098243,"text":"切換攻擊武器","y":0.5988372092234586,"x":0.14437367326737563,"w":0.1507430993593656,"conf":0.5},{"h":0.025201712853612723,"text":"因為機體上裝備的武器通常不只一種，所以如果玩家想要更換攻擊武器","y":0.5677842931192858,"x":0.11648621118616546,"w":0.7224253140963041,"conf":1},{"h":0.02481670896832633,"text":"話只要在此按下口鈕即可。不過請注意，當玩家更換攻擊武器時，機體的","y":0.5444411833979451,"x":0.11439996454110932,"w":0.7266081296480619,"conf":1},{"h":0.020262747194890407,"text":"攻擊範圍也會產生變化。","y":0.5214776735426103,"x":0.11648870324222489,"w":0.2489635394169734,"conf":1},{"h":0.020542317173377178,"text":"▶選擇攻擊目標","y":0.43303204592004396,"x":0.11040340046766779,"w":0.18895965356093186,"conf":0.30000001192092896},{"h":0.0287653218553805,"text":"如果對武器沒有意見的話，那麼玩家接下來必須作的事情就是「決定攻擊","y":0.4024415074076052,"x":0.1164270881883802,"w":0.7246388655442457,"conf":0.5},{"h":0.028896841144796848,"text":"目標」。一般來說，玩家可以自由移動游標來瞄準攻擊範圍內的任一架敵","y":0.3771437937321319,"x":0.12061932389988858,"w":0.7205515641432543,"conf":1},{"h":0.02561895908051659,"text":"機。不過如果玩家想要更輕鬆一點的話，那只要按下L1鈕遊戲就會自動","y":0.3553688657306202,"x":0.11859536751749172,"w":0.7224805538470929,"conf":0.5},{"h":0.021681236260820747,"text":"（如果存在複數敵機的話，再按","y":0.3360132816623904,"x":0.5284526025785019,"w":0.31258971874530506,"conf":1},{"h":0.02238283651033779,"text":"為玩家選定位於機體攻擊範圍內白敵機","y":0.33250728916272143,"x":0.11862092624727943,"w":0.3954563140869141,"conf":0.5},{"h":0.018931178842887753,"text":"L1鈕就可以切換目標）。","y":0.31101068188903314,"x":0.12314225575505199,"w":0.2675159160907452,"conf":0.5},{"h":0.019993684873682804,"text":"切換攻擊武器","y":0.21980887749289557,"x":0.14842337949078427,"w":0.15324977728036732,"conf":1},{"h":0.026252192557592702,"text":"因為機體上裝備的武器通常不只一種，所以如果玩家想要更換攻擊武器的","y":0.18806869521468716,"x":0.12068163994786706,"w":0.7225816433246319,"conf":1},{"h":0.026342641161226754,"text":"話只要在此按下口鈕即可。不過請注意，當玩家更換攻擊武器時，機體的","y":0.16476988355560906,"x":0.12071370436486771,"w":0.7246073942918044,"conf":1},{"h":0.022184153316250232,"text":"攻擊範圍也會產生變化。","y":0.14110939665562594,"x":0.12062953187233848,"w":0.2492548502408541,"conf":1},{"h":0.014790468364831555,"text":"015","y":0.055053410145774806,"x":0.8046709131267813,"w":0.046709129443535446,"conf":1}]