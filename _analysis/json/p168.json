[{"conf":0.5,"y":0.8965143660425519,"h":0.026016395342977505,"w":0.35719448626752687,"text":"哈夫曼條約 （Huffman treaty）","x":0.3583435915564713},{"conf":0.5,"y":0.8356815447453485,"h":0.029501406770003458,"w":0.7157786512716289,"text":"•CU與USN在『第一次哈夫曼紛爭』事件末期於莫斯科簽訂的條約。","x":0.18325257138718157},{"conf":0.5,"y":0.8062125252339575,"h":0.030454296814767967,"w":0.7431449070750671,"text":"根據條約規定，O CU與US N以哈夫曼島『梅爾河』為界，西側的土地歸","x":0.15801966260579364},{"conf":0.5,"y":0.7787516814998748,"h":0.020654420319356492,"w":0.7385977151001267,"text":"OCU所有、東側土地則納入U SN的領地。同時兩國均不得在哈夫曼島","x":0.1623411587400824},{"conf":1,"y":0.747359622260195,"h":0.021616339683532715,"w":0.7428500009322792,"text":"上使用核兵器、化學兵器等等會對環境造成嚴重破壞的兵器，同時，兩國也","x":0.15811225498737108},{"conf":1,"y":0.7146836222747941,"h":0.027843487890143237,"w":0.5174648312224978,"text":"不得在哈夫曼島上從事任何『非人道的兵器研究』。","x":0.1579422757645074},{"conf":0.30000001192092896,"y":0.572674418573665,"h":0.023255814062921654,"w":0.35021098644465987,"text":"哈夫曼危機 （Huffman crisis）","x":0.35864978075941467},{"conf":0.5,"y":0.5148029723843757,"h":0.019634024093025504,"w":0.715398747482846,"text":"西元2086年，OCU與USN部隊接連在哈夫曼島上爆發數起零星","x":0.17921973848310122},{"conf":1,"y":0.48214390488594816,"h":0.027500591780009964,"w":0.5849559847665573,"text":"的小規模戰鬥。兩國關係再度緊張，史稱『哈夫曼危機』。","x":0.15374305270135724},{"conf":0.5,"y":0.3531976747274598,"h":0.021802324997751255,"w":0.358649788722218,"text":"拉卡斯事件（Larcus incident）","x":0.3502109703507844},{"conf":0.5,"y":0.294258465201791,"h":0.02049476221988078,"w":0.7175479424597255,"text":"西元2090年，在軍方的命令之下，4台負責偵察任務OCU機甲小","x":0.17497421495269697},{"conf":0.5,"y":0.26129148026290583,"h":0.026988641211861064,"w":0.7428921720008577,"text":"隊刻意違反『哈夫曼條約』、然後侵入US N領地的『拉卡斯地區』。在那","x":0.15176123056765786},{"conf":0.5,"y":0.23249398758716788,"h":0.021424646440305284,"w":0.7428474517312426,"text":"裡，他們發現了一處從事祕密軍事研究的工廠、並且與U S N部隊發生激","x":0.14968294691871728},{"conf":0.5,"y":0.19576089384629913,"h":0.03139962804944896,"w":0.7579824952919898,"text":"烈的交戰，史稱『拉卡斯事件』。USN方面表示，這次的戰鬥不但造成U-","x":0.14947329338703924},{"conf":0.5,"y":0.1684584106520447,"h":0.030062967225125026,"w":0.732730983834278,"text":"SN的工廠爆炸、而且還有62名的US N人員死亡。後來『拉卡斯事件』","x":0.15372306662083213},{"conf":1,"y":0.13575190598112818,"h":0.030849533645730287,"w":0.5387598734197867,"text":"更成為接下來的『第二次哈夫曼紛爭』的直接導火線。","x":0.1493968341198861},{"conf":1,"y":0.07689144710077755,"h":0.02485273856865733,"w":0.7194092962224046,"text":"不過，隨著『第二次哈夫曼紛爭』的結束，世人卻發現『第二次哈夫曼紛","x":0.17088606907325488},{"conf":1,"y":0.05222039461035688,"h":0.014802631578947345,"w":0.04641350356946414,"text":"168","x":0.1582278473064721}]