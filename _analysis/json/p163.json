[{"x":0.7218683661159068,"w":0.1422505287023691,"y":0.9345930233283564,"h":0.021857264008596444,"conf":0.5,"text":"雷霆任務4"},{"x":0.09978770132163987,"w":0.7452228986299955,"y":0.9040697676448293,"h":0.0174585811016299,"conf":1,"text":"美洲非法移民以及毒品軍火的走私活動。由於中南美洲諸國大多都是仰賴美"},{"x":0.09766454396339376,"w":0.7473460710965669,"y":0.873459326250965,"h":0.01766639276910431,"conf":1,"text":"加兩國的各種消費與經貿往來才能存活，因此在合法的貿易與非法的毒品軍"},{"x":0.09752502804916717,"w":0.7476323934701772,"y":0.8396972414813669,"h":0.026305064669180367,"conf":1,"text":"火買賣都被封鎖的情況下，中南美洲各國的經濟開始呈現『大蕭條』的景況"},{"x":0.09967161438798423,"w":0.7370380254892203,"y":0.8095310406827368,"h":0.026038283486785496,"conf":1,"text":"。為了求取生存空間，雖然南美各國心中都有百般的不願，但是『政經軍』"},{"x":0.09754019843350627,"w":0.7433723302987905,"y":0.779088950737693,"h":0.02360452230386101,"conf":0.5,"text":"三方面都比不上美國的南美諸國也只能點頭加入美加兩國所提出的『USN"},{"x":0.09766454127225536,"w":0.4925690064063439,"y":0.7485465115229175,"h":0.018914457805448537,"conf":0.5,"text":"構想』、並且自願成為新國家USN的其中一州。"},{"x":0.15923567308470876,"w":0.23779192337623012,"y":0.6424418608499429,"h":0.0203488364803468,"conf":0.5,"text":"USN主要統合國"},{"x":0.19957536729817976,"w":0.17197453058682954,"y":0.5988372093480906,"h":0.014556381676955277,"conf":0.5,"text":"美利堅合眾國（美國）"},{"x":0.19957537250097987,"w":0.10615711028759298,"y":0.5770348837824382,"h":0.014583850945227406,"conf":1,"text":"墨西哥合眾國"},{"x":0.19955593065243826,"w":0.12318113216987026,"y":0.5551553967794742,"h":0.01468920648930594,"conf":1,"text":"巴西聯邦共和國"},{"x":0.19957537250097987,"w":0.10615711028759298,"y":0.5332785537365878,"h":0.014790468364831555,"conf":1,"text":"阿根廷共和國"},{"x":0.1995529932548917,"w":0.10620186879084662,"y":0.5115513505767535,"h":0.014687997352518689,"conf":1,"text":"巴拿馬共和國"},{"x":0.19957537380455587,"w":0.14012738374563366,"y":0.4897288411007441,"h":0.014790468364831555,"conf":1,"text":"烏拉圭東方共和國"},{"x":0.1995753738015116,"w":0.14012738374563363,"y":0.4679539855715843,"h":0.014790468364831555,"conf":1,"text":"蓋亞那協同共和國"},{"x":0.19738785594308295,"w":0.10840900127704328,"y":0.44599402867404914,"h":0.014988686867982715,"conf":1,"text":"格瑞那達群島"},{"x":0.19957537453655452,"w":0.08917196897359994,"y":0.42440427307488815,"h":0.014549215406105875,"conf":1,"text":"牙買加群島"},{"x":0.1995326438215056,"w":0.08713428790752703,"y":0.4039359462525395,"h":0.01334903782865704,"conf":1,"text":"巴哈馬群島"},{"x":0.1995351560641208,"w":0.12322268119225138,"y":0.3806534251588981,"h":0.014855940418353142,"conf":1,"text":"委內瑞拉共和國"},{"x":0.1974522272587976,"w":0.12526539655832145,"y":0.3590116279630662,"h":0.01453488364803468,"conf":1,"text":"宏都拉斯共和國"},{"x":0.15711252220832667,"w":0.2080679490016057,"y":0.2543138866903639,"h":0.020542317173377178,"conf":0.5,"text":"USN簡略年表"},{"x":0.2058195566354241,"w":0.6329595125638522,"y":0.20833172209095308,"h":0.020453989848604692,"conf":1,"text":"澳洲籍船隻『特莉妮達號』在巴拿馬運河遭到美國海軍逮捕。之後美澳兩國關係急"},{"x":0.10393865329760875,"w":0.08723946718069221,"y":0.20173262897687871,"h":0.013685905061594839,"conf":0.5,"text":"2011年"},{"x":0.20580221341894622,"w":0.6308439694918119,"y":0.18680716022548516,"h":0.020554781547803436,"conf":0.5,"text":"速惡化，澳洲政府決定加盟亞洲區域的經濟共同體，『曼谷經濟帶』以對抗美國。"},{"x":0.10391671820580962,"w":0.08728333619924693,"y":0.1682308527251123,"h":0.013828992255907502,"conf":1,"text":"2020年"},{"x":0.20594480356880032,"w":0.5095541293804462,"y":0.16844700060575424,"h":0.013239045954181572,"conf":0.5,"text":"新大陸合眾國（USN）成立，被統合的美洲各國紛紛退出聯合國"},{"x":0.20594480809144813,"w":0.29936304459205043,"y":0.14667214494539005,"h":0.014790468364831555,"conf":0.5,"text":"泛太平洋共同連合（OCU）正式成立"},{"x":0.10403396971232756,"w":0.08704883318680984,"y":0.14667214430665387,"h":0.013211576685909332,"conf":1,"text":"2026年"},{"x":0.10403396971232756,"w":0.08704883318680984,"y":0.12489728877715789,"h":0.013184106634009929,"conf":1,"text":"2068年"},{"x":0.20806794110780918,"w":0.19320594347440279,"y":0.12489728876773598,"h":0.013184106634009929,"conf":1,"text":"OCU勢力進駐哈夫曼島"},{"x":0.7919320593809519,"w":0.046709129443535446,"y