[{"h":0.02197191885679395,"y":0.9387838950652168,"w":0.14437367365910458,"text":"雷霆任務4","conf":0.30000001192092896,"x":0.7112526535440303},{"h":0.026497761734999292,"y":0.8908208865946894,"w":0.16147463138286883,"text":"劇情提要","conf":0.5,"x":0.37998455257584446},{"h":0.02321390608048568,"y":0.8187668018916623,"w":0.7243842345017654,"text":"畫面轉回到南美洲，為了跟愛爾莎派來的運輸機會合，達利爾三人正準備","conf":1,"x":0.11232420499974595},{"h":0.023092502634742718,"y":0.7896578644996934,"w":0.7435010029719425,"text":"起程前往港都•克馬納，至於路易斯方面則是打算進攻卡拉卡斯市的電視台","conf":0.5,"x":0.0910903410355419},{"h":0.023804668529952444,"y":0.7600292089063905,"w":0.7412548065185547,"text":"、然後透過電視轉播發表『獨立撤回宣言』。雖然達利爾認為卡拉卡斯市有","conf":1,"x":0.09328401466484401},{"h":0.023556373113477025,"y":0.7307120843524,"w":0.7456237352811373,"text":"伊凡諾娃的部隊防守、貿然進攻太過於危險，但是在沙蒙德的獻策之下，路","conf":1,"x":0.09108833152181607},{"h":0.022262077989789852,"y":0.7013013011530886,"w":0.5630559921264648,"text":"易斯還是決定從委內瑞拉郊外的高速公路進軍卡拉卡斯。","conf":1,"x":0.09108025140303702},{"h":0.023274546288621134,"y":0.6428007833704955,"w":0.7243526165301983,"text":"不過，就在達利爾等人準備離開之際，迪亞茲州長突然想起他的黃金就是","conf":0.5,"x":0.11235070296536691},{"h":0.023459051315571022,"y":0.6129920271252693,"w":0.7456525655893179,"text":"被達利爾他們偷走的事情、而且還透露給路易斯跟伊妮斯他們知道。伊妮斯","conf":1,"x":0.09108408258757225},{"h":0.022948795591305804,"y":0.5836098660464519,"w":0.7455775187565731,"text":"知道事情的經過之後對達利爾非常的不諒解，因為這些錢都是迪亞茲州長從","conf":1,"x":0.09111917969186947},{"h":0.02393643074380447,"y":0.5535371644073631,"w":0.7435695941631612,"text":"委內瑞拉百姓手搜括來的民脂民膏，但是現在達利爾竟然想帶著這些錢遠走","conf":1,"x":0.09318185815146372},{"h":0.023351144281291702,"y":0.5242983621164194,"w":0.7456337855412409,"text":"高飛，這種行為實在是太惡劣了。達利爾自知理虧，一時之間三人也不知道","conf":0.5,"x":0.09110469025553386},{"h":0.023351272796154343,"y":0.4947895865148745,"w":0.7456538127018855,"text":"該說什麼抱歉的話才好，倒是路易斯一點也沒有怪罪達利爾的意思。路易斯","conf":1,"x":0.09319382550002366},{"h":0.021926535086839505,"y":0.4665697676327967,"w":0.7452228986299956,"text":"表示，雖然達利爾想拿走這些錢確實是有點『不妥』，但是這段日子以來達","conf":1,"x":0.09341827543287909},{"h":0.02421519358626334,"y":0.43577242177421016,"w":0.7435630651620718,"text":"利爾三人一直都是真心的在幫助他們、一直都是真心跟他們併肩作戰，如","conf":1,"x":0.09317376938556589},{"h":0.021946838084262343,"y":0.4069767442457418,"w":0.7452228986299956,"text":"果沒有達利爾的幫忙話，『委內瑞拉公正軍』絕對不可能有今天這樣勝","conf":1,"x":0.09341827463394893},{"h":0.016293017121740472,"y":0.3763011658857758,"w":0.08928813384129451,"text":"利局面。","conf":0.5,"x":0.09336017922495417},{"h":0.023355723015088592,"y":0.3173994343868637,"w":0.722294440636268,"text":"於是，路易斯決定讓達利爾他們帶走這些黃金，就當作是答謝這段日子以","conf":1,"x":0.11656152485176353},{"h":0.029331570878416757,"y":0.2841921727655461,"w":0.7457201297466571,"text":"來達利爾幫助『委內瑞拉公正軍』的『酬勞』。聽到路易斯這麼說，達利爾","conf":1,"x":0.0952904972206099},{"h":0.024008314435170486,"y":0.2577777258062468,"w":0.7456728861882137,"text":"的心裡反而覺得非常過意不去，原本達利爾已經開著卡車上了國道，但是他","conf":1,"x":0.09531399037520391},{"h":0.025124552216604368,"y":0.2280790882276431,"w":0.7457232842078576,"text":"卻半途將車停了下來。達利爾向雷凱斯跟奇佛表示：『雖然路易斯說這些黃","conf":1,"x":0.09526483407823004},{"h":0.024284466231760726,"y":0.19870449209594698,"w":0.7456755271324744,"text":"金是答謝他們之前大力幫忙的酬勞，但是我們為遊擊隊所作的事情似乎還不","conf":1,"x":0.09532479488012638},{"h":0.023687426928329813,"y":0.16966557231017132,"w":0.7456446427565355,"text":"到可以拿2500萬美金的水準，為了讓自己拿這筆錢能夠拿得心安，我決","conf":0.5,"x":0.09533286545762533},{"h":0.021770036112801816,"y":0.13945009044295165,"w":0.3124414590688852,"text":"定回去繼續幫助游擊隊作戰。』","conf":1,"x":0.09540154082045021},{"h":0.024639706388299487,"y":0.08088282554514181,"w":0.7244910460252029,"text":"達利爾的說法立刻就獲得雷凱斯跟奇佛的認同。同一時間，奇佛透也過無","conf":1,"x":0.11863062426410384},{"h":0.01453488364803468,"y":0.05087209309431051,"w":0.046709129443535446,"text":"123","conf":1,"x":0.7961783438719032}]