[{"y":0.899671052594258,"w":0.6265822526663185,"conf":0.5,"x":0.2594936870370938,"h":0.017680921052631637,"text":"USN合眾國宣稱擁有太平洋中央海域•『哈夫曼島』的主權，『第一次哈夫曼紛爭』爆發"},{"y":0.8994731057339761,"w":0.08664580461233498,"conf":1,"x":0.15604418687253618,"h":0.01355378878744029,"text":"2070年"},{"y":0.8755323057323322,"w":0.6226413335322196,"conf":0.5,"x":0.26361016955264555,"h":0.020395430295090944,"text":"「第二次哈夫曼紛爭』爆發，薩夫特拉共和國與O C U、US N等3國利用士兵人"},{"y":0.8675402704534507,"w":0.08661871024703069,"conf":1,"x":0.15605773338138693,"h":0.013465970754623413,"text":"2090年"},{"y":0.8560218206538308,"w":0.5593043215803998,"conf":1,"x":0.25727438813025827,"h":0.017763318199860434,"text":"腦作為雷霆機甲電腦輔助系統的軍事研究醜聞曝光、全球輿論一片嘩然。"},{"y":0.8326480265756291,"w":0.5400844018612956,"conf":0.5,"x":0.25949366397539425,"h":0.017680921052631526,"text":"反USN組織•『自由之星』利用新型兵器在US N各地展開破壞行動"},{"y":0.8352136277416733,"w":0.08679117280145249,"conf":1,"x":0.155971502107204,"h":0.012712279432698259,"text":"2090年"},{"y":0.8124577341926612,"w":0.44953750938105974,"conf":0.5,"x":0.2594220348160593,"h":0.01847177430203084,"text":"U SN委內瑞拉州州長•迪亞茲發表『委內瑞拉獨立宣言』"},{"y":0.8137301693615554,"w":0.08662204241695723,"conf":1,"x":0.1560560672961129,"h":0.0120745450258255,"text":"2096年"},{"y":0.7914804089271155,"w":0.6268224602382906,"conf":0.5,"x":0.25936924608927764,"h":0.018261565189612528,"text":"試圖修復與OCU關係U S N開始提供大漢中人民共和國（前中國）軍事專用雷"},{"y":0.769821335870799,"w":0.6288967815390065,"conf":0.5,"x":0.2572929205743676,"h":0.01749711052367564,"text":"霆機甲。後來由於大漢中人民共和國新一屆的國家主席改變對U SN的政策，結果"},{"y":0.7701783758021454,"w":0.08871231443273139,"conf":1,"x":0.15606578360628812,"h":0.013422318195041805,"text":"2098年"},{"y":0.7483552635316444,"w":0.2594936616665424,"conf":0.5,"x":0.259493675424217,"h":0.014802631578947345,"text":"U SN開始轉而向日本合作示好。"},{"y":0.7263492128539815,"w":0.08884619300860494,"conf":1,"x":0.15599884488308216,"h":0.013871341943740845,"text":"2108年"},{"y":0.7252906973562125,"w":0.1603375528194455,"conf":1,"x":0.2573839661008258,"h":0.0145348843775297,"text":"墨西哥危機事件發生"},{"y":0.5639534884834894,"w":0.45569619699992536,"conf":0.5,"x":0.295358651108235,"h":0.023255814062921543,"text":"薩夫特拉共和國 （Republic of Zerftra）"},{"y":0.351744186324752,"w":0.09071729746524929,"conf":0.30000001192092896,"x":4.894217770383452e-10,"h":0.1845930250067459,"text":"L"},{"y":0.5061305463434576,"w":0.717594920593116,"conf":1,"x":0.17074095680381504,"h":0.022108492098356525,"text":"自從舊蘇聯解體之後，俄羅斯地區就充斥著許多小型的國家。雖然這些小"},{"y":0.4712746690277966,"w":0.740789590985792,"conf":0.5,"x":0.14753951699925077,"h":0.02790661077750356,"text":"國家在世界性的『共同體潮流』當中曾經組織了一個名叫『獨立國家共同體"},{"y":0.4417393527067329,"w":0.7410397040246495,"conf":0.5,"x":0.1473750937553554,"h":0.02555660825026662,"text":"』（CIS）的聯合體制，但是受到接連發生的內戰與俄國不願意提供經濟"},{"y":0.4127359151082215,"w":0.7428186821766856,"conf":0.5,"x":0.14756998381436917,"h":0.02134963870048523,"text":"援助影響，最後C IS是宣告解體、而且CIS的各會員國有很多都被歐"},{"y":0.3815148199436945,"w":0.7429225439103521,"conf":1,"x":0.14542982125354323,"h":0.02218882974825409,"text":"洲或亞洲的強國統合，結果造成俄羅斯地區的產業陸續外移、經濟狀態也愈"},{"y":0.3516009174407215,"w":0.11401575675727646,"conf":1,"x":0.14763347169697713,"h":0.01772839772073842,"text":"來愈惡化。"},{"y":0.28899774580270987,"w":0.7175515113411768,"conf":1,"x":0.17074737762253486,"h":0.020935115061308185,"text":"西元2015年，俄國在西伯利亞地區發現了極為大量的資源礦脈，俄國"},{"y":0.25737868859784063,"w":0.7407772819865006,"conf":1,"x":0.14754305075699795,"h":0.02175937514556081,"text":"的經濟也因為這些天然資源而起死回生。在經濟再度復興、甚至可以說是急"},{"y":0.22648779772460104,"w":0.7428753472740155,"conf":1,"x":0.14754537446448024,"h":0.02186192179981028,"text":"速成長的情況下，為了恢復俄羅斯舊有的光榮，俄國總統梅爾夫斯基宣布成"},{"y":0.193542709416613,"w":0.7302687469700925,"conf":0.5,"x":0.14752318214493862,"h":0.02585153673824514,"text":"立新國家『薩夫特拉共和國』、並且成立『永久和平調停機構』（PMO）"},{"y":0.16569767418921688,"w":0.27004220093064774,"conf":1,"x":0.14767932136171769,"h":0.01744186093932698,"text":"以維護世界的秩序與和平。"},{"y":0.10465116299607291,"w":0.7194092962224046,"conf":0.5,"x":0.16877636451575107,"h":0.018895348435954085,"text":"薩夫特拉共和國成立之後，原本脫離CIS的俄羅斯地區小國與東歐諸國"},{"y":0.07291841171071367,"w":0.7429198490406846,"conf":1,"x":0.14752376474907827,"h":0.022065437153766077,"text":"紛紛加盟，一時之間薩國國力強盛，為了表示斯拉夫地區與俄羅斯政經體制"},{"y":0.04358552640684332,"w":0.04852320869099838,"conf":1,"x":0.15611814237918437,"h":0.014554008841514587,"text":"164"}]