[{"h":0.024169603722352218,"text":"雷霆任務4","x":0.7089722068757714,"conf":0.30000001192092896,"y":0.9428570586392782,"w":0.14256514035738432},{"h":0.03709356453738055,"text":"關於「聯合作戰」","x":0.2630036835389285,"conf":0.5,"y":0.8704883472078515,"w":0.34665294793935925},{"h":0.02687433222423541,"text":"在本作中，玩家可以於進行駕駛員技能設定（劇情畫面中）時設定「聯","x":0.11008287277109262,"conf":1,"y":0.7961464873141668,"w":0.7224562718318058},{"h":0.030284397310180178,"text":"合行動」的僚機（Set Link s，詳細設定方法筆者將於後面章節-","x":0.08878414249826577,"conf":0.30000001192092896,"y":0.7649155464779684,"w":0.743817769564115},{"h":0.026601383895686004,"text":"「人物技能設定」中詳述）。只要進行了僚機設定，那麼當機體進行攻擊或","x":0.09122364000347954,"conf":1,"y":0.7380176691663964,"w":0.7411466745229869},{"h":0.023255154649645116,"text":"遭受攻擊時，位於該機體附近的僚機就會一起加入攻擊或是反擊的行列。由","x":0.08685882232897836,"conf":1,"y":0.713234099869348,"w":0.7456351060133715},{"h":0.02364895083224472,"text":"於每一位駕駛員最多可以設定三位成員配合他進行攻擊，因此玩家將有機會","x":0.08892565452535245,"conf":1,"y":0.6852897265269664,"w":0.7435873471773589},{"h":0.028044779768906958,"text":"在本作中體驗到最大「4對4」大規模戰鬥。至於在戰場上要如何判別某","x":0.08908084839586349,"conf":1,"y":0.6542665619632713,"w":0.7453927260178786},{"h":0.024629461246136408,"text":"機體駕駛員是否與其他成員組成聯合行動陣線呢？其實，當玩家以游標指","x":0.08892857927454387,"conf":1,"y":0.6284445855483107,"w":0.743593876178448},{"h":0.024796487468133344,"text":"定我方機體時所出現連接到其他機體的「藍色直線」就代表著這些機體會","x":0.08917196949540682,"conf":1,"y":0.6017441865122913,"w":0.7430997995229868},{"h":0.024851126659082956,"text":"與指定機進行聯合行動；而當玩家以游標指定想攻擊的敵機時，敵機身上也","x":0.0889244843248871,"conf":1,"y":0.5725033787302636,"w":0.7457213768592248},{"h":0.023848523443217307,"text":"會出現連往其他敵機的紅色直線，這些直線就代表著會與該機體進行行動的","x":0.08895193499604837,"conf":1,"y":0.5452488440208358,"w":0.7456703186035156},{"h":0.025983729711201775,"text":"敵機。至於機體上方數字，當然就代表了機體展開攻擊時命中率囉。","x":0.0889158035823401,"conf":1,"y":0.5170387018340767,"w":0.7223495336679313},{"h":0.014340754111673126,"text":"※請注意：","x":0.08902185621040076,"conf":1,"y":0.46394248600251164,"w":0.08741530088277963},{"h":0.02100717580602518,"text":"1） 進行聯合行動時，機體的行動順序將會受「該機體是攻擊側或防禦側」、「使用武器種頻」","x":0.0932728167412104,"conf":0.5,"y":0.4359411792705902,"w":0.7305965423583984},{"h":0.0161304967562097,"text":"、「駕駛員的速度」影響來決定。","x":0.12526538995051612,"conf":1,"y":0.417009038408631,"w":0.263269644517165},{"h":0.01976697603600286,"text":"2）參加聯合行動的機體，會根據它們各自採取的行動消耗相對量的AP點數。","x":0.0931887769426269,"conf":0.5,"y":0.3972223499795091,"w":0.6097730123079741},{"h":0.03211298043745514,"text":"關於「技能」","x":0.3583911128351543,"conf":0.5,"y":0.2810793514798633,"w":0.21541839379530686},{"h":0.024976224907128253,"text":"在本遊戲中，駕駛員可以利用在戰場上獲得EP（經驗值）點數來為自","x":0.11649250328079062,"conf":0.5,"y":0.21321057334865967,"w":0.7202912110548753},{"h":0.025412174748316585,"text":"己添各種「特殊技能」。在本作中，駕駛員可以裝備的技能共可以分為戰","x":0.09543454489182555,"conf":0.5,"y":0.18108355693489964,"w":0.7433161368736854},{"h":0.02955354112234876,"text":"鬥中會隨機發動的「戰鬥技能」、只要一裝備就會隨時保持發動效果「自","x":0.09529127721262214,"conf":1,"y":0.14942848941855036,"w":0.7414603600135216},{"h":0.030434886647132786,"text":"動技能」、以及裝備後玩家就能在戰場上以選單指令方式選擇發動的「指","x":0.09305182504740434,"conf":1,"y":0.11824400364044119,"w":0.7459681584284854},{"h":0.0248051536014654,"text":"令技能」等3大類。","x":0.09504818874847433,"conf":1,"y":0.08589487787573635,"w":0.2028203560755803},{"h":0.015988372639739845,"text":"027","x":0.7919320589672336,"conf":1,"y":0.05813953464843025,"w":0.05095541477203369}]