20919,"h":0.011627907031460882},{"w":0.2006444635140867,"text":"劇情提要","x":0.4302684847422614,"conf":0.30000001192092896,"y":0.5054254448079216,"h":0.02839329681898417},{"w":0.7197097377731579,"text":"就在路易斯一行人準備進入卡拉卡斯市區之際，US N部隊此時也打算進","x":0.18339148704088795,"conf":0.5,"y":0.4317429509663848,"h":0.022683929455907692},{"w":0.74286216426294,"text":"攻卡拉卡斯。為了讓這次的戰爭儘快和平落幕，達利爾決定搶在US N部隊","x":0.1602167651271737,"conf":0.5,"y":0.40144508005628354,"h":0.021776375017668048},{"w":0.7427853968945779,"text":"發動攻擊之前先拿下電視台，只要迪亞茲一撤回獨立宣言，整個委內瑞拉","x":0.16025909645927947,"conf":1,"y":0.370885638855701,"h":0.020583339427646785},{"w":0.742616057111426,"text":"局面應該會立刻緩和下來才是。在迪亞茲的命令之下，發現自己被伊凡諾娃","x":0.16033754089691987,"conf":1,"y":0.3400493424743546,"h":0.018962285236308496},{"w":0.7407378786219048,"text":"部隊利用的委內瑞拉獨立軍馬上就棄戰而逃（其實迪亞兹是怕自己在戰鬥中","x":0.160216246870942,"conf":1,"y":0.3083983835783256,"h":0.021284666500593463},{"w":0.7427440998377834,"text":"被獨立軍誤殺，所以他才會配合達利爾的計策要求獨立軍停戰）。委內瑞拉","x":0.15816819831065632,"conf":1,"y":0.27816510801541383,"h":0.019842845828909605},{"w":0.7427982157340767,"text":"獨立軍不戰而逃的行為讓伊凡諾娃大為光火，憤怒的伊凡諾娃隨即命令手下","x":0.15813565475803534,"conf":1,"y":0.24662383233393215,"h":0.020948295530520022},{"w":0.7383966195554893,"text":"--將游擊隊連同迪亞茲州長一起格殺！不過，伊凡諾娃的攻勢依然阻擋","x":0.16033755544729056,"conf":0.5,"y":0.2136627912866016,"h":0.02482405069627258},{"w":0.7405063383334578,"text":"不了達利爾一行人，這一次伊凡諾娃終於在眾人攻擊之下戰死、同時『薩","x":0.1582278501792626,"conf":1,"y":0.1858552631242777,"h":0.02055921052631582},{"w":0.5843881684442124,"text":"夫特拉共和國』的剩餘軍隊也完全撤出了委內瑞拉當地⋯","x":0.15822785641521012,"conf":0.30000001192092896,"y":0.15406976730713007,"h":0.020348837501124484},{"w":0.048523204138853665,"text":"126","x":0.16455696327461733,"conf":1,"y":0.04358552642640956,"h":0.014554008841514587}]