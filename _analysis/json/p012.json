[{"text":"＞ 機體各零件HP","conf":0.30000001192092896,"x":0.1645569653290045,"y":0.8938953487069512,"h":0.020348837501124373,"w":0.22995779906935226},{"text":"標示在表格的最右方，共有4條量表。其代表意義由上而下分別是：「B-","conf":0.5,"x":0.17299579707904875,"y":0.8589638161205508,"h":0.017680921052631526,"w":0.7341771819995525},{"text":"ODY／機體本體」「ARMLR／機體左臂右臂」「LEGR／機體腳部」","conf":0.30000001192092896,"x":0.1540084210375436,"y":0.8326480263228225,"h":0.022203947368421018,"w":0.7552742969449209},{"text":"駕駛員經驗值","conf":0.5,"x":0.1962025324620378,"y":0.7701480266782257,"h":0.020559210526315708,"w":0.15189873233330844},{"text":"標示於機體名稱右方，接近表格最右側的一條量表即是。只要能集滿這條","conf":1,"x":0.1729957665751054,"y":0.7354651164858322,"h":0.019057909909047543,"w":0.721519015000373},{"text":"量表，駕駛員的等級就會提昇。","conf":1,"x":0.14978903235347446,"y":0.7121710528299807,"h":0.018933598148195285,"w":0.3143459857221435},{"text":"駕駛員等級","conf":0.30000001192092896,"x":0.1559265041106674,"y":0.6445752503539621,"h":0.02189601095099203,"w":0.16704994511205998},{"text":"標示於「駕駛員經驗值」量表右方。","conf":1,"x":0.17261742601827,"y":0.6058758241665149,"h":0.02590578167062063,"w":0.38045361502927355},{"text":"目前機體有無異常狀態","conf":1,"x":0.19409282336552147,"y":0.5464638154337804,"h":0.02055921052631593,"w":0.2510548593889842},{"text":"如果目前機體有什麼異常狀態的話，那個該狀態就會直接標示在駕駛員肖","conf":1,"x":0.1708267480978705,"y":0.5115416348999018,"h":0.019503921270370483,"w":0.719536464936978},{"text":"像的上方。","conf":1,"x":0.14975532853162818,"y":0.48972245965548644,"h":0.017648103990052788,"w":0.11188174773514412},{"text":"關於AP點數的意義","conf":1,"x":0.3544303757174966,"y":0.3429276311862983,"h":0.02631579025795583,"w":0.35443038758343903},{"text":"所謂的AP點數，即是「ACTION POINT」=行動點數略稱","conf":0.5,"x":0.16862827638786473,"y":0.27201240799260895,"h":0.024563981514228006,"w":0.7176183732426537},{"text":"，也就是每架機體在該回合所能進行動作的總點數。不管玩家想讓機體進行","conf":1,"x":0.1497890281266156,"y":0.2483552634247892,"h":0.019086596997160643,"w":0.7383966195554892},{"text":"什麼樣的行動（移動、攻擊•••等）都一定會消耗一定程度的AP，也就","conf":0.5,"x":0.14556961553791256,"y":0.2208059209090244,"h":0.01611268363500895,"w":0.7405063383334577},{"text":"是說，當玩家AP耗盡時，該機體在該回合中就不能再執行任何動作。","conf":1,"x":0.14556961829646176,"y":0.19325657907791882,"h":0.017680921052631526,"w":0.696202535333383},{"text":"AP點數在每個玩家回合開始時就會自動回復。雖然每位角色的AP上限","conf":0.5,"x":0.16877636441082422,"y":0.1380813951150731,"h":0.017441860939327092,"w":0.7194092962224045},{"text":"值都各有不同，但玩家仍然能夠藉由電腦升級（アップグレード）或是到電","conf":1,"x":0.14556962260243173,"y":0.1104651163908964,"h":0.016179620435363362,"w":0.7383966195554892},{"text":"腦商店整備機體來提昇角色的AP點數。","conf":0.5,"x":0.14556961752951847,"y":0.08264802657606085,"h":0.017680921052631637,"w":0.4029535917222927},{"text":"012","conf":0.5,"x":0.15189873310703247,"y":0.04505813958582616,"h":0.013081395312359412,"w":0.04852320869099838}]