[{"x":0.711252656302292,"y":0.9416598195198904,"w":0.1401273837456336,"conf":0.5,"h":0.023456459860382473,"text":"雷霆任務4"},{"x":0.08684416150584201,"y":0.9059990349347986,"w":0.7604753787700946,"conf":0.5,"h":0.02368970258175207,"text":"叛軍很快就攻佔了OCU軍事基地與首都，同時叛軍也挾持了大量的OC-"},{"x":0.08898190347439548,"y":0.8760438347933923,"w":0.7455929976243238,"conf":0.5,"h":0.02335059104048043,"text":"U人員作為人質。然而，本次的叛變事件其實是OCU軍方為了測試祕密兵"},{"x":0.08899741836708586,"y":0.8430015664957224,"w":0.7434899990375226,"conf":0.5,"h":0.025402558075176884,"text":"器•『環誘導侵攻制御裝置』而刻意讓它發生的，完全不知情的馬卡傑說穿"},{"x":0.08900512523498831,"y":0.814922728075876,"w":0.4249523602999173,"conf":0.5,"h":0.019192948729265136,"text":"了也只不過是OCU軍方的一顆棋子而已。"},{"x":0.36093418488815604,"y":0.7062448642869728,"w":0.21231422057518595,"conf":0.30000001192092896,"h":0.02195281010724126,"text":"MIDAS事件"},{"x":0.11235206073381487,"y":0.646325338061904,"w":0.7243241530198318,"conf":0.5,"h":0.02131382167192386,"text":"MIDAS （Matter Irradiation Type Dissociate Acceleration Sys-"},{"x":0.08907049846597505,"y":0.6161601389757536,"w":0.7475296900822567,"conf":0.5,"h":0.024295375889799242,"text":"tem）是由克蘭姆斯可博士所發明的『無污染&高能量產生裝置』。雖然克"},{"x":0.08897984810433303,"y":0.5846562007579129,"w":0.747703112088717,"conf":1,"h":0.02316333548201821,"text":"蘭姆斯可博士開發這台裝置的本意是打算用它來取代傳統的核能發電，但是"},{"x":0.09107563884184774,"y":0.5535216168474231,"w":0.7456464033860427,"conf":0.5,"h":0.023391135128776552,"text":"因為MIDAS在軍事用途上可以發揮比核子兵器更強大的威力、而且又完"},{"x":0.09110365230815577,"y":0.5227547563671395,"w":0.743444222670335,"conf":0.5,"h":0.02150108663391259,"text":"全沒有核能污染的優點，因此包括OCU、USN、以及大漢中人民共和國"},{"x":0.08898638753102658,"y":0.4911626119366552,"w":0.74773619725154,"conf":0.5,"h":0.02364981830756796,"text":"在內，幾乎世界各國都像把MID A S的資料據為己有。為了搶奪克蘭姆斯"},{"x":0.09129513235561429,"y":0.459302325330716,"w":0.7452228986299955,"conf":0.5,"h":0.023442128102311166,"text":"可博士開發出來的『原型MID AS』回來研究，各國隨即展開一場激烈"},{"x":0.09755560022902351,"y":0.4277292594918456,"w":0.5098337026742789,"conf":0.30000001192092896,"h":0.02248059478860076,"text":"『MIDAS爭奪戰』，史稱『MIDAS事件』。"},{"x":0.3333333345067384,"y":0.32251437914808967,"w":0.2717622060042161,"conf":1,"h":0.026322830281692577,"text":"日本國防軍叛變事件"},{"x":0.11448934401900615,"y":0.2667439521706553,"w":0.7349144862248348,"conf":0.5,"h":0.021458462015369828,"text":"在日本內閣的暗中認可之下，日本國防軍強行奪取了USN合眾國的M1-"},{"x":0.09554140904079454,"y":0.23691860492385763,"w":0.7409766270564153,"conf":0.5,"h":0.021914591824508833,"text":"D AS、並且展開了一連串『積極防禦計劃』、以期能夠跟其他的核武國"},{"x":0.09330432300691069,"y":0.20466215748227756,"w":0.745432266822228,"conf":0.5,"h":0.024275899619084496,"text":"家擁有相對等外交地位。然而，隨著各國對『MID AS爭奪戰』的明爭"},{"x":0.09321022144698173,"y":0.17331089419409296,"w":0.7456689247718223,"conf":1,"h":0.023399138313487833,"text":"暗鬥愈來愈激烈，擔心無法掌握局面的日本政府開始出現退縮的念頭。看到"},{"x":0.09546242107833695,"y":0.1418079873787199,"w":0.7432608237633339,"conf":0.5,"h":0.0250319737142094,"text":"日本內閣這麼樣的不知變通，手上握有『MIDAS』這張王牌國防軍右"},{"x":0.09322595164812632,"y":0.11121973351818937,"w":0.7456196271456205,"conf":1,"h":0.023776055165951382,"text":"派激進人士（以參謀長佐佐木為首）竟然發動了軍事政變、並且挾持日本首"},{"x":0.09329007268946579,"y":0.08119913903124198,"w":0.38242222712590146,"conf":0.5,"h":0.019258307940468233,"text":"相與MID AS來跟日本政府軍對抗。"},{"x":0.7961783434091967,"y":0.0550534100907184,"w":0.040339703743274336,"conf":1,"h":0.014790468364831555,"text":"171"}]