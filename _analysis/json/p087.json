[{"conf":0.5,"h":0.0244567082764775,"w":0.14477860927581787,"x":0.7046807589875802,"y":0.944166995116637,"text":"雷霆任務4"},{"conf":0.5,"h":0.039605936067654834,"w":0.17169719475966239,"x":0.38366359864418587,"y":0.8906136991128271,"text":"劇情提要"},{"conf":1,"h":0.0240668106392552,"w":0.7223435181837814,"x":0.1059092621321471,"y":0.825078377247542,"text":"鏡頭𨍭到南美洲，達利爾一行人居住在游擊隊根據地也已經有一段時間了"},{"conf":0.5,"h":0.024805154385092676,"w":0.7412455632136419,"x":0.08691984021830693,"y":0.792761438715279,"text":"。原本『委內瑞拉公正軍』的領導者•路易斯是打算儘快送達利爾他們出國"},{"conf":0.5,"h":0.02433939223026982,"w":0.7435808181762695,"x":0.08681478085845658,"y":0.7635740145009731,"text":"。但是，受到US N軍隊開始往迪亞茲州長的根據地•卡拉卡斯進軍影響"},{"conf":0.5,"h":0.025060048726316175,"w":0.7415699592003456,"x":0.0888681037076985,"y":0.732058053005977,"text":"，路易斯決定搶在US N軍之前先一步拿下卡拉卡斯、然後逮捕迪亞兹州長"},{"conf":1,"h":0.02555367509752582,"w":0.7433106349064753,"x":0.08694475361318435,"y":0.6998905226852528,"text":"並撤回『委內瑞拉獨立宣言』，希望藉此能夠平息委內瑞拉的戰火。聽完路"},{"conf":0.5,"h":0.02521999330920288,"w":0.7457728752723106,"x":0.08675850149001096,"y":0.669912358582014,"text":"易斯的計劃、以及情報販子•瑪莉亞的情報之後，達利爾決定幫助路易斯他"},{"conf":0.5,"h":0.02500946402255877,"w":0.7436522703904372,"x":0.08677873001456586,"y":0.6390279314953037,"text":"們逮捕州長。當然，達利爾心中真正的盤算是一一只要迪亞茲一倒台，委內"},{"conf":1,"h":0.02526728912955334,"w":0.7458069141094502,"x":0.0867421723287718,"y":0.6080616653387314,"text":"瑞拉的緊張情勢就能暫時獲得舒解，這樣一來他們才可以儘快出國、然後帶"},{"conf":0.5,"h":0.02104543562099992,"w":0.1812297747685359,"x":0.08667185778256464,"y":0.576525141527326,"text":"著黃金遠走高飛。"},{"conf":1,"h":0.02426376201720548,"w":0.7223870204045222,"x":0.11012541942651119,"y":0.5151166012337274,"text":"就在眾人抵達卡拉卡斯的同時，路易斯赫然發現他們游擊隊的秘密基地正"},{"conf":1,"h":0.024994369795210747,"w":0.7436263011052059,"x":0.08890230607923358,"y":0.48351425403167225,"text":"被委內瑞拉獨立軍攻擊著。為了救出被困在祕密基地內部的其他同志，達利"},{"conf":1,"h":0.02291581193834613,"w":0.5397780491755559,"x":0.08892633975978582,"y":0.4526651892114577,"text":"爾一行人開始向委內瑞拉獨立軍的機甲部隊發動攻擊。"},{"conf":0.30000001192092896,"h":0.13352506162695155,"w":0.22560976101801944,"x":0.35365853376482614,"y":0.17912900468617132,"text":"44"},{"conf":0.30000001192092896,"h":0.09748025986633047,"w":0.48534818796011125,"x":0.22547860476908668,"y":0.1009820327247869,"text":"雷霆任務"},{"conf":1,"h":0.014555187429084793,"w":0.053078555143796446,"x":0.787685775404924,"y":0.05957271954149268,"text":"087"}]