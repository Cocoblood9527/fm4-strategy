[{"h":0.02473318841286931,"y":0.9345930235868156,"text":"雷霆任務4","x":0.7133757981509335,"w":0.1486199544026301,"conf":0.30000001192092896},{"h":0.033618287562148574,"y":0.8625161659815607,"text":"在戰場上行動","x":0.26728420315730356,"w":0.31681328553419846,"conf":0.5},{"h":0.02636463052440885,"y":0.7686935091519074,"text":"移動","x":0.43312101801076774,"w":0.08067940748654878,"conf":0.5},{"h":0.025277483335947926,"y":0.6989519591318276,"text":"首先，當玩家以游標指定我方可以行動的機體時，該機體的周圍會立刻出","x":0.11649417008990508,"w":0.7224500362689679,"conf":1},{"h":0.025672724527125435,"y":0.6676143733539978,"text":"現一堆藍色的方塊。這些方塊所籠罩的範圍就是該機體可以行動的範圍。這","x":0.09521880951151303,"w":0.7458309760460488,"conf":1},{"h":0.025579668795758792,"y":0.6369557995215092,"text":"時如果玩家打算進行移動的話，只要把游標移動到想移動的地點上按下•鈕","x":0.09316717182682116,"w":0.7478468968318057,"conf":0.5},{"h":0.025217656532858124,"y":0.605746793521251,"text":"即可。如果不想移動，而想讓機體待在原地執行某些行動的話，那只要把游","x":0.0952772721709853,"w":0.745782705453726,"conf":1},{"h":0.025077477379127466,"y":0.5751768254603481,"text":"標移到機體上並按下•鈕，並從接下來出現的選單中挑選想要執行的行動指","x":0.09526225709391624,"w":0.7457630450908955,"conf":1},{"h":0.01884788789020364,"y":0.5443551258842916,"text":"令即可。","x":0.09526395199792517,"w":0.0918500148333036,"conf":1},{"h":0.014549136259757622,"y":0.5059592291395631,"text":"※請注意：","x":0.09526656735574034,"w":0.0855452739275419,"conf":1},{"h":0.022218343755115444,"y":0.4774227118172947,"text":"雖然遊戲會自行依照機體的行動順序以游標指定機體，但如果玩家想先移動其他機體的話，只要","x":0.09530958762219736,"w":0.7372162158672627,"conf":1},{"h":0.022701938130763488,"y":0.4588990340317617,"text":"按下R1鈕就可以辦到。此外，本回合中已經完成移動的機體身上將會被加上一個「E」符號。","x":0.09537649697517846,"w":0.7370440409733698,"conf":0.5},{"h":0.02798262559299891,"y":0.3450306951998504,"text":"關於移動限制","x":0.36284506094459307,"w":0.2254771819481483,"conf":1},{"h":0.02596196681628382,"y":0.2752519883924206,"text":"原則上，機體的移動能力會完全取決於機體的腳步零件種類。如果地形的","x":0.12073534671038405,"w":0.724570787869967,"conf":1},{"h":0.025493499580326873,"y":0.24440286403187628,"text":"高低落差太大的話，當玩家裝備某些腳部零件時就可能會發生無法跨越這些","x":0.09950135026513109,"w":0.7458002383892354,"conf":1},{"h":0.025872784554223704,"y":0.21306663446396545,"text":"地形的問題（但就算縮裝備的腳步零件能夠跨越這種特殊地形，玩家機體","x":0.09951039575123256,"w":0.7458352309006911,"conf":1},{"h":0.025493499580326873,"y":0.18211914903675275,"text":"移動能力還是會比在一般平地移動時要降低一些）。此外，如果玩家在機體","x":0.0995257716837737,"w":0.7458002383892353,"conf":1},{"h":0.02412251086144923,"y":0.1505074494697226,"text":"上裝備「ジェットパック」（噴射背包）話，那麼因為噴射背包性能影","x":0.10181113331470935,"w":0.7432937622070312,"conf":1},{"h":0.025277218469950458,"y":0.12003128190226431,"text":"響，玩家機體的移動能力也會得到強化（不過消耗AP值也會增加）。","x":0.10160783349027486,"w":0.6990752586951623,"conf":1},{"h":0.01453488364803468,"y":0.04796511635012446,"text":"013","x":0.800424628383075,"w":0.046709129443535446,"conf":1}]