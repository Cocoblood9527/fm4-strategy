[{"h":0.021813074486512263,"x":0.711252654896427,"conf":1,"y":0.9433032045512942,"text":"雷霆任務4","w":0.1422505287023691},{"h":0.0272166268592402,"x":0.08885012979921815,"conf":0.5,"y":0.9063172206647879,"text":"爭』根本就是薩夫特拉共和國、USN、以及OCU3國為了實地測試『某","w":0.7436528572669396},{"h":0.026004712897044424,"x":0.08903859462426386,"conf":1,"y":0.8772230555823222,"text":"項不人道的軍事研究』而刻意自導自演的一齣戲。當然『拉卡斯事件』也是","w":0.7454613172090971},{"h":0.02692576637988997,"x":0.0910932554270111,"conf":0.5,"y":0.8470785623980844,"text":"3國高層事先就安排好的『戰爭藉口戲碼』。","w":0.4484338026780349},{"h":0.021914591824508722,"x":0.19532908885124692,"conf":0.5,"y":0.7369186047198104,"text":"第二次哈夫曼紛爭 （Second Huffman dispute）","w":0.5435244120084323},{"h":0.02245126440570122,"x":0.11237027463320196,"conf":0.5,"y":0.6785175827008149,"text":"乍看之下好像是OCU與U S N兩國為了爭奪哈夫曼島領土主權而爆發","w":0.7221796329204853},{"h":0.02468270636427672,"x":0.08909916843279528,"conf":1,"y":0.6457597514692357,"text":"的戰爭，其實『第二次哈夫曼紛爭』是沙卡達企業、薩夫特拉共和國、US-","w":0.7602194272554836},{"h":0.02512802055064245,"x":0.0912000312520415,"conf":0.5,"y":0.6155851940789215,"text":"N、以及OCU等三國為了實地測試『BD生體電腦』（取出士兵的人腦然","w":0.7433027120736929},{"h":0.022625848712153118,"x":0.08899619943246649,"conf":1,"y":0.5852867868392813,"text":"後改造成雷霆機甲可以使用的超高性能電腦）而刻意引發的戰爭。由於愈有","w":0.74555910550631},{"h":0.02288602234990056,"x":0.08899777779115844,"conf":1,"y":0.5539342314981619,"text":"戰鬥經驗的士兵人腦改造成生體電腦（BD）之後愈能發揮超高性能，因此","w":0.7455894763653095},{"h":0.02764140296001949,"x":0.08892480629739395,"conf":1,"y":0.5212367948019124,"text":"三國才會故意引發戰爭、以期能夠取得大量實驗資料、進而產量『BD生體","w":0.7457375159630408},{"text":"電腦』。","h":0.018611862508606025,"conf":0.5,"x":0.0908077772965609,"w":0.08763390320997971,"y":0.4899403518167553},{"text":"『第二次哈夫曼紛爭』結束後，這種冷血犧牲自國士兵的殘忍軍事研究被","h":0.02325581446375724,"conf":1,"x":0.11677283722257499,"w":0.7197451958289514,"y":0.4287790695157888},{"w":0.7414010121272161,"x":0.09320715908948395,"h":0.023228402400271464,"text":"OCU的情報單位•聯合中央情報局（C｜U）公諸於世，全球輿論為之嘩","conf":0.30000001192092896,"y":0.39818877772800065},{"w":0.743399766775278,"x":0.09112787768953655,"h":0.02107524009836237,"text":"然，USN、OCU、以及薩夫特拉共和國政府高層面臨了空前絕後政治","conf":0.5,"y":0.36754305836379497},{"w":0.7476830849280725,"x":0.0890114624605997,"h":0.023350434315038027,"text":"危機，即使三國破天荒的革去許多重量級政治軍事高層人員的職務，但是人","conf":1,"y":0.33576811788326655},{"w":0.3167411364041842,"x":0.0911007219489919,"h":0.020869078749795378,"text":"民對政府的不滿還是沒有解除。","conf":0.5,"y":0.3048216175761872},{"w":0.7455037190363958,"x":0.09116512264842846,"h":0.025447886207599302,"text":"※『第二次哈夫曼紛爭』結束後，各國對『BD生體電腦』事件的後續處理","conf":0.5,"y":0.24036171461441946},{"w":0.12960494481600246,"x":0.13583447024962106,"h":0.019195555073370563,"text":"OCU方面","conf":0.5,"y":0.17717547830880132},{"w":0.7222604017991286,"x":0.11656588419474402,"h":0.024053807129307492,"text":"當初在陸防軍情報部長•丹尼爾的指示下，OCU成立了一支由數十名隊","conf":0.5,"y":0.12833941208752742},{"w":0.7455428930429311,"x":0.09326963013726913,"h":0.024491314037764944,"text":"員所組成的傭兵部隊，『奇尼翁克羅』。事實上，這支部隊其實是丹尼爾準","conf":0.5,"y":0.10434492729670308},{"w":0.7452228986299956,"x":0.09341827457268573,"h":0.02325581446375724,"text":"備用來累積士兵戰鬥經驗的『白老鼠』。所幸『奇尼翁克羅』部隊中途發現","conf":1,"y":0.0828488369669459},{"w":0.0488322698152982,"x":0.7898089180647501,"h":0.013081395439956567,"text":"169","conf":1,"y":0.05813953486930745}]