[{"x":0.7109992938919322,"conf":0.5,"h":0.023398688511468424,"text":"雷霆任務4","y":0.9367018185584917,"w":0.14275725071246803},{"x":0.3884811204934061,"conf":0.5,"h":0.026457984817743085,"text":"劇情提要","y":0.8908407750536336,"w":0.15297406453352713},{"x":0.11453002370152501,"conf":0.5,"h":0.02165667895126655,"text":"解決完德國邊界的德軍，愛爾莎一行人暫時回到運輸機上與另一位同伴•","y":0.819246065990865,"w":0.7199947650615985},{"x":0.09332179590127865,"conf":1,"h":0.025143070111239507,"text":"波許會合，波許會教導玩家有關『飛彈引導背包』的使用方法。看完教學內","y":0.7869489947396602,"w":0.7433036657480093},{"x":0.09327508315055545,"conf":1,"h":0.022080802290578738,"text":"容後，哈米茲這邊也成功侵入德軍偵防雷達機的電腦、並且查出神祕敵人已","y":0.7574878569072856,"w":0.7454878733708308},{"x":0.09333688554943965,"conf":1,"h":0.024666395163869148,"text":"經逃進『布拉尼貝爾』的軍事基地。為了調查真相，吉德決定向瓦古納小隊","y":0.7240842999561543,"w":0.7432507735032302},{"x":0.09333762525994693,"conf":1,"h":0.025963091321332454,"text":"長提出『進入基地之內調查』的請求。然而，瓦古納不但嚴詞拒絕，而且還","y":0.6922595830357823,"w":0.7453661698561448},{"x":0.09107772035266404,"conf":0.5,"h":0.02634118988363099,"text":"用各種無禮言語向迪蘭達爾眾人挑釁，擔心神祕敵人白證據被『布拉尼貝","y":0.6633608189088094,"w":0.7456598281860353},{"x":0.09328409552514613,"conf":1,"h":0.026217638515701136,"text":"爾』銷毀的吉德只好無奈的下達『基地攻擊命令』，但是眾人並不知道，瓦","y":0.6321366592963991,"w":0.7454725412222055},{"x":0.09330786884828164,"conf":1,"h":0.02134749570045691,"text":"古納私底下已經連絡德國陸軍趕來支援、而且瓦古納也已經擬好計劃，準備","y":0.6030668585679264,"w":0.745428598844088},{"x":0.09329450306851943,"conf":0.5,"h":0.02040194446372512,"text":"將愛爾莎一行人誣陷抹黑成攻擊德國與波蘭的真正元兇了……","y":0.5721265618574523,"w":0.6329296552217925},{"x":0.11451758045005936,"conf":1,"h":0.021377143452377068,"text":"打倒基地之內的敵人後，德國陸軍的鮑爾上尉也來到現場。看到基地一片","y":0.510013024632131,"w":0.7221389917226939},{"x":0.09327151709951603,"conf":1,"h":0.02243535520605311,"text":"狼藉的景象，鮑爾上尉立刻就質問吉德詳情。吉德將追蹤神祕敵人一事告訴","y":0.47783784649245475,"w":0.7455039391150842},{"x":0.09341825316860258,"conf":1,"h":0.01896820287775003,"text":"鮑爾上尉之後，鮑爾上尉隨即在基地內部展開搜索，奇怪的是，眾人翻遍了","y":0.44905505305265037,"w":0.7430997995229869},{"x":0.09326852564689735,"conf":1,"h":0.021884824177625273,"text":"整個基地，但就是沒有找神祕敵人所使用的機甲。此時吉德跟哈米茲心裡頭","y":0.41609334527268793,"w":0.7455008580134465},{"x":0.09323891047124783,"conf":0.5,"h":0.02974031083193973,"text":"已經有底，他們很有可能是被敵人『誤導』前來此地、然後遭到陷害了。所","y":0.38128948538581287,"w":0.7456065691434419},{"x":0.09325827749346235,"conf":1,"h":0.022654289678167627,"text":"幸鮑爾上尉這個人還算明理，在政治面的考量之下，鮑爾上尉僅僅要求吉德","y":0.353241631337614,"w":0.7434254426222582},{"x":0.09328063850443602,"conf":1,"h":0.022315051189287893,"text":"他們立刻離開德國。看到自己陷害迪蘭達爾眾人的計謀並不算成功，瓦古納","y":0.322229939241675,"w":0.7454889004047099},{"x":0.09328075407412256,"conf":1,"h":0.02081981994327986,"text":"也只能不發一語的看著愛爾莎一行人離開了。","y":0.2916505205308225,"w":0.4503863774813139},{"x":0.7832585128588345,"conf":0.30000001192092896,"h":0.013782277103320584,"text":"069","y":0.05052165217585325,"w":0.05344051122665405}]