[{"y":0.8532778268209916,"conf":0.5,"w":0.5604934146125448,"h":0.04628413288216848,"text":"歷代『雷霆任務』歷史介紹&名詞解釋","x":0.3325819639710864},{"y":0.7643914472002675,"conf":0.5,"w":0.521097042111053,"h":0.02796052631578938,"text":"國家、共同體、地區、特殊機關","x":0.2742616052668451},{"y":0.664016037556231,"conf":0.5,"w":0.738803544875261,"h":0.028072451290331424,"text":"太平洋共同連合 （Oceana Community Union。簡稱OCU）","x":0.16225356834148383},{"y":0.6065895297664998,"conf":1,"w":0.7175852336291766,"h":0.025878843508268634,"text":"為了不讓自己的國家成為西方世界的『經濟殖民地』，亞洲各國陸續在『","x":0.1791586672613817},{"y":0.575516334959689,"conf":1,"w":0.7407450163848076,"h":0.026710049102180777,"text":"經濟自立』與『共同聯合』的前提之下組織、並且加入其中的『政經共同國","x":0.1560001630552467},{"y":0.5466804360984585,"conf":0.5,"w":0.7428262569454804,"h":0.020244181156158447,"text":"體』，OCU的涵蓋範圍主要是以大洋洲、東亞、以及東南亞為主。在 O-","x":0.15600230070959675},{"y":0.5172697369178293,"conf":0.5,"w":0.7362869007775209,"h":0.017680921052631526,"text":"CU體制之下，各會員國雖然擁有各自獨立的自治權，但是根據『OCU","x":0.1561181528712355},{"y":0.48102249627650995,"conf":0.5,"w":0.7387441120739484,"h":0.028475080665789188,"text":"憲章』的規定，各會員國所施行的國政內容必須以『維護OCU全體利益』","x":0.1538644027116957},{"y":0.4533025429210863,"conf":0.5,"w":0.7407980397663707,"h":0.022183703748803296,"text":"作為最高指導原則。另外，OCU的總本部是設在澳洲的坎培拉，聯合國防","x":0.15386975229708721},{"y":0.42166076181907386,"conf":0.5,"w":0.738714177170346,"h":0.0227173111940685,"text":"部、聯合外交部、聯合內政部、聯合經濟部等5個部會則是負責整個OCU","x":0.1538399833334732},{"y":0.39450509494933916,"conf":0.5,"w":0.135458834700482,"h":0.0191293452915392,"text":"的行政工作。","x":0.15167986472120767},{"y":0.3293974143093331,"conf":0.5,"w":0.7195686577043556,"h":0.0223987886780187,"text":"在OCU還沒有正式誕生之前，原本亞洲各國是打算建構一個名叫『曼谷","x":0.1729252510335394},{"y":0.2946055679824401,"conf":1,"w":0.740864755999217,"h":0.025477681505052585,"text":"經濟帶』的經濟共同體。但是，因為當時亞洲各國都缺乏豐富的資源與強而","x":0.1517035391225631},{"y":0.2646124894481069,"conf":0.5,"w":0.7429106719169525,"h":0.027280362028824556,"text":"有力對外交涉能力，因此『曼谷經濟帶』構想後來只能流於『紙上談兵","x":0.1496534021968692},{"y":0.2368421054465888,"conf":0.5,"w":0.7362869007775209,"h":0.018971847860436708,"text":"』虛擬形式。所幸在澳洲與日本的全力奧援下，OCU才於西元2096","x":0.14978903836737487},{"y":0.20917542001552658,"conf":1,"w":0.13508969218178976,"h":0.017695672417941788,"text":"年順利誕生。","x":0.149754731840788},{"y":0.14381796184067908,"conf":0.5,"w":0.7196812595558622,"h":0.021627529671317647,"text":"然而，經過統合之後的OCU雖然擁有豐富的資源與強大的經濟力，但是","x":0.17076252534577202},{"y":0.1127870184024723,"conf":1,"w":0.7407667938450926,"h":0.02195794017691355,"text":"各會員國之間的民族紛爭與宗教衝突卻從來沒有斷絕過。西元2070年、","x":0.1475512291618273},{"y":0.08062156545141097,"conf":0.5,"w":0.7409538323668705,"h":0.02734937165912832,"text":"西元2090年，OCU兩度為了太平洋海上一處名叫『哈夫曼島』的島嶼","x":0.14749158209730978},{"y":0.04646381561999202,"conf":0.5,"w":0.04852320869099838,"h":0.013157894736842146,"text":"160","x":0.1561181423844586}]