[{"h":0.028570540341179007,"text":"雷霆任務4","x":0.7195606783912836,"y":0.9312089159989374,"w":0.15111218965970552,"conf":0.5},{"h":0.027781029656566147,"text":"劇情提要","x":0.39465123869291474,"y":0.8887257642644046,"w":0.17460410411541272,"conf":1},{"h":0.027702604245238294,"text":"為了查出到底是誰率領不知名的機甲軍團攻擊德國的軍事基地，隸屬於『","x":0.12291121240617614,"y":0.8140074491746166,"w":0.7267015897310698,"conf":1},{"h":0.024178925751660252,"text":"迪蘭達爾』研究機構愛爾莎、吉德、以及哈米茲三人一起駕駛著運輸機來","x":0.10182357542892963,"y":0.7831325134957778,"w":0.7475360723642203,"conf":1},{"h":0.020450006671488663,"text":"到德國境內的陸軍基地進行調查。但是，當地的調查小組-一也就是德國特","x":0.10181643907970703,"y":0.756076101990917,"w":0.745407984806941,"conf":0.5},{"h":0.02185277539192898,"text":"殊部隊・『布拉尼貝爾』部隊瓦古納小隊長（ヴァグナー）卻對愛爾沙ー","x":0.10183930388256336,"y":0.7225965472467265,"w":0.745346216055063,"conf":1},{"h":0.02044361148981544,"text":"行人擺出了一副不是很友善的態度。愛爾莎雖然覺得很不悅，但是吉德倒也","x":0.10182172777135158,"y":0.6942157668720965,"w":0.747512964101938,"conf":1},{"h":0.0203488364803468,"text":"表示：『德國人有德國人的作法。更何況，現在是他們的同袍弟兄被殺、心","x":0.10191083944751365,"y":0.6642441865563382,"w":0.7452228986299955,"conf":1},{"h":0.018924012572038462,"text":"情上比較憤怒也是可以理解的，我們只要按照我們自己的方式去調查就可以","x":0.10191084358031503,"y":0.6322674417540288,"w":0.7452228986299955,"conf":1},{"h":0.021057662556381085,"text":"了。』","x":0.102084147571701,"y":0.5977779550371796,"w":0.06380133903943574,"conf":0.5},{"h":0.02642894045877564,"text":"於是乎，雙方就在『各查各的』的狀態之下展開了搜尋行動。可惜的是，","x":0.12300145128666398,"y":0.5356430358626099,"w":0.7221535169161283,"conf":1},{"h":0.020972530079749974,"text":"神祕軍隊的保密工作實在作得很到家，雖然哈米茲已經找到不少敵軍機甲","x":0.10180907013363352,"y":0.507788589689032,"w":0.74541502732497,"conf":1},{"h":0.020976054834947355,"text":"殘骸跟子彈樣本，但眾人還是查不出這些敵軍的來歷。最後，根據愛爾莎","x":0.10181285405514455,"y":0.4764957831934681,"w":0.7454090118408203,"conf":1},{"h":0.020322433728709455,"text":"推測，眾人認為這些敵軍很有可能是在別的地方建立了前進據點、然後再從","x":0.10182239939718797,"y":0.4458417825431542,"w":0.7453884711632363,"conf":1},{"h":0.024894769209373502,"text":"這些據點採『陸路移動』的方式進入德國境內發動攻擊、等攻擊行動結束再","x":0.1018204872169794,"y":0.411491161338732,"w":0.7453907453096831,"conf":1},{"h":0.017454997574391617,"text":"回到據點搭乘運輸機逃到國外。","x":0.10191083274584595,"y":0.38517441881964887,"w":0.3163481859060434,"conf":1},{"h":0.018959842359030366,"text":"也就是說，只要找出目前續航距離最長的雷霆機甲資料加以比對，要找出","x":0.1231422337709142,"y":0.32122093012631237,"w":0.7239915407620944,"conf":1},{"h":0.020384323822247197,"text":"敵軍的前進據點應該不是什麼難事，經過哈米茲的電腦分析，愛爾莎認為敵","x":0.10183200645837133,"y":0.29038262186744235,"w":0.7453761467566857,"conf":1},{"h":0.02752079332864177,"text":"軍的基地也許就位在丹麥的山區地帶也說不定。由於『布拉尼貝爾』部隊對","x":0.10177202968096812,"y":0.25687013179399354,"w":0.745505846463717,"conf":1},{"h":0.02074926371641006,"text":"愛爾莎眾人並不友善，因此眾人也沒有把這項消息告訴給瓦古納小隊長知道","x":0.101829859376104,"y":0.22784868146610693,"w":0.7453865638146033,"conf":1},{"h":0.025183010806582806,"text":"（只不過瓦古納小隊長也有叫部下追蹤『迪蘭達爾』運輸機的航向就是了⋯","x":0.11029220749277797,"y":0.19547537936356918,"w":0.7390601818378155,"conf":0.5},{"h":0.020232461570420135,"text":"⋯⋯）。就在眾人抵達丹麥山區時，想不到在那裡等著他們的竟然是神秘敵","x":0.09971151460224933,"y":0.1659778572921664,"w":0.7475037207970253,"conf":0.5},{"h":0.016023007395234212,"text":"軍的埋伏部隊・………","x":0.10191082957421482,"y":0.13516844710526488,"w":0.2059447948749249,"conf":1},{"h":0.01453488364803468,"text":"051","x":0.7940552017132834,"y":0.04796511638158518,"w":0.046709129443535446,"conf":1}]