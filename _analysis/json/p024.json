[{"w":0.5910518163712896,"h":0.022324493841121007,"text":"Movement Sys Damaged","y":0.897853158159689,"x":0.22557752940654244,"conf":0.30000001192092896},{"w":0.7218449485614932,"h":0.022991839208100995,"text":"移動系統受損。當陷入這種狀態時，該機體的移動能力將會減半，同時該","y":0.8521455500381068,"x":0.18549439945614324,"conf":1},{"w":0.7408933798851431,"h":0.023178075489244998,"text":"機體在戰鬥中將無法迴避敵方攻擊。如果機體移動能力減半後移動格數帶","y":0.8243340355556231,"x":0.1643562456951879,"conf":1},{"w":0.7408928700449358,"h":0.023203953316337178,"text":"有小數點的話，小數點部分將會自動捨棄（如原本移動力5格機體在移動","y":0.7963964379019366,"x":0.16437121183421838,"conf":1},{"w":0.7324219478343155,"h":0.021743085823560993,"text":"力減半成2•5格之後，0•5的部分將被自動忽略，變為只能移動2格）","y":0.768569597251707,"x":0.16229378964065067,"conf":0.5},{"w":0.7411587881302207,"h":0.030060887336731068,"text":"。但是，如果機體因為腳部被破壞而只能移動一格的話，「移動力減半」","y":0.7378696574062171,"x":0.16423057227182955,"conf":1},{"w":0.33790271549634543,"h":0.020559378360447078,"text":"效果就不會對機體造成任何影響。","y":0.7152781889291444,"x":0.16225755409738948,"conf":1},{"w":0.23286059249841512,"h":0.02188623735779205,"text":"Movement","y":0.6309924300619707,"x":0.22110759322002155,"conf":0.5},{"w":0.23079351821207483,"h":0.022877868853117267,"text":"Sys Down","y":0.6284844822865847,"x":0.4911348541178563,"conf":0.30000001192092896},{"w":0.7219116647943392,"h":0.023515548360975136,"text":"移動系統故障。當陷入這種狀態時，機體就會完全無法移動。同時該機體","y":0.5835896153279004,"x":0.18125016617102988,"conf":1},{"w":0.3126076855352215,"h":0.020534640080050348,"text":"在戰鬥中將無法迴避敵方攻擊。","y":0.5581895408545292,"x":0.16014461996180596,"conf":1},{"w":0.3212098551820741,"h":0.022291410126184186,"text":"BP Sys Down","y":0.4737193094758486,"x":0.21915631148823844,"conf":0.30000001192092896},{"w":0.7198235049737097,"h":0.023421254597212116,"text":"背包系統故障。當陷入這種狀態時，該機體將完全無法使用所有背包關聯","y":0.42688291640622633,"x":0.17912286114291276,"conf":1},{"w":0.08860759689585976,"h":0.017441860939327092,"text":"的機能。","y":0.40406976723590127,"x":0.15611814233718163,"conf":0.5},{"w":0.3252980817189365,"h":0.02187454308334147,"text":"MS Sys Down","y":0.3154806735921425,"x":0.2129226169200629,"conf":0.30000001192092896},{"w":0.7218547811940632,"h":0.023085428695929777,"text":"誘導系統故障。當陷入這種狀態時，該機體將完全無法發射飛彈進行攻擊","y":0.26849162272731686,"x":0.1749501409730807,"conf":1},{"w":0.3758529262497203,"h":0.02015895906247589,"text":"，但飛彈之外的攻擊則完全不受影響。","y":0.24321717953410404,"x":0.15806920909990024,"conf":1},{"w":0.23051931522342073,"h":0.02062972752671488,"text":"Link Cut","y":0.16412364376229682,"x":0.2128291218950218,"conf":0.30000001192092896},{"w":0.7198318809199731,"h":0.0234635848748056,"text":"聯繫中斷。當陷入這種狀態時，該機體將無法與其他僚機進行聯合攻擊或","y":0.11620398685247135,"x":0.17278484692468007,"conf":1},{"w":0.1799454427277558,"h":0.01996672545608713,"text":"聯合防禦的動作。","y":0.09262153256804972,"x":0.14949797127406744,"conf":1},{"w":0.05063290926038791,"h":0.014534884377529811,"text":"024","y":0.05668604621966533,"x":0.15611814442043895,"conf":1}]