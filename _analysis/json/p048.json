[{"y":0.8989245821295274,"conf":1,"w":0.736542185052767,"x":0.15387882560434948,"h":0.020057831939898074,"text":"駛員的萊多娜（ラトーナ）好像對愛爾莎很有意見，在未經許可的情況下，"},{"y":0.8631202007060044,"conf":1,"w":0.7411669455735382,"x":0.1516106754482102,"h":0.03178746763028595,"text":"萊多娜自作主張的將測試科目改為『戰鬥訓練』，吉德見狀簡直快要氣瘋了"},{"y":0.83702885062227,"conf":1,"w":0.7407375144503281,"x":0.15389550951715572,"h":0.021328957457291464,"text":"，戰鬥結束之後，生氣的吉德立刻就把萊多娜跟貝克罰去掃廁所，至於愛爾"},{"y":0.8034240071626023,"conf":0.5,"w":0.742876512623061,"x":0.15176641174063957,"h":0.02635613554402394,"text":"莎也從吉德口中得知了許多有關『駕駛員能力設定』、『技能買』、『技"},{"y":0.7731053704486206,"conf":1,"w":0.4941080680610456,"x":0.15166435810873452,"h":0.025828002314818632,"text":"能裝備』、『訓練教學模式』等等的遊戲小情報。"},{"y":0.7126657919189666,"conf":0.5,"w":0.7175472141165722,"x":0.17286943405840327,"h":0.02041194940868174,"text":"另一方面，就在數天之前，歐聯（EC）會員國之一的德國境內竟然發生"},{"y":0.681686046985136,"conf":1,"w":0.7405063383334576,"x":0.15189873359346798,"h":0.02185013733412089,"text":"了多起的軍事基地攻擊事件，由於歐聯地區一直以來都是屬於『較為和平穩"},{"y":0.6511627905662982,"conf":0.5,"w":0.7362869007775209,"x":0.14978903854282488,"h":0.020348837501124373,"text":"定』的區域，因此這次的攻擊立刻驚動了歐洲各國的領導者。在法國首都•"},{"y":0.6188693006220103,"conf":1,"w":0.740842104527148,"x":0.14962123008681652,"h":0.02244674375182698,"text":"巴黎的歐聯最高議會會議室裡頭，包括英國首相、德國總理、法國總統、義"},{"y":0.5878836532157921,"conf":1,"w":0.7450225028900657,"x":0.14752670769620935,"h":0.022560172959377844,"text":"大利總理、比利時總理等等人物在內，各國的最高政治領導人們紛紛齊聚一"},{"y":0.5583754225533775,"conf":1,"w":0.42645096152949724,"x":0.14753001877507585,"h":0.02051545444287739,"text":"堂聽取德國方面報告此次的襲擊事件始末。"},{"y":0.49110741183694506,"conf":0.5,"w":0.7349589127060338,"x":0.1473682551031169,"h":0.031028355422772935,"text":"會議結束後，雖然德國總理方面是希望由德國特殊部隊。『布拉尼貝爾』"},{"y":0.4594525960349014,"conf":0.5,"w":0.7370073778248061,"x":0.1515775602307093,"h":0.033399770134373674,"text":"（BLAUERNEBEL）獨力進行此次事件調查，但是『布拉尼貝爾』部隊指揮"},{"y":0.43171385583370747,"conf":1,"w":0.7409073640736874,"x":0.14539706736340613,"h":0.025832566775773724,"text":"官ーー葛雷薩准將（グレーザー）一番『希望歐聯能夠重新檢討各國軍力配"},{"y":0.39888036378305525,"conf":1,"w":0.7408176321971958,"x":0.14541083322366694,"h":0.024269892981177876,"text":"置以及高階軍官人事佈局』的一番談話卻引起了歐聯各會員國的戒心，由於"},{"y":0.37022296180978953,"conf":1,"w":0.7408056873694808,"x":0.14542459000245275,"h":0.02209672174955668,"text":"各國領導者的心裡頭都擔心德國可能會隱瞞事件調查真相、甚至可能會藉"},{"y":0.3389848215804422,"conf":1,"w":0.740809401919563,"x":0.14542203335413822,"h":0.021967889446961264,"text":"此機會擴張軍力、打破歐聯各會員國之間的軍事平衡，因此在英國首相的提"},{"y":0.3039132230826497,"conf":0.5,"w":0.7433522663708234,"x":0.1431054302877191,"h":0.03137044216457163,"text":"議之下，歐聯議會最後是作出了『讓戰術研究機構•『迪蘭達爾』與德國的"},{"y":0.2714546069788202,"conf":0.5,"w":0.5325433189373882,"x":0.1471376483297604,"h":0.03107053668875437,"text":"『布拉尼貝爾』部隊一起參與調查工作』的最終決議⋯"},{"y":0.04646381606118599,"conf":0.5,"w":0.052742614381922154,"x":0.1434599163322457,"h":0.014582695929627687,"text":"048"}]