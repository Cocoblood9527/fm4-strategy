[{"y":0.8906279318834811,"w":0.1985099446517471,"h":0.02688367115823842,"text":"劇情提要","conf":0.30000001192092896,"x":0.4345003018368898},{"y":0.810696844148838,"w":0.7201717258353222,"h":0.033934157145650734,"text":"突破薩夫特拉共和國的『長城要塞』之後，眾人終於來到此行的最終目","conf":1,"x":0.18734192177179548},{"y":0.7869993305747617,"w":0.7407489494378355,"h":0.021284707282718807,"text":"地一一薩國資源工業基地。但是，當愛爾莎他們來到現場時，陰謀家葛雷薩","conf":0.5,"x":0.16443872315826424},{"y":0.7572674420658643,"w":0.7426160571114261,"h":0.01904834728491933,"text":"准將早就率領著大批部隊出來迎擊了。仇人相見分外眼紅，看到之前一直陷","conf":1,"x":0.16244724552049214},{"y":0.7243838487466483,"w":0.7408287758474418,"h":0.02267614634413473,"text":"害自己的傢伙如今就站在自己面前，迪蘭達爾眾人立刻就朝葛雷薩發動攻擊","conf":1,"x":0.16439851114989168},{"y":0.6938389423586278,"w":0.7407499691182503,"h":0.02134991946973308,"text":"。葛雷薩雖然有強力精銳的薩國軍隊助陣，但是最後的勝利還是被愛爾莎他","conf":1,"x":0.16443169541155056},{"y":0.6656976742038607,"w":0.11392404924998134,"h":0.01744186093932698,"text":"們所拿下。","conf":1,"x":0.1603375533042531},{"y":0.5996471905707912,"w":0.7197209542577194,"h":0.022611715291675827,"text":"令愛爾莎覺得不解的是，為什麼葛雷薩要陰謀設計這一切呢？葛雷薩表示","conf":1,"x":0.18339352768789557},{"y":0.5692669463596041,"w":0.7386279413409905,"h":0.02125297722063557,"text":"，原本他的所作所為都是為了要清除那些沒有軍人自覺跟榮譽心的將官。但","conf":1,"x":0.16443506169108837},{"y":0.5340714621822892,"w":0.7410694932596211,"h":0.031081816083506575,"text":"是隨著計劃的進行，葛雷薩的心裡竟然開始『享受』起這種『在幕後掌握一","conf":1,"x":0.16005972295277174},{"y":0.5048039133972535,"w":0.7407686147029758,"h":0.02671481119958985,"text":"切』的感覺。他一手指揮著『薩夫特拉共和國』的部隊執行作戰、一方面又","conf":1,"x":0.16021163254560764},{"y":0.47077311129150035,"w":0.5832344364721621,"h":0.03293666400407491,"text":"挑起US N跟歐聯的戰爭，這種『快樂』就是他所追求的。","conf":0.5,"x":0.15986999061278273},{"y":0.41358215137969323,"w":0.7175328657564514,"h":0.02134179912115397,"text":"聽到葛雷薩這番喪心病狂的話語，愛爾莎痛斥葛雷薩不應該為了這種理由","conf":1,"x":0.1813224814486387},{"y":0.38294305620957847,"w":0.7407171208420347,"h":0.022655099630355835,"text":"而害死許多無辜的生命。雖然葛雷薩強調——『軍人工作就是戰爭、就是","conf":0.5,"x":0.1581398779342554},{"y":0.3486687545587651,"w":0.7407716009099046,"h":0.024187037819310198,"text":"有效率的破壞、殺人、以及鎮壓』但是吉德嚴詞反駁：『不！保護祖國與","conf":0.5,"x":0.15808592409204805},{"y":0.31825657926079,"w":0.7383966195554893,"h":0.0234375,"text":"人民的生命財產安全才是軍人的工作。像你這種傢伙沒有資格稱為軍人』！","conf":1,"x":0.1561181458135824},{"y":0.2890417594259107,"w":0.719695170910091,"h":0.02208549882236288,"text":"就在眾人準備把葛雷薩抓回去治罪的時候，想不到葛雷薩竟然使用自爆","conf":1,"x":0.17919600644805364},{"y":0.2615131579594463,"w":0.24894514061101583,"h":0.016103121010880628,"text":"方式來了結自己的生命…","conf":0.5,"x":0.15611814684375372},{"y":0.04934210493298741,"w":0.04641350356946414,"h":0.014802631578947345,"text":"120","conf":1,"x":0.16244725655362438}]