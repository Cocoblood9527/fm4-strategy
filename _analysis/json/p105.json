[{"conf":0.30000001192092896,"x":0.723771287416915,"h":0.030152809061569252,"text":"雪霆任務4","y":0.9325980142598391,"w":0.1511835410044743},{"conf":1,"x":0.3948237944723298,"h":0.028053047035988432,"text":"劇情提要","y":0.8907699889490168,"w":0.15939699686490577},{"conf":0.5,"x":0.12526539114117247,"h":0.018959842359030366,"text":"US N合眾國不愧為當今地球上軍力最強的國家，瓦古納所發射的巡弋飛","y":0.8212209301271678,"w":0.7218683682955229},{"conf":0.5,"x":0.10191082846290787,"h":0.017441860064190684,"text":"彈完全傷不到US N大西洋艦隊一根寒毛。不過，這次飛彈攻擊卻讓 USN","y":0.79069767462161,"w":0.747346071096567},{"conf":0.5,"x":0.09970960627705348,"h":0.0222574592910052,"text":"大西洋艦隊總司令•麥迪遜中將起了疑心，因為U S N艦隊早就收到歐聯『","y":0.7583151391709406,"w":0.7475282228910006},{"conf":1,"x":0.09978770132225169,"h":0.0203488364803468,"text":"梅卡佛洛特基地』被人攻擊的消息，照理說該基地應該是沒有那個能力發射","y":0.7267441864139299,"w":0.7452228986299955},{"conf":1,"x":0.0997877013219448,"h":0.017441860064190795,"text":"巡弋飛彈才是。聰明的麥迪遜中將立刻就懷疑這其中一定有人在搞鬼。可惜","y":0.6991279071797347,"w":0.7452228986299955},{"conf":0.5,"x":0.09965277166891241,"h":0.02742094198209688,"text":"白是，USN軍方高層已經明確的下達了『馬迪拉島登陸作戰』的計劃，麥","y":0.663589413941419,"w":0.74553709763747},{"conf":1,"x":0.0997876841076689,"h":0.017441860064190573,"text":"迪遜上將雖然發現了多項疑點，但是他現在也只能依照上面的命令行事。","y":0.6366279071798904,"w":0.7218683682955228},{"conf":1,"x":0.1229088329500284,"h":0.02859647526737108,"text":"至於在『梅卡佛洛特基地』方面，受到剛才激烈的爆炸與戰鬥的影響，基","y":0.567951661917279,"w":0.7222959811870868},{"conf":1,"x":0.09978770132194494,"h":0.017666392769104422,"text":"地的各項設施幾乎全部癱瘓、就連該基地的最高指揮官也戰死了，預計該基","y":0.543549712045595,"w":0.7452228986299955},{"conf":0.5,"x":0.09978767976209954,"h":0.017441860064190795,"text":"地需要10小時左右的時間才能完全恢復機能，現階段要該基地收容歐聯各","y":0.5130813955537494,"w":0.7430997995229868},{"conf":1,"x":0.09978767975018386,"h":0.017445443591428966,"text":"會員國的聯合部隊已經是不可能的事情。更糟糕的是，剛才從基地裡頭發射","y":0.48110106783852125,"w":0.7430997995229867},{"conf":0.5,"x":0.09964844996277342,"h":0.0252787167651789,"text":"的巡弋飛彈已經被US N艦隊視為『敵方那邊先發射的第一發子彈』，USN","y":0.4472566876513979,"w":0.7455127422626202},{"conf":0.5,"x":0.09325595965776476,"h":0.026220986171148875,"text":"勢必會以『合理的反擊』為由、然後派出大軍登陸佔領戰略要地•位於西班","y":0.4132821803115666,"w":0.7518842403705304},{"conf":1,"x":0.09729705553024931,"h":0.025653399496462392,"text":"牙西南方的『馬迪拉島』。","y":0.3845623957612806,"w":0.27253013390761155},{"conf":0.5,"x":0.12086265607159132,"h":0.02600582721493916,"text":"以『馬迪拉島』的防衛隊兵力，要他們阻擋精銳U S N機甲軍團無疑是","y":0.32012654827915765,"w":0.7221596057598407},{"conf":0.5,"x":0.09960609216090187,"h":0.02849040035351247,"text":"自白的送死，擔心島上防衛隊安全吉德立刻就向『梅卡佛洛特基地』軍官","y":0.29025819173536493,"w":0.743503057039701},{"conf":1,"x":0.09747378402787756,"h":0.02874609791262772,"text":"表明身份、然後駕駛基地的運輸機前往『馬迪拉島』運送島上防衛隊與平","y":0.2586360331204661,"w":0.745636353125939},{"conf":0.5,"x":0.09749116332775308,"h":0.027318915286412948,"text":"民們撤退。當迪蘭達爾眾人火速趕到『馬迪拉島』時，US N部隊的閃電作","y":0.22796809850012278,"w":0.74559813279372},{"conf":1,"x":0.0976645594881791,"h":0.018983728883691597,"text":"戰已經快了一步，島上的海岸線已經陷入交戰的狀態。為了爭取時間讓防衛","y":0.20049301544668963,"w":0.7452228986299955},{"conf":1,"x":0.09766455907141416,"h":0.017441860064190684,"text":"隊與平民們能夠撤退到運輸機上，愛爾莎一行人隨即跳進戰圈之內試圖拖延","y":0.17005813973785977,"w":0.7452228986299955},{"conf":0.5,"x":0.09978768139796615,"h":0.016175880526164255,"text":"USN的機甲部隊前進。","y":0.139534883458992,"w":0.24416136741638186},{"conf":1,"x":0.7940552025658115,"h":0.014790468364831555,"text":"105","y":0.049301561378279235,"w":0.0488322698152982}]