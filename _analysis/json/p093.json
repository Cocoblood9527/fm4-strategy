[{"x":0.7026027191637687,"text":"雷霆任務4","conf":0.5,"y":0.941396401644435,"w":0.14468840452340936,"h":0.024183941749441162},{"x":0.38216560385212706,"text":"劇情提要","conf":1,"y":0.8952341822907495,"w":0.15286624431610107,"h":0.0262941659819228},{"x":0.10393885171444547,"text":"迪亞茲州長被『委內瑞拉公正軍』游擊隊逮捕的消息很快就傳遍全國，聽","conf":0.5,"y":0.8203533522398295,"w":0.7242024495051457,"h":0.025626576720639727},{"x":0.08255173488976525,"text":"到委內瑞拉獨立軍竟然連一個小小的游擊隊都打不過，伊凡諾娃簡直快要氣","conf":1,"y":0.7912486412302884,"w":0.745712426992563,"h":0.02431251224966058},{"x":0.08252270928434058,"text":"炸了。不過聽伊凡諾娃講話的口氣，她之前攻擊U S N部隊的行為好像不是","conf":0.5,"y":0.760015826934111,"w":0.745757689842811,"h":0.024977680102860056},{"x":0.08255523283023805,"text":"為了幫助迪亞茲。那麼，伊凡諾娃他們來委內瑞拉的真正目到底是什麼呢","conf":1,"y":0.7288201118505504,"w":0.7478385338416467,"h":0.025036734249519355},{"x":0.08658116117798823,"text":"？就在這個時候，憤怒伊凡諾娃竟然向瓦維洛夫下達了『打倒所有的游","conf":1,"y":0.6960556524152856,"w":0.7418062503521259,"h":0.0294843656466256},{"x":0.08492569558396035,"text":"擊隊、被抓迪亞茲州長可以一併殺掉沒關係！』的命令⋯","conf":0.5,"y":0.6684470011177618,"w":0.5817409662099985,"h":0.021959975594463388},{"x":0.10592132391630618,"text":"於是乎，就在達利爾一行人準備回游擊隊祕密基地暫作休息時，伊凡諾娃","conf":1,"y":0.6056307302064436,"w":0.7244456364558294,"h":0.02388223351860208},{"x":0.08673655598186507,"text":"早就已經占領了卡拉卡斯市內的游擊隊基地、並且炸毀了橋樑、佈下了天羅","conf":1,"y":0.573985182382789,"w":0.7436686295729418,"h":0.02519086040036056},{"x":0.08470545897965708,"text":"地網準備消滅達利爾一行人。為了脫困，眾人只好用硬闖的方式強行突破。","conf":1,"y":0.5433280856102265,"w":0.7435402503380408,"h":0.023808945567272755},{"x":0.0846623993999285,"text":"但是，敵方的部隊實在是太多、太精良了，就在眾人即將被敵方大軍殲滅之","conf":1,"y":0.5115646155136798,"w":0.7457710412832408,"h":0.02511945393796622},{"x":0.08692586573079801,"text":"際，路易斯的游擊隊戰友•卡波最後是以一記『自我犧牲』的自殺式攻擊、","conf":0.5,"y":0.4810549334327654,"w":0.7433095345130335,"h":0.0255049938242653},{"x":0.08678019539304713,"text":"用自己的生命幫達利爾一行人打開了一條血路…","conf":1,"y":0.4495333114814183,"w":0.47396938617412854,"h":0.022536751865459004},{"x":0.3566135650529424,"text":"4）","conf":0.30000001192092896,"y":0.19080939821975218,"w":0.2411818320934589,"h":0.1357513151897597},{"x":0.2227964921836247,"text":"雷霆任務","conf":1,"y":0.11156928080342654,"w":0.48009703709528995,"h":0.0864544620059412},{"x":0.7855626318014833,"text":"093","conf":1,"y":0.055053409749602045,"w":0.055201700100531936,"h":0.016167520791071754}]