[{"x":0.7067982905511199,"y":0.9412092686261159,"w":0.14266668833219087,"text":"雷霆任務4","h":0.023104718599343044,"conf":0.5},{"x":0.1953290795407957,"y":0.9009860311107307,"w":0.5371550046480619,"text":"Set Links／設定聯合作戰選項","h":0.02197908512764324,"conf":0.30000001192092896},{"x":0.10590078179637318,"y":0.8499260175599301,"w":0.7202692765455979,"text":"選擇本指令後，遊戲會詢問玩家是要設定「A t tack Links（","h":0.02627063208950675,"conf":0.5},{"x":0.08465946551041817,"y":0.8188422426050017,"w":0.7351650824913613,"text":"聯合攻擊，同伴會在本角色攻擊時發動輔助攻擊行動）」或是「De fe-","h":0.028221070815425575,"conf":0.5},{"x":0.08684792506440758,"y":0.7951045172366178,"w":0.7329166852510893,"text":"nse Links（聯合防禦，同伴會在本角色被攻擊時發動反擊動作）","h":0.022612485517315317,"conf":0.5},{"x":0.08454377571752122,"y":0.76582110156682,"w":0.7459140190711389,"text":"」。選擇一樣並按鈕決定後，接著遊戲會讓玩家選擇「要跟哪位角色進行聯","h":0.028490569616990036,"conf":1},{"x":0.08681000090786561,"y":0.7377821522424483,"w":0.4505934715270996,"text":"合作戰」，請以游標選擇角色，並按鈕決定。","h":0.02379986489514596,"conf":1},{"x":0.1080618396865382,"y":0.6844698832029998,"w":0.7223053712111254,"text":"按下決定鈕之後，這時遊戲還會再次跳出選單詢問玩家要讓這個角色進行","h":0.02348838404935205,"conf":1},{"x":0.0867126853761132,"y":0.65620194670188,"w":0.27237752767709583,"text":"何種程度的聯合攻擊。其中","h":0.021917292203879724,"conf":1},{"x":0.1167001248942072,"y":0.6260296855669034,"w":0.6222597268911508,"text":"「Link：1」代表僚機會參加聯合作戰，並會發動支援攻擊","h":0.023833730128718478,"conf":0.5},{"x":0.11669500300534871,"y":0.5984182597473493,"w":0.6923317542442908,"text":"「Link：2」代表僚機不但會參加聯合作戰，而且還可能會發動戰","h":0.025398749646928898,"conf":0.5},{"x":0.2887473458102769,"y":0.5739523417985559,"w":0.07218683682955229,"text":"鬥技能","h":0.01766639276910431,"conf":1},{"x":0.11464968928802105,"y":0.5421511628520572,"w":0.3545647401076097,"text":"「Unlink」代表取消聯合作戰","h":0.0219408668449107,"conf":0.5},{"x":0.110195849722448,"y":0.488730355921821,"w":0.7223033171433669,"text":"因為僚機參加聯合作戰或發動技能雖然能使攻擊威力倍增，但他們每次發","h":0.024145117722874088,"conf":1},{"x":0.08683279859095538,"y":0.46045033310267836,"w":0.7477752978985126,"text":"動攻擊還是都會消耗它們自身的AP點數。所以如何讓僚機們在最不消耗AP","h":0.024050352900559124,"conf":1},{"x":0.08682836623926048,"y":0.432478010765442,"w":0.6098052905156062,"text":"點數的狀況下協助駕駛員進攻，這就得看玩家戰略頭腦了。","h":0.0231901457198056,"conf":1},{"x":0.10383859101284426,"y":0.3309017498542718,"w":0.7350895221416767,"text":"SSet Support Actions／設定聯合作戰時的行動方針=","h":0.028526829615321048,"conf":0.30000001192092896},{"x":0.11225893295757043,"y":0.2836852346144656,"w":0.720268176152156,"text":"在這裡，玩家可以設定當本駕駛員必須支援其他駕駛員進行聯合攻擊時，","h":0.02487143279101478,"conf":1},{"x":0.08882880428188972,"y":0.25389319848827363,"w":0.7415900597205529,"text":"本駕駛員會採取什麼樣的行動。基本上可以設定項目分為「A t tack","h":0.028426077097482905,"conf":0.5},{"x":0.11437246798594664,"y":0.22711038215481094,"w":0.7117719650268555,"text":"Links（聯合攻擊）」「Defense Links（聯合防禦）","h":0.025671156489075253,"conf":0.30000001192092896},{"x":0.09092351195654719,"y":0.19898184385140683,"w":0.7438715421236477,"text":"」兩大項。而在這兩個項目的設定中，一般狀況下玩家可以設定機體利用「","h":0.02654931030022678,"conf":1},{"x":0.09313710823879351,"y":0.17046729907744307,"w":0.7415377543522761,"text":"Left Hand（左臂武器）」或「Right Hand（右臂武器","h":0.026845866182150124,"conf":0.30000001192092896},{"x":0.09103071341987833,"y":0.14209975006570852,"w":0.7457751494187576,"text":"）」來參加作戰。但如果該駕駛員搭乘的機體裝備了具有特殊機能的背包時","h":0.027009711661295732,"conf":1},{"x":0.0953004286883424,"y":0.11518245327836507,"w":0.7329161717341496,"text":"，玩家就可以額外選用「Antilock（解除飛彈鎖定）」或是「S-","h":0.026161756491994148,"conf":0.30000001192092896},{"x":0.09529466959489377,"y":0.08637947277211522,"w":0.4675904787503756,"text":"alvage（救助行動）」來加入作戰行列。","h":0.02313326613865818,"conf":0.30000001192092896},{"x":0.787685774461117,"y":0.05668604649579845,"w":0.05095541477203369,"text":"037","h":0.013157831613608062,"conf":1}]