y":0.3997093025437152},{"w":0.0106157110287593,"h":0.0101744182401734,"text":"1","conf":0.5,"x":0.4140127388327542,"y":0.40406976775127956},{"w":0.012738853693008423,"h":0.011627906448251402,"text":"3","conf":0.5,"x":0.46496815268640457,"y":0.4026162794502929},{"w":0.13588110300210804,"h":0.011627907231878676,"text":"Prodezza","conf":0.30000001192092896,"x":0.12101910856922932,"y":0.3997093022180622},{"w":0.21483863317049468,"h":0.03626154677830662,"text":"劇情提要","conf":0.30000001192092896,"x":0.3772683557148552,"y":0.24322105612133016},{"w":0.7224363913902869,"h":0.02470841482220465,"text":"原本隸屬於法國裝甲師部隊•雷霆機甲駕駛員的愛爾莎（エルサ），今天","conf":1,"x":0.13134434015989233,"y":0.17623136835468567},{"w":0.7430997995229868,"h":0.021865624527316108,"text":"是他專任到非軍事單位一一『迪蘭達爾』（Durandal）的第一天。在直屬長","conf":0.5,"x":0.10828024881561173,"y":0.14534883726897452},{"w":0.7393798828125,"h":0.023395934061819945,"text":"官・吉徳（ジード）、以及電腦情報官・哈米茲（ハーミーズ）的指導下，","conf":1,"x":0.11012132115100666,"y":0.11429908158593227},{"w":0.7457679601816031,"h":0.025316490731282393,"text":"愛爾莎很快就展開了她第1天的機甲測試工作。然而，當天負責擔任靶機駕","conf":1,"x":0.11011637644439101,"y":0.08328167287070487},{"w":0.05307855514379656,"h":0.016136467995561343,"text":"047","conf":1,"x":0.8004246289085108,"y":0.05217748580250636}]