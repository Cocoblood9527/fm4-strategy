[{"x":0.2046413514600413,"text":"OCU簡略年表","conf":0.5,"w":0.20886075695829914,"y":0.88517441847869,"h":0.02034883750112426},{"x":0.25527426328474606,"text":"曼谷經濟帶成立","conf":1,"w":0.1244725703055079,"y":0.8415697671287012,"h":0.0145348843775297},{"x":0.15400844092477456,"text":"2005年","conf":1,"w":0.08649788722218077,"y":0.8429276312902672,"h":0.01317701998509857},{"x":0.15390394179409428,"text":"2021年","conf":0.5,"w":0.08670688529003207,"y":0.8208847084050349,"h":0.013753840013554286},{"x":0.25738396406631053,"text":"反OCU運動活潑化","conf":1,"w":0.15822785225005592,"y":0.8197674415422591,"h":0.0145348843775297},{"x":0.2572812158064637,"text":"OCU國防軍的前身一一『OCU共同準備隊』編成","conf":0.5,"w":0.4010552745445817,"y":0.7977525798980236,"h":0.018531612659755448},{"x":0.15398718715681098,"text":"2023年","conf":1,"w":0.08654039514946768,"y":0.7993515747030534,"h":0.013215455569718926},{"x":0.2551057124493212,"text":"泛太平洋共同連合（OCU）正式成立","conf":0.5,"w":0.2998993539013555,"y":0.7766572163057831,"h":0.01608952723051371},{"x":0.15393450944886888,"text":"2026年","conf":1,"w":0.08664574998659849,"y":0.7773801828436507,"h":0.013553588013899942},{"x":0.25527426792747704,"text":"大韓民國加盟，之後東南亞諸國也陸續加入OCU","conf":0.5,"w":0.3839662319720502,"y":0.7557565789899023,"h":0.014592258553755899},{"x":0.15391985154315568,"text":"2028年","conf":1,"w":0.08667506579852047,"y":0.755530037082642,"h":0.013649228372071831},{"x":0.25738397151648107,"text":"OCU勢力進駐哈夫曼島","conf":0.5,"w":0.19198311598602513,"y":0.7339638154239936,"h":0.014582695929627576},{"x":0.15398130751317354,"text":"2068年","conf":1,"w":0.08866185846078367,"y":0.7339238366675518,"h":0.01325697883179311},{"x":0.25738397913559063,"text":"USN合眾國宣稱擁有太平洋中央海域•『哈夫曼島』的主權，『第一次哈夫曼紛爭』爆發","conf":0.5,"w":0.6265822526663186,"y":0.7121710527277697,"h":0.016036184210526327},{"x":0.1538626422078383,"text":"2070年","conf":1,"w":0.08889918907729993,"y":0.7117232532348872,"h":0.014053493738174438},{"x":0.2572729238366631,"text":"第二次哈夫曼紛爭』爆發，薩夫特拉共和國與O CU、US N等3國利用士兵人腦","conf":0.5,"w":0.6289139704374255,"y":0.6883066405782033,"h":0.01874441849557973},{"x":0.1539104757830037,"text":"2090年","conf":1,"w":0.08880352120410853,"y":0.6799099974766409,"h":0.013726516773826192},{"x":0.2572415402476062,"text":"作為雷霆機甲電腦輔助系統的軍事研究醜聞曝光、全球輿論一片嘩然。","conf":1,"w":0.5424436145864409,"y":0.6671821578764194,"h":0.01790542665280792},{"x":0.2573839665515999,"text":"前孟加拉共和國加盟OCU、隔年並改名為『亞羅爾迪修人民共和國』","conf":0.5,"w":0.5379746830833271,"y":0.6467927630758891,"h":0.016036184210526327},{"x":0.15606680634886508,"text":"2094年","conf":1,"w":0.08660056539822308,"y":0.6466392552415969,"h":0.013407537027409155},{"x":0.2551849624758665,"text":"亞羅爾迪修人民共和國發生軍事政變。澳洲發現極為大量的鐵礦礦脈","conf":1,"w":0.5255146982561718,"y":0.6239481490626673,"h":0.01709638928112245},{"x":0.15395255610153552,"text":"2102年","conf":1,"w":0.08871936115273996,"y":0.624817897727967,"h":0.013445600082999665},{"x":0.2552742593489503,"text":"菲律賓的民達那峨島被反政府組織攻佔","conf":1,"w":0.2995780635278378,"y":0.6031976740993892,"h":0.0145348843775297},{"x":0.15392211132964884,"text":"2106年","conf":1,"w":0.0887802506403593,"y":0.6029142450307954,"h":0.013648255090964456},{"x":0.2572951725923165,"text":"日本國防軍發動兵變、新型高出力能源裝置『MIDA S』在菲律賓巴坦加斯市外海爆炸","conf":0.5,"w":0.6288833071906699,"y":0.5791234597287,"h":0.020876349587189535},{"x":0.15398214055566933,"text":"2112年","conf":0.5,"w":0.0886601923758204,"y":0.5813102672562789,"h":0.013251558730476676},{"x":0.16666668207678623,"text":"新大陸合眾國 （United States of New Continent。簡稱USN上","conf":0.30000001192092896,"w":0.723628660944026,"y":0.43168604646053377,"h":0.023255814062921543},{"x":0.16666666525105908,"text":"受到歐盟進一步組合成為『歐洲聯合共同體』（European Community。簡","conf":0.5,"w":0.7172995774444362,"y":0.37645348839575565,"h":0.02034883750112426},{"x":0.1452866181336306,"text":"稱『EC』）、以及亞洲諸國成立『曼谷經濟帶』的影響，由美洲大陸各國","conf":0.5,"w":0.7410600976329431,"y":0.3407879146516771,"h":0.02994656876513835},{"x":0.14547028863982528,"text":"所組成的經濟合作組織•『NAF TA』不久便宣告崩壞。緊接著，經過美","conf":0.5,"w":0.7428318651877611,"y":0.31126926213612793,"h":0.024545387217873027},{"x":0.14544072485645465,"text":"國與加拿大兩國的強力運作主導，中南美洲各國幾乎都投入美加兩國的麾下","conf":1,"w":0.7428646406296615,"y":0.28230108265055254,"h":0.02208659052848816},{"x":0.14754904329683569,"text":"成為附屬州。西元2020年，新大陸合眾國正式成立，U S N成為實質上","conf":0.5,"w":0.7386308547136038,"y":0.25138525713377025,"h":0.020480628076352536},{"x":0.14556963159402478,"text":"超巨大國家，至於之前的美洲各國則是以『獨立自治州』形態聽從 U-","conf":0.5,"w":0.7468354218330474,"y":0.2208059208879195,"h":0.0234375},{"x":0.14964581213521835,"text":"SN中央政府、也就是舊美國政府體制的統一命令指揮。","conf":1,"w":0.5572423092789752,"y":0.18990286322087835,"h":0.02052647110662964},{"x":0.16864396324993497,"text":"跟OCU一樣，USN在統合之前也是面臨著許許多多的問題。首先，為","conf":0.5,"w":0.717549326311717,"y":0.1279345145993288,"h":0.02049480770763601},{"x":0.14767932018251392,"text":"了達成『美洲大陸單一國家』的政治目的，美國與加拿大兩大強國開始減少","conf":1,"w":0.7405063383334576,"y":0.09580592074655292,"h":0.0234375},{"x":0.14544199977213884,"text":"對南美洲各國的經濟援助與貨物進口。另一方面，美加也開始強力取締中南","conf":1,"w":0.7428683551797433,"y":0.06701918353328329,"h":0.02181081238545879},{"x":0.15400844008071382,"text":"162","conf":1,"w":0.048523204138853665,"y":0.03779069740668084,"h":0.014534884377529811}]