[{"conf":0.5,"y":0.9286687595928205,"x":0.7239517585652044,"text":"雷霆任務4","w":0.14657631287207973,"h":0.024929922726081855},{"conf":1,"y":0.8925409071304955,"x":0.15912425480589754,"text":"條。不過，如果敵人的動機是為了讓歐聯進口資源的話，那麼身為資","w":0.6774859795203576,"h":0.021208450455301175},{"conf":0.5,"y":0.8677074775715036,"x":0.15711252718118954,"text":"源出口大國的USN合眾國其實也有很大的嫌疑，只是USN合眾國","w":0.6751592342670147,"h":0.01766639276910431},{"conf":1,"y":0.8414184167902986,"x":0.1570407625690549,"text":"的經濟實力強大，就算不賺歐聯這筆錢也不會餓死，反觀位於俄羅斯","w":0.6795438619760367,"h":0.020217498208816242},{"conf":1,"y":0.8121484476536089,"x":0.1568764787408844,"text":"邊境地區的『薩夫特拉共和國』就比較有這個動機。","w":0.5185317259568435,"h":0.026160549706088387},{"conf":0.5,"y":0.7875924405242722,"x":0.11464967988213412,"text":"4•德國特殊部隊『布拉尼貝爾』的瓦古納小隊長有可能是『薩夫特拉共","w":0.7218683682955227,"h":0.023454071364641838},{"conf":0.30000001192092896,"y":0.7599111598307289,"x":0.156800606389753,"text":"和國』間諜。","w":0.15790972342857948,"h":0.02277289008937511},{"conf":1,"y":0.7102064061441405,"x":0.12305983301685461,"text":"聽完弗雷迪瑞克的情報之後，愛爾莎與萊多娜一起回到迪蘭達爾總部。此","w":0.7241518314068134,"h":0.020750439157227407},{"conf":0.5,"y":0.6835477526719608,"x":0.10179101135246597,"text":"時哈米茲急忙跑過來大喊：他發現了一件很奇怪事情，根據哈米茲『非法","w":0.7454371819129356,"h":0.023055057008440794},{"conf":1,"y":0.65552325587186,"x":0.1019108220041797,"text":"入侵』德國中央政府資料庫所得到的情報顯示，德國有部份的企業在歐聯資","w":0.7430997995229869,"h":0.021962364873831186},{"conf":1,"y":0.632267441908583,"x":0.09978770470127962,"text":"源危機出現之後反而增加了各種資源的國內出貨量，照理說，除非這些企業","w":0.7452228986299955,"h":0.018924012572038462},{"conf":1,"y":0.6059983562526616,"x":0.09978770132255675,"text":"有辦法確保資源的上游來源不會短缺，否則在歐聯全體都出現資源危機的情","w":0.7452228986299954,"h":0.01766639276910431},{"conf":1,"y":0.5799418606687972,"x":0.09978767127027478,"text":"況下，這些企業應該是會減少國內的出貨量、以避免原料耗盡才是。","w":0.6772824067335863,"h":0.017441860064190684},{"conf":1,"y":0.5260762488718803,"x":0.12307305422900464,"text":"看完哈米茲的分析，萊多娜發現這些出貨量增加的企業都是集中在德國西","w":0.7219976278451773,"h":0.019601511583038245},{"conf":1,"y":0.49709302300477387,"x":0.10191082202538496,"text":"南方一處名叫『巴沙市』的城鎮，而且這些企業增加出貨的項目剛好都是『","w":0.7430997995229868,"h":0.023449294373160345},{"conf":1,"y":0.4708299098354316,"x":0.09978770132225169,"text":"薩夫特拉共和國』所生產的貴重金屬，也就是說，這些德國企業很有可能已","w":0.7452228986299955,"h":0.020542317173377178},{"conf":1,"y":0.4447674416096057,"x":0.09978770131062667,"text":"經跟『薩夫特拉共和國』勾結、然後在『布拉尼貝爾』部隊的『護航』之下","w":0.7452228986299955,"h":0.02325581446375724},{"conf":0.5,"y":0.41999956765824553,"x":0.09969364123818138,"text":"利用巴沙市的工業管線將資源祕密走私進來德國了。","w":0.5182357934805064,"h":0.02031607302663352},{"conf":1,"y":0.3665843714313195,"x":0.12306881351828086,"text":"聽完萊多娜與哈米茲的解說，愛爾莎認為此事非同小可，如果不設法找出","w":0.7220001954298751,"h":0.020130049330147948},{"conf":0.5,"y":0.34141331177030276,"x":0.09978770132225169,"text":"葛雷薩准將說謊的證據的話，歐聯跟US N合眾國早晚一定會爆發戰爭。經","w":0.7452228986299955,"h":0.01766639276910431},{"conf":1,"y":0.3154069769471548,"x":0.09978770132286002,"text":"過愛爾莎的大力游說，英國事務次官總算是同意迪蘭達爾眾人前往巴沙市調","w":0.7452228986299956,"h":0.017441860064190795},{"conf":1,"y":0.28923582560740224,"x":0.09978770093977925,"text":"查。不過，英國事務次官也表示：『如果各位這次的行動還是失敗、沒有找","w":0.7452228986299955,"h":0.018903709574615513},{"conf":0.5,"y":0.25865679858129487,"x":0.09965432148964358,"text":"到強而有力的證據話，這次恐怕連英國首相諾蘭德也保不了你們了。』","w":0.7158186252300556,"h":0.024763973991500543},{"conf":1,"y":0.20836324449993227,"x":0.12306622367519769,"text":"另外在德國巴沙市方面，發現迪蘭達爾眾人來到巴沙市工業區調查葛雷","w":0.7220035699697641,"h":0.019975941202732606},{"conf":1,"y":0.17832295900175787,"x":0.09960518107738384,"text":"薩准將開始出現緊張表情。擔心『資源走私』一事曝光的葛雷薩准將立刻","w":0.743511199951172,"h":0.028957323060235463},{"conf":1,"y":0.1569433029204188,"x":0.09978769877417425,"text":"就向瓦古納下達了『不擇任何手段、無論如何一定要阻止迪蘭達爾進行調查","w":0.7452228986299955,"h":0.018928790347147118},{"conf":0.30000001192092896,"y":0.1254169844556131,"x":0.09558703561538437,"text":"』的命令⋯⋯","w":0.13679920710050142,"h":0.026448722344103115},{"conf":1,"y":0.043549712700943766,"x":0.7961783438825456,"text":"081","w":0.046709129443535446,"h":0.014790468364831555}]