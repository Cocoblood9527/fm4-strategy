[{"conf":0.5,"y":0.9111842106574614,"w":0.7383966195554893,"text":"OCU與USN陰謀，最後該部隊是與哈夫曼島上的游擊隊•『哈夫曼之","h":0.01904834728491933,"x":0.16244725973314514},{"conf":1,"y":0.8827073659069565,"w":0.7556308937527969,"text":"魂』一起爆破了『沙卡達企業』設立在島上祕密基地、並且向情報機關C-","h":0.026680271876485806,"x":0.1601425630876543},{"conf":0.5,"y":0.8630122640224501,"w":0.7366031473747017,"text":"IU揭露兩國政府的陰謀。事件曝光後，OCU政府在強大的輿論壓力下撤","h":0.022216829814408978,"x":0.164384253881479},{"conf":0.5,"y":0.8407485591575767,"w":0.7428063731773941,"text":"換了許多與此事相關的官員。陸防軍情報部長•丹尼爾也因為此案而被革職","h":0.020746274998313496,"x":0.15814281466866553},{"conf":1,"y":0.8197674416298197,"w":0.3143459857221435,"text":"強迫退伍、最後被判入獄服刑。","h":0.01744186093932698,"x":0.15822785090748587},{"conf":0.5,"y":0.756800765162966,"w":0.12476404413118569,"text":"USN方面","h":0.0198287022741217,"x":0.2044956149299464},{"conf":0.5,"y":0.7033373902838524,"w":0.7157803264608816,"text":"事件過後，USN有6名將級軍官因為實際參與了『BD生體電腦研究』","h":0.029475714031018674,"x":0.1790582668325398},{"conf":1,"y":0.6814588590205011,"w":0.7386315102224419,"text":"、『活體取出士兵人腦』、『建造適合BD生體電腦使用的雷霆機甲』等等","h":0.024419763370564063,"x":0.16021253206255084},{"conf":0.5,"y":0.6602670771539338,"w":0.7428300443298776,"text":"案件（過程中還殺死了3名士兵、製造出3顆試作型BD電腦）、結果6人","h":0.021650257863496503,"x":0.1560133601764057},{"conf":1,"y":0.6393914472664416,"w":0.27004220093064774,"text":"紛紛被移送軍事法庭審判。","h":0.017680921052631526,"x":0.15611813992740575},{"conf":1,"y":0.5755813952142312,"w":0.22784809849996274,"text":"薩夫特拉共和國方面","h":0.02034883750112426,"x":0.20253164683065622},{"conf":1,"y":0.5239972224705275,"w":0.7199026030401625,"text":"事件爆發後，薩夫特拉共和國雖然承認輿論的報導『部份是事實』，但是","h":0.028028826964528908,"x":0.17909395284347554},{"conf":1,"y":0.4996942772153614,"w":0.7431516078320778,"text":"在最引人爭議與譴責的『BD生體電腦』部份，薩夫特拉共和國卻是一直避","h":0.028684995676341862,"x":0.15585465006356844},{"conf":1,"y":0.48108552611947586,"w":0.7426160571114261,"text":"重就輕、打死不肯承認他們與這件事有關。不過，薩國總統最後還是在強大","h":0.01891447368421051,"x":0.15611813161421936},{"conf":0.5,"y":0.4526452565511374,"w":0.7432165760413558,"text":"的輿論壓力下辭職下台。同時『永久和平調停機構』局長•梅魯迪夫斯基也","h":0.03136451620804637,"x":0.15583809484275632},{"conf":1,"y":0.43585526283717835,"w":0.2700422009306478,"text":"為了此事辭去局長的職務。","h":0.017680921052631637,"x":0.15611813992543014},{"conf":0.30000001192092896,"y":0.3724170763249045,"w":0.21367627055093041,"text":"沙卡達企業方面","h":0.02202238769907705,"x":0.16003360546327944},{"conf":0.5,"y":0.3226744185543897,"w":0.7194092962224046,"text":"醜聞發生之後，『沙卡達企業』身敗名裂，最後於2094年被外國的『","h":0.023255814062921654,"x":0.1751054783971153},{"conf":0.5,"y":0.2981573079392943,"w":0.7408034295057057,"text":"伊古奇公社』收，同時有關『BD生體電腦』的相關技術也遭到全球機甲","h":0.025878901544370225,"x":0.15175728136568536},{"conf":1,"y":0.2804276316969305,"w":0.2911392430417008,"text":"生產工業的完全凍結與抵制。","h":0.017680921052631637,"x":0.1518987327709507},{"conf":1,"y":0.16715116274551212,"w":0.2721519015000373,"text":"亞羅爾迪修軍事政變","h":0.023255814062921654,"x":0.38818565251915893},{"conf":0.5,"y":0.1112697029247035,"w":0.7154379323444959,"text":"西元2102年，亞羅爾迪修國防軍中校•馬卡傑為了鼓吹亞羅爾迪修共","h":0.02029370477325032,"x":0.17287221412244475},{"conf":0.5,"y":0.08146744472564726,"w":0.7385726600956519,"text":"和國從OCU獨立出來而發起的軍事叛變。在馬卡傑部隊的閃電作戰之下，","h":0.020468836552218317,"x":0.1476052064386314},{"conf":1,"y":0.05377906947547917,"w":0.04641350356946414,"text":"170","h":0.014534884377529811,"x":0.15822784726590086}]