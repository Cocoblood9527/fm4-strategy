[{"y":0.9402241578808016,"conf":0.5,"text":"雷霆任務4","w":0.14237783505366397,"h":0.023621451786138503,"x":0.7196815707623986},{"y":0.9083787767115629,"conf":1,"text":"的正統，薩夫特拉共和國的首都仍然是設立在舊俄國的莫斯科、當然總統府","w":0.7453947067260743,"h":0.02069206363173326,"x":0.09757380050636556},{"y":0.8792111749378898,"conf":1,"text":"也還是維持在克里姆林宮不變。","w":0.3142250501192533,"h":0.01766639276910431,"x":0.0976645449216155},{"y":0.7965116279683775,"conf":1,"text":"薩夫特拉共和國主要加盟國","w":0.35881104836097133,"h":0.02189428804345872,"x":0.1571125224231421},{"y":0.7554593653723058,"conf":1,"text":"烏克蘭共和國","w":0.10636058220496547,"h":0.015244060005432547,"x":0.5965012373919161},{"y":0.7539704397970537,"conf":1,"text":"摩爾多瓦共和國","w":0.1233346737348116,"h":0.015314935168577515,"x":0.22283372459738482},{"y":0.7340116279568827,"conf":1,"text":"亞塞拜然共和國","w":0.12526539655832136,"h":0.01455040965397636,"x":0.5966029704025252},{"y":0.7321779173918586,"conf":1,"text":"亞美尼亞共和國","w":0.1233299603829017,"h":0.015295328032118194,"x":0.2228360812752774},{"y":0.7118223073038814,"conf":1,"text":"喬治亞共和國","w":0.10637868367708647,"h":0.015308873812096446,"x":0.5964921866624301},{"y":0.7122093022942406,"conf":1,"text":"哈薩克共和國","w":0.10615711028759303,"h":0.013081395439956567,"x":0.2229299373190485},{"y":0.6902426517368683,"conf":1,"text":"白俄羅斯共和國","w":0.12322457020099342,"h":0.014863533766032555,"x":0.5965618124781302},{"y":0.6888683151963639,"conf":0.5,"text":"烏兹別克共和國","w":0.12318514860593355,"h":0.014705230098526978,"x":0.22290848716389267},{"y":0.6682176091142453,"conf":1,"text":"塔吉克共和國","w":0.10637871118692244,"h":0.015308968630988962,"x":0.5964921729603087},{"y":0.668504927907561,"conf":1,"text":"土庫曼共和國","w":0.1062094523356511,"h":0.013280842670575499,"x":0.22290376629507447},{"y":0.6482558139546479,"conf":1,"text":"俄國","w":0.03609341841477609,"h":0.013206798910800677,"x":0.5966029722075346},{"y":0.6466721443015626,"conf":1,"text":"吉爾吉斯共和國","w":0.12314225160158598,"h":0.013211576685909443,"x":0.22292993566417513},{"y":0.5610465117048259,"conf":0.5,"text":"薩夫特拉共和國簡略年表","w":0.3312101730933556,"h":0.02194444958852182,"x":0.15711253564232514},{"y":0.5188953489224635,"conf":0.5,"text":"1991年","w":0.08492568823007436,"h":0.013150666126386046,"x":0.10828025622466557},{"y":0.5172555461028263,"conf":1,"text":"蘇聯解體","w":0.07218683682955226,"h":0.014790468364831666,"x":0.2080679402935315},{"y":0.4983831226265618,"conf":0.5,"text":"2015年","w":0.08289968050443211,"h":0.011954685264468301,"x":0.11035483137850835},{"y":0.4970930232192141,"conf":1,"text":"薩夫特拉共和國成立","w":0.15923566084641674,"h":0.013178135394658286,"x":0.20806794442046442},{"y":0.4717923083361387,"conf":0.5,"text":"『永久和平調停機構』（PMO）","w":0.25301870932945836,"h":0.01811033012245955,"x":0.21424225801981484},{"y":0.47522713893281443,"conf":1,"text":"2021年","w":0.08496751235081601,"h":0.013208513095325891,"x":0.10825934416387553},{"y":0.4517191530707023,"conf":1,"text":"『拉布努伊國營科學研究所』設立","w":0.25935941476088303,"h":0.016379930783023355,"x":0.21424934549047853},{"y":0.45343153996871355,"conf":1,"text":"2060年","w":0.08496309243715726,"h":0.013195059783358776,"x":0.1082615539333406},{"y":0.4300883916013507,"conf":1,"text":"薩夫特拉共和國與拉布努伊國簽訂和平條約","w":0.33357480856088495,"h":0.016287012186418814,"x":0.2100703131044133},{"y":0.4316860465750798,"conf":1,"text":"2112年","w":0.08704883318680982,"h":0.013260543199474895,"x":0.10615711254672246},{"y":0.29360465192384155,"conf":0.5,"text":"哈夫曼島 （Huffman Island）","w":0.33121017309335554,"h":0.023255812896502914,"x":0.3099787750669103},{"y":0.23691860485511396,"conf":0.5,"text":"西元1995年，聯合國的偵察機在南緯12度、西經91度的太平洋海","w":0.7197451958289514,"h":0.017441860064190684,"x":0.12101912176068354},{"y":0.20533244782453453,"conf":0.5,"text":"上發現一座新隆起的小島。西元2002年，聯合國正式將該島命名為『哈","w":0.7454385757446289,"h":0.023002438008442372,"x":0.09754423477393309},{"y":0.1710561948553605,"conf":0.5,"text":"夫曼島』。到了西元2065年，各國調查團發現『哈夫曼島』的地底下蘊","w":0.7456024610079252,"h":0.02791746542310758,"x":0.09537177067719196},{"y":0.14314859522220114,"conf":0.5,"text":"臧有大量的天然資源，此時OCU、USN兩國才開始進駐此島、而且兩國","w":0.7412070494431716,"h":0.019521562800411285,"x":0.09754699434421614},{"y":0.10972473349563772,"conf":1,"text":"都各自宣稱擁有『哈夫曼島』的主權，雙方還因此爆發了兩次大戰。史稱『","w":0.7454631511981671,"h":0.026947030887901513,"x":0.09755434795466737},{"y":0.07948562397433134,"conf":0.5,"text":"第一次&第二次哈夫曼紛爭』。","w":0.31488403907189005,"h":0.023687724706670132,"x":0.09732952679326495},{"y":0.053779069842139204,"conf":1,"text":"165","w":0.046709129443535446,"h":0.01453488364803468,"x":0.7961783438713711}]