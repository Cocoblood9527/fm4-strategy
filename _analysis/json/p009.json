[{"x":0.7218683662064526,"y":0.9433032045606458,"w":0.1422505287023691,"h":0.021813074486512263,"conf":1,"text":"雷霆任務4"},{"x":0.2738853518421313,"y":0.8734593263017221,"w":0.24203821328970104,"h":0.0320639300757779,"conf":0.5,"text":"遊戲流程"},{"x":0.12079059728090759,"y":0.7929198789788495,"w":0.7245465792142428,"h":0.0305907783100815,"conf":1,"text":"關於本作的遊戲流程，簡單的說就是「劇情」→「戰鬥」→「劇情」→「"},{"x":0.09968718046812827,"y":0.7672673030534086,"w":0.7454387224637545,"h":0.024147691938263938,"conf":0.5,"text":"戰鬥」→⋯如此不斷重複。至於在兩個部分中可以進行的動作，筆者就先概"},{"x":0.0996611454232912,"y":0.7425881047797636,"w":0.7454573557927059,"h":0.021496917737147347,"conf":1,"text":"述如下，詳細的內容我們將於稍後再另行說明。此外，在本作序盤中，玩"},{"x":0.09967658894748141,"y":0.7127839272575316,"w":0.7433442335862379,"h":0.02821114382591028,"conf":1,"text":"家將會同時進行以エルザ為中心的「EC篇劇情」，以及以ダリル為中心"},{"x":0.10615711514574916,"y":0.6860465119953254,"w":0.736730355482835,"h":0.020348836480346688,"conf":1,"text":"「南美篇劇情」。不過遊戲將會自動切換章節，並不需要玩家親自來進行切"},{"x":0.09766454468747995,"y":0.659819227442564,"w":0.04458598448679996,"h":0.01605286594287436,"conf":1,"text":"換。"},{"x":0.21231421626414593,"y":0.5770348833257581,"w":0.5244161532475398,"h":0.02773093393618875,"conf":1,"text":"在劇情部分玩家可以進行的操作"},{"x":0.11040340060787468,"y":0.5101744188150537,"w":0.20806793066171497,"h":0.021871595766667862,"conf":0.5,"text":"●與角色們進行對話"},{"x":0.11252654598615892,"y":0.48255813990584195,"w":0.34182588870708763,"h":0.0203488364803468,"conf":0.5,"text":"●到電腦商店瞒買技能＆特殊能力"},{"x":0.11040339972889451,"y":0.4534883719541678,"w":0.23142249767596906,"h":0.02325581446375724,"conf":1,"text":"●調整機體各種零件"},{"x":0.11040339773273701,"y":0.42587209374554713,"w":0.2547770646902231,"h":0.023255812896502803,"conf":0.5,"text":"●調整駕駛員的能力設定"},{"x":0.11031227899154966,"y":0.3979285259401587,"w":0.1657873300405649,"h":0.02245690181986071,"conf":1,"text":"●進行模擬戰鬥"},{"x":0.11252653974450869,"y":0.37209302315673987,"w":0.22929936188917896,"h":0.019032696180884323,"conf":0.5,"text":"●紀錄進度／讀取進度"},{"x":0