[{"w":0.1444754875623263,"conf":0.5,"y":0.9402487640621825,"text":"雷霆任務4","x":0.7133248888207244,"h":0.022118751005550386},{"w":0.15105701409853423,"conf":1,"y":0.8934673166956136,"text":"戰術方針","x":0.39262435908686955,"h":0.027018855023599575},{"w":0.7261146398691031,"conf":1,"y":0.8052325585088808,"text":"本關的難度真的是高的嚇人！由於一開始敵軍就會往英軍的6台機甲方位","x":0.10615711739211779,"h":0.0203488364803468},{"w":0.7243102880624624,"conf":1,"y":0.7768476742071793,"text":"衝，玩家不快點上去保護不行，但是在前往議會的路上又有瓦古納、賽曼","x":0.10600902076840221,"h":0.022655035691272918},{"w":0.7221833008986254,"conf":1,"y":0.7490029224597743,"text":"等兩架頭目機在等著玩家，而且四周又有許多能力極高、裝備極為精良","x":0.10812403921361871,"h":0.022109596672465592},{"w":0.7242890137892501,"conf":1,"y":0.7212544390653248,"text":"敵機埋伏，有時候主角群的攻擊甚至會被一隻普通的小兵全部躲開。因此","x":0.10811916377847314,"h":0.022194811429953942},{"w":0.7220534544724685,"conf":1,"y":0.6925480588582767,"text":"在本關，玩家必須讓英軍6台機甲『獨力抗敵』、然後將心力擺在如何","x":0.10819387972929637,"h":0.023753099590417492},{"w":0.7242981103750376,"conf":1,"y":0.6653138061028392,"text":"打倒眼前的敵人身上。首先，玩家必須先避開路上的行道樹、然後取得良","x":0.10599943695831986,"h":0.022067244756192372},{"w":0.7243042725783128,"conf":1,"y":0.6376899667887177,"text":"好的射擊，接下來請善用各種飛彈、以及空中支援打倒敵方的飛彈引導機","x":0.1081106082848137,"h":0.022379515498215485},{"w":0.7242870330810547,"conf":1,"y":0.6095323080740376,"text":"甲，至於其他人則是全力猛攻瓦古納跟他身邊的小兵。由於這種近乎硬幹","x":0.1081335657100863,"h":0.02199840388928853},{"w":0.7242849790132962,"conf":1,"y":0.5818177584725179,"text":"的戰法會導致大量的傷亡，因此請玩家在攻略本關之前一定要購買補血道","x":0.10812224851554028,"h":0.021792174365154127},{"w":0.20440743519709664,"conf":1,"y":0.5536028570018668,"text":"具、以備不時之需。","x":0.10797729449983436,"h":0.020268956656914416},{"w":0.1827397713294396,"conf":1,"y":0.36309531974540743,"text":"敵方機體資料","x":0.15066833206476063,"h":0.023809360889694986},{"w":0.07218683682955229,"conf":0.5,"y":0.3225143795702248,"text":"右手HP","x":0.6772823776539862,"h":0.013241434449922318},{"w":0.0700636918728168,"conf":0.5,"y":0.3225143795702248,"t