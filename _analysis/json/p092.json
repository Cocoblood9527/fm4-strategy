[{"y":0.8880813954060791,"x":0.4556962013154821,"conf":1,"h":0.026162790624718935,"text":"戰術方針","w":0.14978903176391895},{"y":0.8009569110382777,"x":0.17079700368851708,"conf":1,"h":0.020876600554114888,"text":"本關的難度非常非常的高，敵軍不但擁有各種遠近距離的攻擊型機甲，而","w":0.7195919646852624},{"y":0.7731037210305702,"x":0.17292056112366913,"conf":0.5,"h":0.022085504312264304,"text":"且各敵機之間的LINK攻擊防禦也配合的天衣無縫，再加上每台『Z-","w":0.7090036760935635},{"y":0.7441860467157677,"x":0.17299578784438907,"conf":0.5,"h":0.018971847860436708,"text":"eder H2』的左肩都裝備有3發射程超高、範圍超廣的強力擴散彈","w":0.7151898586664677},{"y":0.7113747720087458,"x":0.17475390902240642,"conf":1,"h":0.0310204531017102,"text":"，因此我方想在本關拿下『敵全滅』的勝利是近乎不可能的。事實上，玩","w":0.7158391037533562},{"y":0.6858265263333999,"x":0.1705873907029032,"conf":0.5,"h":0.02979964017868042,"text":"家在玫略此關時最好要先作好『死傷慘重』的心理準備。","w":0.5597423471528193},{"y":0.6332265628527534,"x":0.17079142386541962,"conf":1,"h":0.020581057197169184,"text":"當敵方機甲數量損耗到一定程度時，地圖左下方就會出現逃脫路線，只要","w":0.7174843581024388},{"y":0.6060855261194957,"x":0.16877636438492674,"conf":1,"h":0.018914473684210398,"text":"玩家的機甲移動到該處就可以脫離戰場。因此筆者建議玩家們一開始就往","w":0.7194092962224046},{"y":0.5784883723002119,"x":0.1687763643016259,"conf":1,"h":0.018962285236308274,"text":"左下方前進。當然，玩家在前進途中也要小心，最好是不要戀戰，一邊逃","w":0.7194092962224046},{"y":0.5480332532594374,"x":0.16871290216539292,"conf":0.5,"h":0.0219139848884784,"text":"跑一邊補血，注意不要讓5架游擊隊機甲全滅，否則遊戲可是會『GA-","w":0.7111031980673852},{"y":0.5188953487012733,"x":0.16877637065438386,"conf":0.30000001192092896,"h":0.02034883750112426,"text":"ME OVER』旳唷。","w":0.24472573947223672},{"y":0.40254934227006733,"x":0.20886076121467836,"conf":1,"h":0.0234375,"text":"敵方機體資料","w":0.18143459493049854},{"y":0.35896381605080385,"x":0.2004219417639455,"conf":0.30000001192092896,"h":0.014582695929627687,"text":"機體名稱","w":0.07172995592358572},{"y":0.35874304787259736,"x":0.6433523564716928,"conf":0.30000001192092896,"h":0.013618555508161934,"text":"左手HP","w":0.06772566638300126},{"y":0.3589586535