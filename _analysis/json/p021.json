[{"w":0.1423397155908438,"conf":0.5,"x":0.7112080618442799,"y":0.9402791795944299,"text":"雷霆任務4","h":0.02351140858408063},{"w":0.7480143033541166,"conf":0.30000001192092896,"x":0.09307716540645981,"y":0.8931890375307802,"text":"三關於「Armor Coating（防禦支援）」_","h":0.03140951515517465},{"w":0.7369240247286284,"conf":1,"x":0.09757671716345666,"y":0.8395637125284217,"text":"所謂的「防禦支援」，乃是指玩家能夠讓航空部隊幫一定範圍內機體加","h":0.024034924848018946},{"w":0.7436451545128455,"conf":0.5,"x":0.09103433880350958,"y":0.8060147271056434,"text":"上特殊防禦屬性，諸如「耐貫通」「耐衝擊」「耐炎熱」·．等。因為玩家","h":0.03013831509266518},{"w":0.7457754428570087,"conf":1,"x":0.09099282476825817,"y":0.7780214506485144,"text":"在設定機體時就可以幫機體加上一種特殊防禦屬性，因此如果再搭配航空部","h":0.02526000531462247},{"w":0.6757460374098558,"conf":1,"x":0.09098562254686118,"y":0.7471423142243299,"text":"隊的防禦支援的話，那麼一部機體就有可能同時擁有2種防禦屬性。","h":0.02479577123286214},{"w":0.719967401944674,"conf":0.30000001192092896,"x":0.11453696920541417,"y":0.684691319272525,"text":"當玩家選定「A rmor Coating」指令後，畫面上就會顯示一","h":0.02355025611946404},{"w":0.7458041998056264,"conf":1,"x":0.09101679734339435,"y":0.6542371952596019,"text":"個大型的紅色方塊，這就是航空部隊能賦予防禦屬性的範圍。這時請玩家移","h":0.025911538837968817},{"w":0.7458044932438777,"conf":1,"x":0.09100441747359621,"y":0.6231802222912034,"text":"動這個範圍到任意區域（當然是我方機體存在的區域）並按下決定鈕就可以","h":0.025432712833902915},{"w":0.7437425760122446,"conf":1,"x":0.09309472394715097,"y":0.5918255959908614,"text":"完成申請手續，至於航空部隊實行防禦支援時間則是在本次玩家行動回合","h":0.025867154976336293},{"w":0.7478655301607573,"conf":1,"x":0.09104177534654571,"y":0.5610475745858721,"text":"結束後。比較值得注意的是，因為航空部隊只能針對玩家指定的區域進行防","h":0.025512607546252397},{"w":0.7457741957444411,"conf":1,"x":0.09312683713046924,"y":0.5298368659555235,"text":"禦屬性附加行動，並沒有辦法分辨區域中是否有敵機存在。因此如果玩家指","h":0.025006016062828262},{"w":0.7457747092613807,"conf":1,"x":0.09314421073626797,"y":0.4988671009595911,"text":"定的區域中有敵機存在的話，該敵機也會同時被附加上玩家所指定的防禦屬","h":0.025320532680439323},{"w":0.38428875116201555,"conf":1,"x":0.09341825714080085,"y":0.4694767440900096,"text":"性，這算是玩家必須特別注意的地方。","h":0.01901955867068339},{"w":0.2786164100353534,"conf":0.5,"x":0.13986437953750494,"y":0.3439623391800246,"text":"關於通信背包的特殊能力","h":0.02263401567495149},{"w":0.722070547250601,"conf":0.30000001192092896,"x":0.11241836563074371,"y":0.3094789582962325,"text":"在某些通信背包中，玩家可能會看到「Sa lvag e」（救助行動）這","h":0.022919326506389726},{"w":0.7245465792142427,"conf":1,"x":0.11225032058494594,"y":0.28056659911496296,"text":"個能力。一般來說，當玩家部隊的機體被破壞時，這架機體在本關中就再","h":0.025949741448157204},{"w":0.7224182715782752,"conf":1,"x":0.11435567341520042,"y":0.25316335473390306,"text":"也不可能登場。不過如果該機體的聯合攻擊（聯合防禦）小隊中有某機體","h":0.024817834257002014},{"w":0.7224524571345402,"conf":1,"x":0.11436114204812306,"y":0.2248432978057714,"text":"裝備了具有這能力的通信背包（當然要開啟設定才會有效）的話，那麼就","h":0.02522022369560295},{"w":0.722487523005559,"conf":1,"x":0.11433399570704478,"y":0.19698529474204407,"text":"算機體被破壞，還是能夠在本關中再度復活。至於該背包能夠在一關中讓","h":0.025286160440061045},{"w":0.5186966015742376,"conf":1,"x":0.11431351975125664,"y":0.1689711634676001,"text":"機體復活幾次，就得看機體設定時所顯示的數字了。","h":0.023589157725124932},{"w":0.046709129443535446,"conf":1,"x":0.796178343887574,"y":0.05505341036716038,"text":"021","h":0.013260543199474895}]