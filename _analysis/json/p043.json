[{"h":0.023739956594826084,"y":0.9387114170849665,"text":"雷霆任務4","conf":1,"x":0.715414864732747,"w":0.1424186779902532},{"h":0.021123426902852516,"y":0.906263792085516,"text":"個性都能展現最大限度的包容。因此對愛爾莎與其他隊員來說，他不但是部","conf":1,"x":0.09331394200586374,"w":0.7454360815194937},{"h":0.020103343314779698,"y":0.8788972403102795,"text":"隊的領導者，同時也就像是大家的好爸爸一樣。","conf":1,"x":0.09327026745212923,"w":0.4737408711360051},{"h":0.02927533465521004,"y":0.7879760897487385,"text":"ハーミーズ）／20歳=","conf":1,"x":0.49632874044223085,"w":0.3386236337515024},{"h":0.0262941659819228,"y":0.7892358254577716,"text":"上哈米兹（He rmes","conf":0.30000001192092896,"x":0.10615710501350527,"w":0.3566879125741812},{"h":0.024651820481362274,"y":0.7345229436534311,"text":"雖然他不是軍人，但因為他擁有過人電腦能力，因此被招攬進「迪蘭達","conf":1,"x":0.11447242423914009,"w":0.7243350102351263},{"h":0.026962587455304443,"y":0.7046080208733005,"text":"爾」擔任情報分析的工作。他的性格樂觀而且活潑，但只要他跟別人意見不","conf":1,"x":0.09315820683243384,"w":0.7457406704242412},{"h":0.020322649226192535,"y":0.6798285156439907,"text":"合的話就立刻會跟他人發生口角，在這方面看來他算是相當孩子氣。","conf":1,"x":0.09332009348262214,"w":0.6753610464242789},{"h":0.026294166765549853,"y":0.5870994244074763,"text":"萊多娜（Latona","conf":0.30000001192092896,"x":0.1571125222687476,"w":0.32271762994619513},{"h":0.021943255340651335,"y":0.5899753494115707,"text":"ラトーナ）／28歲","conf":1,"x":0.5053078620535777,"w":0.2802547674912673},{"h":0.023418241577649934,"y":0.5304026294749848,"text":"前『薩夫特拉共和國』政府軍的機甲駕駛員。雖然她身為駕駛員的能力無","conf":1,"x":0.1146496647569571,"w":0.7239915407620943},{"h":0.021486865367278174,"y":0.5042836444334947,"text":"話可說，但她講話就是常常會露出一股鄙視他人的口氣，而且因為她長年待","conf":1,"x":0.09329570777944525,"w":0.745471660907452},{"h":0.021321863254368467,"y":0.4765570983645959,"text":"在軍隊裡生活，以致她不管是行動或是口氣都活像個男人。她不擅長表露快","conf":1,"x":0.09331742104212445,"w":0.7475439951970027},{"h":0.020654970637676517,"y":0.44842409423956475,"text":"樂的感覺，而且對自己或他人都相當嚴格。","conf":1,"x":0.09324936975113324,"w":0.4292084987346943},{"h":0.026362242028668215,"y":0.3590116278359825,"text":"E瓦古納（Wagner","conf":0.30000001192092896,"x":0.11252653499802165,"w":0.35881104836097133},{"h":0.023673555943058866,"y":0.3616167627330169,"text":"ヴァグナー）／28歳","conf":1,"x":0.49239927015742396,"w":0.2997216811546913},{"h":0.02496731428210619,"y":0.30257798396417324,"text":"德軍特殊部隊-「布拉尼貝爾」部隊隊長，時時保持著沉著冷靜的態度，","conf":0.5,"x":0.11667217613424564,"w":0.7199335831862229},{"h":0.020853990791464994,"y":0.2763103900153647,"text":"而且不管是面對誰都不會流露自己內心的感情。","conf":1,"x":0.09537419842070233,"w":0.47377131535456735},{"h":0.029092191572353876,"y":0.1877720611528867,"text":"：葛雷薩（Glaeser","conf":0.30000001192092896,"x":0.1119904643618954,"w":0.3703962839566744},{"h":0.021969530361053313,"y":0.1933139535866485,"text":"グレーザー）／50歲 ［","conf":1,"x":0.47770700500642277,"w":0.3481953327472393},{"h":0.021508429220884473,"y":0.13552848399504447,"text":"德軍准將。他由小兵一路打到今天這個准將的地位，是個徹頭徹尾的軍人","conf":1,"x":0.11665939015009516,"w":0.7242262180034931},{"h":0.021047980058555682,"y":0.10772277939882646,"text":"。他不管對誰都是一股相當不高興的態度，而且在對部下傳達任何事情時也","conf":1,"x":0.09544151685898751,"w":0.7454255911020132},{"h":0.02092196104853683,"y":0.08038605738067661,"text":"差不多都是直接用吼的，因此部下之間對他都是帶有幾分的恐懼感。","conf":1,"x":0.09541203598618028,"w":0.6754060891958383},{"h":0.016064807637950484,"y":0.053779070410947205,"text":"043","conf":0.30000001192092896,"x":0.7898089179518102,"w":0.053078555143796446}]