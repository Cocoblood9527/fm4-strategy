[{"y":0.8864675082472006,"text":"劇情提要","conf":0.5,"h":0.02793707659370026,"x":0.4471962767505877,"w":0.15202094831443913},{"y":0.8144333045501998,"text":"突破瓦古納封鎖線後，愛爾莎一行人搭上貨物運送列車準備前往『薩夫","conf":1,"h":0.0229906557421935,"x":0.17076686356711765,"w":0.7196323148959576},{"y":0.7815774602647838,"text":"特拉共和國』的資源據點尋找該國祕密走私資源的證據。在得知迪蘭達爾一","conf":0.5,"h":0.023039551941971936,"x":0.1496846374896937,"w":0.7449316056645285},{"y":0.7525980859839527,"text":"行人成功闖關之後，葛雷薩准將似乎又再計劃什麼陰謀打算阻撓愛爾莎他們","conf":1,"h":0.020212011901955873,"x":0.14971200397686193,"w":0.740656814028938},{"y":0.7208793335743108,"text":"。至於在貨物列車這方面，經過長途拔涉之後，愛爾莎一行人終於來到『薩","conf":1,"h":0.02345950666226837,"x":0.15174999800243563,"w":0.7386685828889469},{"y":0.6875000002951659,"text":"夫特拉共和國』的邊界地帶。就在此時，貨物列車前方的軌道路線竟然被人","conf":1,"h":0.021802324997751366,"x":0.14978902482805515,"w":0.7405063383334576},{"y":0.6560428946395196,"text":"用炸藥炸毀了！看到眼前的景像，吉德直呼不可能，因為就算『薩夫特拉共","conf":1,"h":0.026434374483008227,"x":0.14959291219863677,"w":0.7409192360670868},{"y":0.6264534885499345,"text":"和國』再怎麼不願意讓他們進入國內調查，『薩夫特拉共和國』也不至於將","conf":1,"h":0.023255814062921654,"x":0.14978902621301798,"w":0.7405063383334576},{"y":0.5968493523509004,"text":"自己國內對外輸出資源的重要管線給炸毀。難道說⋯『薩夫特拉共和國","conf":0.30000001192092896,"h":0.021404509481630862,"x":0.14969638588309286,"w":0.7385725144270211},{"y":0.5624563274603445,"text":"』是擔心迪蘭達爾眾人查到什麼更大更不可告人的『黑幕』嗎？ 為了掩蓋","conf":0.5,"h":0.026829294468227127,"x":0.14755958475390163,"w":0.7428365265839424},{"y":0.5319767444813402,"text":"真相，『薩夫特拉共和國』竟然不惜將國內最重要運輸管線炸毀，對方到","conf":1,"h":0.0218883870463622,"x":0.1497890248316989,"w":0.7405063383334577},{"y":0.5019154201240723,"text":"底想要隱瞞什麼事情呢？就在眾人百思不得其解時候，『薩夫特拉共和","conf":1,"h":0.02340925524109294,"x":0.14756325459839761,"w":0.7428513847842706},{"y":0.4690715290819556,"text":"國」的機甲軍團已經將眾人給團團包圍住了…。","conf":0.30000001192092896,"h":0.02721274212787017,"x":0.14946140785328113,"w":0.5154174222012977},{"y":0.4102300718448909,"text":"打倒敵軍之後，遊戲畫面來到德國的調查本部，葛雷薩准將正在跟瓦古納","conf":1,"h":0.020102145640473523,"x":0.17080356547123582,"w":0.7195720080828611},{"y":0.37881059597718225,"text":"進行連絡，從兩人之間對話內容看來，爆破薩夫特拉共和國運輸管線的行","conf":1,"h":0.020754580435000003,"x":0.14759080452990944,"w":0.7427976330595539},{"y":0.34728628536892014,"text":"為似乎是葛雷薩刻意派人作的，而且兩人對話當中不斷的提到『本國』這","conf":1,"h":0.02326452888940511,"x":0.1476278761925634,"w":0.7427373990807726},{"y":0.31686046499645637,"text":"兩個字，難道說葛雷薩跟瓦古納都是外國派來潛伏在德國的間諜嗎？擔心","conf":0.5,"h":0.020348837501124373,"x":0.14978902565367577,"w":0.7405063383334576},{"y":0.28225806280591703,"text":"迪蘭達爾眾人打亂『全盤計劃』的葛雷薩，他在通信連絡裡頭『建議』瓦古","conf":0.5,"h":0.02781654345361806,"x":0.14754665671735556,"w":0.7428869279301537},{"y":0.2557565790780171,"text":"納最好儘快帶著薩夫特拉共和國的正規軍將愛爾莎一行人除掉。","conf":1,"h":0.017680921052631526,"x":0.14767933062842747,"w":0.6286919714442871},{"y":0.04358552640511293,"text":"084","conf":1,"h":0.014554008841514587,"x":0.15400843978411183,"w":0.05063290926038794}]