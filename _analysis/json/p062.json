[{"conf":1,"x":0.46624472858919697,"w":0.15400843290269794,"y":0.8922697364248119,"h":0.026334914721940716,"text":"戰術方針"},{"conf":1,"x":0.1854839021874758,"w":0.7176316290880445,"y":0.8010043624355045,"h":0.022188337225663046,"text":"從本關開始，玩家就可以在商店裡頭購買裝備來強化我軍的機甲戰鬥能力"},{"conf":1,"x":0.18554028111536536,"w":0.717529733880892,"y":0.7737859317278234,"h":0.021079353596034855,"text":"。由於本關的敵人都裝備了相當精良的武器，因此筆者建議玩家最好把身"},{"conf":1,"x":0.18340103730775006,"w":0.7197029641818318,"y":0.7451290039291929,"h":0.02209660881444031,"text":"上所有的錢都拿去買裝備或道具，可能的話最好再多買一個回復背包給其"},{"conf":1,"x":0.18341580808996072,"w":0.7196685135506786,"y":0.7175675460888107,"h":0.02151826337764129,"text":"他機甲使用，這樣一來我方除了哈米茲之外就多一個人可以補血了。緊接"},{"conf":1,"x":0.18336501651102638,"w":0.7197602119536843,"y":0.6887155199343252,"h":0.023088448141750484,"text":"著，玩家會在地圖上看到一台已經奄奄一息的波蘭國防軍機甲，在前幾個"},{"conf":1,"x":0.1834055574143764,"w":0.719671208420346,"y":0.6609888721739137,"h":0.022116563822093815,"text":"回合裡，敵軍都會集中攻擊這台機體，我方可以趁這個時候趕快前進，然"},{"conf":1,"x":0.1811027037288841,"w":0.7200837419823984,"y":0.6288625872342556,"h":0.030530755457125247,"text":"後採用『一人接近攻擊、一或二人補血、一人飛彈攻擊』的方式來跟敵人"},{"conf":1,"x":0.18129512662918737,"w":0.7196864307922508,"y":0.6052308689856145,"h":0.02190322625009644,"text":"週旋。記住一定要所有的人都集中攻擊同一隻敵人，集中火力將敵軍個個"},{"conf":0.5,"x":0.18126263332445655,"w":0.719759920616423,"y":0.5769324686153945,"h":0.02259421505426107,"text":"擊破才是最正確的戰法。當然，善用LINK攻擊防禦的戰術也是很重要"},{"conf":1,"x":0.18143460002893969,"w":0.06751054568051723,"y":0.5537790704890267,"h":0.017441859370783797,"text":"的哦。"},{"conf":0.30000001192092896,"x":0.16444320287648684,"w":0.2365144351786247,"y":0.36732864301090506,"h":0.032784574910214026,"text":"《敵方機體資料"},{"conf":0.30000001192092896,"x":0.4574767261452957,"w":0.17787436255407213,"y":0.32469935536747674,"h":0.017780940783651222,"text":"等級｜移動｜身體HP"},{"conf":0.5,"x":0.3628691987925755,"w":0.054852319503456426,"y":0.3268914472008272,"h":0.014802631578947345,"text":"駕駛員"},{"conf":0.300000011920928