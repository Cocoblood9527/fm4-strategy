[{"h":0.027654528617858887,"y":0.8851744191102441,"x":0.4578059029235717,"text":"劇情提要","w":0.15611815168066645,"conf":1},{"h":0.026054150964084366,"y":0.8113519371240966,"x":0.18549798518012936,"text":"情況愈來愈不妙了。在早先『波蘭資源平台攻擊事件』的證據還不是很充","w":0.7197620328115677,"conf":1},{"h":0.020632296800613403,"y":0.7828099229718095,"x":0.16236712917601603,"text":"份的時候，歐聯各會員國原本還不太敢斷定幕後主使者就是USN。但是受","w":0.7427819008474419,"conf":0.5},{"h":0.026264477717248935,"y":0.7485728385208474,"x":0.16228023994249133,"text":"到USN合眾國不斷在大西洋海域增派軍隊施壓影響，歐聯各會員國『","w":0.7451321913689588,"conf":0.5},{"h":0.021897949670490413,"y":0.7179276314363002,"x":0.16244724560419502,"text":"民族意識』以及對U S N合眾國的敵意也愈來愈升高，各會員國對U SN","w":0.7426160571114261,"conf":0.5},{"h":0.01747054802744008,"y":0.6903782894214808,"x":0.1624472456007091,"text":"不滿跟憤怒開始讓各國領導人逐漸失去了理智。在一場充滿火藥味的會議裡","w":0.742616057111426,"conf":1},{"h":0.02034883750112426,"y":0.6598837209115018,"x":0.1624472456267765,"text":"頭，除了英國首相諾蘭德理性的提出『應該再繼續調查、找出更有力證據","w":0.7426160571114261,"conf":1},{"h":0.02422167752918447,"y":0.6239221142324839,"x":0.16234307560644656,"text":"證明攻擊事件是U SN所為』的主張之外，其他的歐聯會員國竟然一致同意","w":0.7428339045485904,"conf":0.5},{"h":0.01744186093932698,"y":0.5973837206956405,"x":0.16244725266932214,"text":"派出軍隊去對抗U S N的大西洋艦隊。看到各國領導者居然因為一時的情緒","w":0.7405063383334577,"conf":0.5},{"h":0.026553878658696184,"y":0.5613816645805687,"x":0.16228020080279376,"text":"不滿而妄顧『證據的正確性』，英國首相諾蘭德雖然又急又氣，但是卻又無","w":0.7429288804957861,"conf":1},{"h":0.01610312101088085,"y":0.5348837210692738,"x":0.16244725780781952,"text":"可奈何⋯","w":0.09493670770831777,"conf":0.30000001192092896},{"h":0.01610312101088074,"y":0.47238372104205206,"x":0.18565401570896017,"text":"另一方面，得知歐聯與U SN之間即將爆發戰爭的迪闌達爾一行人，他們","w":0.7151898586664678,"conf":0.5},{"h":0.026060443959738055,"y":0.4383032921561387,"x":0.16229981417027003,"text":"隨即透過英國事務次官這邊管道取得前往『梅卡佛洛特基地』（各歐聯會","w":0.7408164668481503,"conf":1},{"h":0.01610312101088074,"y":0.409883721042118,"x":0.16244725972990454,"text":"員國聯車駐紮地）的權限。可惜的是，眾人還是晚了一步，在德國部隊一一","w":0.7383966195554892,"conf":0.5},{"h":0.02615250882349507,"y":0.3747055174518955,"x":0.16229252774375333,"text":"也就是瓦古納所率領的『布拉尼貝爾』部隊搞鬼之下，『梅卡佛洛特基地』","w":0.7345235820032816,"conf":1},{"h":0.01898141048456503,"y":0.34738372113422233,"x":0.16244726742409724,"text":"四周陸續發生大規模的爆炸，整個基地的指揮系統也陷入一片混亂。","w":0.6708860556663933,"conf":1},{"h":0.0267643944213265,"y":0.28167587881968137,"x":0.1812757288688833,"text":"這一次，瓦古納玩的還是『陷害抹黑迪蘭達爾』的老把戲，反正迪蘭達爾","w":0.7218566020519465,"conf":1},{"h":0.017680921052631637,"y":0.25575657908218885,"x":0.1603375411510035,"text":"現在已經沒有什麼好失去的了，大不了就是坐牢被關而已，在這樣的覺悟之","w":0.742616057111426,"conf":0.5},{"h":0.024833613320400794,"y":0.22080592135679866,"x":0.16033754130564928,"text":"下，愛爾莎一行人決定『豁出一切』跟『布拉尼貝爾』部隊奮戰到底！可是","w":0.7426160571114261,"conf":1},{"h":0.017680921052631637,"y":0.19325657907762828,"x":0.16455697144981266,"text":"，就在眾人打倒達蘭斯之後，瓦古納卻趁機潛入基地內部、並且向US N合","w":0.7362869007775209,"conf":0.5},{"h":0.0218596999582491,"y":0.15988372140374063,"x":0.16033754727138658,"text":"眾國艦隊發射了大量的巡弋飛彈！ 看樣子，挑起歐聯跟U S N合眾國之間","w":0.7405063383334576,"conf":0.5},{"h":0.017441860939327092,"y":0.13226744162828685,"x":0.1603375541921945,"text":"的全面戰爭，這似乎才是葛雷薩准將他們真正的目的⋯","w":0.5864978872221808,"conf":0.30000001192092896},{"h":0.01455400805724294,"y":0.04358552655219228,"x":0.16877637311792257,"text":"102","w":0.04641349901731939,"conf":1}]