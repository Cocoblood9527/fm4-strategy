[{"h":0.02388935198819142,"text":"雷霆任務4","y":0.9400902077604755,"x":0.7153892530754598,"w":0.1424699013049786,"conf":0.5},{"h":0.02572469625104712,"text":"瑞拉獨立宣言』。為了壓制獨立軍勢力，U S N中央政府立刻就派兵前往","y":0.9017164132900624,"x":0.09323010722977447,"w":0.7456469169029823,"conf":0.5},{"h":0.024290536208141034,"text":"委內瑞拉州進行鎮壓。被派遺到委內瑞拉州的US N陸軍第332機動中隊","y":0.8737558054859196,"x":0.09318339284397806,"w":0.7456692182100736,"conf":0.5},{"h":0.021847471802961427,"text":"司令官•多納爾德上校還表示：『迪亞茲州長是一個獨裁者，U SN陸軍將","y":0.8437789255163136,"x":0.09327068478759735,"w":0.7433937512911284,"conf":0.5},{"h":0.024124616467766646,"text":"會在1個星期之內解放委內瑞拉！』。另一方面，迪亞茲州長則是將這次","y":0.8118792145885373,"x":0.09323317604897924,"w":0.7477027452909029,"conf":0.5},{"h":0.029446817365158973,"text":"的『獨立運動』定位為『委內瑞拉人民為了反抗USN合眾國暴政正當行","y":0.7794337323826661,"x":0.09313300901534394,"w":0.7457544620220478,"conf":0.5},{"h":0.027964771430611934,"text":"為』。雙方各說各話，一場混亂戰爭也即將展開。","y":0.7480596887055364,"x":0.09300624014003209,"w":0.5188481624309833,"conf":0.5},{"h":0.02288602234990078,"text":"畫面來到委內瑞拉國內，目前隸屬於USN陸軍第332機動中隊的達利","y":0.689549432867983,"x":0.11659177582582594,"w":0.7222380271324745,"conf":0.5},{"h":0.02296005944884405,"text":"爾中士（ダリル）正帯著雷凱斯伍長（レンゲス）與奇佛上兵（チェイファ","y":0.6583283069334793,"x":0.09325206745707487,"w":0.745561012854943,"conf":1},{"h":0.021936089069802156,"text":"一）趁著巡邏的空檔拚命的『摸魚』。從他們的談話中可以得知，他們對於","y":0.6277732132061081,"x":0.09129511727510617,"w":0.7473460710965669,"conf":0.5},{"h":0.03085365389445416,"text":"目前的軍旅生涯以及未來的人生規劃都有相當程度的『不爽』。為了『善待","y":0.5918269217696241,"x":0.09526298292547485,"w":0.7457918020395132,"conf":1},{"h":0.02643453242255711,"text":"自己』，他們才會在勤務時間大大的打混摸魚兼睡覺。正當雷凱斯要求奇佛","y":0.5634437093437178,"x":0.09735881811092202,"w":0.7436450811532828,"conf":1},{"h":0.022843286456293743,"text":"關掉無線電、好讓他能夠安靜睡覺的同時，奇佛的無線電卻傳出一架運輸機","y":0.5339454864660178,"x":0.09536847924687646,"w":0.7455616730910082,"conf":1},{"h":0.02281497243788766,"text":"即將墜機的求救訊號。正當三人感到疑惑不解的時候，一架受創嚴重的運輸","y":0.5026979401104583,"x":0.09536559019104415,"w":0.7455679820134089,"conf":1},{"h":0.02052750035006201,"text":"機就這樣筆直的掉落在三人前方不遠處。","y":0.4719520626533025,"x":0.09538016766828915,"w":0.4058344547565167,"conf":0.5},{"h":0.022401705469963673,"text":"經過一番檢查，達利爾赫然發現－一這架運輸機上竟然搭載了迪亞茲州長","y":0.4098025526861516,"x":0.11873239457130967,"w":0.7221910036527194,"conf":0.5},{"h":0.02295889889694369,"text":"個人搜刮來3噸黃金，市價大約有2500萬美元。看到這一大貨櫃的黃","y":0.3782892078358969,"x":0.09538586585758406,"w":0.7455619665292593,"conf":0.5},{"h":0.02183098977182174,"text":"金，早就想退伍不幹三人立刻就達成『私吞這筆黃金』的約定。不過，由","y":0.3488085452389136,"x":0.09554141726320459,"w":0.7452228986299956,"conf":1},{"h":0.02391659243731792,"text":"於黃金的數量太過於龐大，光靠他們三人駕駛的雷霆機甲還不足以搬運出來","y":0.3154220800167946,"x":0.0953728892616724,"w":0.7477151430570163,"conf":1},{"h":0.02558374052274981,"text":"，因此三人決定先返回營區『借』一台卡車出來，等他們將黃金拿到手之後","y":0.2834924230816164,"x":0.10181670393121617,"w":0.739048664386456,"conf":1},{"h":0.023418241577649934,"text":"再帶著黃金、卡車、還有雷霆機甲一起『落跑』、從此遠走高飛、再也不回","y":0.25431388625349105,"x":0.09766453792428156,"w":0.7430997995229869,"conf":1},{"h":0.024724827894149648,"text":"來當什麼鳥軍人了。然而，就在達利爾費盡九牛二虎之力才『騙』到司令部","y":0.22383720972692311,"x":0.09766456287537732,"w":0.7452228986299956,"conf":0.5},{"h":0.023440933854440793,"text":"的派車單、並且『借』到卡車準備回到墜機地點搬運黃金之後，達利爾三人","y":0.19022185710265882,"x":0.09766455910118516,"w":0.7452228986299956,"conf":1},{"h":0.02401844516776097,"text":"卻在路上遭遇到委內瑞拉獨立軍的攻擊，為了保命，達利爾一行人只好先停","y":0.1598694839280984,"x":0.09744997492735265,"w":0.7456627625685472,"conf":1},{"h":0.019958775065037293,"text":"下來跟眼前這群礙事的傢伙戰鬥了。","y":0.1299399501459777,"x":0.0975117380802441,"w":0.3612470626831055,"conf":1},{"h":0.013260543199474895,"text":"057","y":0.05505341036560296,"x":0.7940552025759219,"w":0.0488322698152982,"conf":1}]