[{"conf":0.5,"x":0.7196322075223132,"y":0.9328080854121655,"text":"雷霆任務4","w":0.14459970364203822,"h":0.02391871293255221},{"conf":0.5,"x":0.09759539925349252,"y":0.8992690594221343,"text":"裝備道具的能力）」兩種瀕。只要裝備了這種背包，玩家就可以在有限空","w":0.7453765135544999,"h":0.02238457146098405},{"conf":0.5,"x":0.09758612494252689,"y":0.8712257790959467,"text":"間中任意裝備一些消耗性的道具（例如：補充彈匣·•等），而且這些道具","w":0.743249746469351,"h":0.018865295385080194},{"conf":1,"x":0.09753665871617642,"y":0.8401324286008756,"text":"不只能對自己使用，還能對站在自機隔壁的機體使用，幫忙進行彈藥補給","w":0.7454573557927058,"h":0.021504945214302018},{"conf":1,"x":0.09736106296062798,"y":0.8075858881382929,"text":"工作呢！","w":0.08977893682626577,"h":0.024363107924198935},{"conf":0.5,"x":0.41188959596141506,"y":0.7180232555820749,"text":"修理背包","w":0.12314225160158598,"h":0.02325581446375713},{"conf":0.5,"x":0.12093516385534095,"y":0.6608509258051772,"text":"背包類型為R e p a ir的背包均可以稱為「修理背包」。只要裝備了這","w":0.72204039647029,"h":0.0249493919441518},{"conf":0.5,"x":0.09756417429280795,"y":0.6296117842574509,"text":"種背包，該機體就能在戰場上執行「維修」（Re p air）指令，為友機","w":0.7433011715228741,"h":0.022836881087467065},{"conf":0.30000001192092896,"x":0.09756276850021874,"y":0.5958646103338274,"text":"進行「回復零件HP」（Repair Parts）、「修理被破壞的零","w":0.7432778431819036,"h":0.02496024831554},{"conf":0.5,"x":0.0975849079848249,"y":0.5682244856966785,"text":"件」（Rebirth Parts）、「回復機體異常狀態」（R e m-","w":0.7347549291757436,"h":0.02124922492999759},{"conf":0.30000001192092896,"x":0.09978769000564142,"y":0.5392441857791639,"text":"oveStatus）等工作。至於操作方法則是：","w":0.5329086963947003,"h":0.015988372639740067},{"conf":0.5,"x":0.11242524290338213,"y":0.46287442392390576,"text":"裝備本背包的機體在戰場上選擇Re p a i r指令，此時畫面上會出現一","w":0.7263157184307392,"h":0.020698326380407583},{"conf":1,"x":0.1124595645143389,"y":0.43503015043951476,"text":"些綠色的方塊（可以進行維修的範圍），接著選擇範圍內的友機，並從選","w":0.7241293100210338,"h":0.020175924434364112},{"conf":1,"x":0.11246082450373944,"y":0.40699200742649555,"text":"單中挑選想要進行維修的種類。這時，玩家將可以在畫面上預先確認發動","w":0.7241300436166617,"h":0.02037910016325528},{"conf":1,"x":0.11240898466068824,"y":0.37864147150284744,"text":"這些指令時所會消耗的AP點數。決定選項後，畫面上會顯示目標機體","w":0.7242067043597881,"h":0.02146545667185973},{"conf":0.5,"x":0.11464969506890117,"y":0.35168446994027647,"text":"各種狀態選單（各部位零件HP、狀態異常一覽••等），但如果目標機","w":0.7197451958289512,"h":0.01766639276910431},{"conf":1,"x":0.1123855635072294,"y":0.32225689991468176,"text":"體各零件的HP都在全滿狀態，而且也沒有出現任何異常狀態的話，畫面","w":0.7221436133751502,"h":0.022019003097797585},{"conf":1,"x":0.11455363246165007,"y":0.2931603517706919,"text":"上就會顯示一段「該機體一切正常，不需要進行回復動作」的頻似文字。","w":0.7199201583862305,"h":0.024204522150896857},{"conf":1,"x":0.09541142275524211,"y":0.21736900829166772,"text":"※請注意，關於「回復機體異常狀態」的回復機能：","w":0.40790411142202526,"h":0.02028150723033395},{"conf":0.30000001192092896,"x":0.09758648700375876,"y":0.1924541395774022,"text":"●Attack Sys Down回復==＞同時會回復MS Sys Down","w":0.6455913690420297,"h":0.016246902227597726},{"conf":0.30000001192092896,"x":0.09971474700388115,"y":0.1751556319021048,"text":"●Movement Sys Down回復==＞同時會回復Movement Sys D-","w":0.7453643358670747,"h":0.015169396004720004},{"conf":0.30000001192092896,"x":0.11876034576932405,"y":0.15652616415574727,"text":"amaged","w":0.10019843394939716,"h":0.011711598618067809},{"conf":0.30000001192092896,"x":0.0997336074727798,"y":0.1394297141209676,"text":"●Sys Down回復==＞同時會回復Attack Sys Down、MS Sys","w":0.7134717060969425,"h":0.014391385833063208},{"conf":0.30000001192092896,"x":0.34600695190628195,"y":0.12153823568456235,"text":"Sys Down、Movement Sys Damag-","w":0.49908062127920294,"h":0.014323153844502667},{"conf":0.5,"x":0.1166182562871644,"y":0.12151224832329577,"text":"Down、Movement","w":0.22747215857872602,"h":0.013467630403592334},{"conf":0.30000001192092896,"x":0.11869796082179072,"y":0.10198037576766972,"text":"ed、BP Sys Down","w":0.24026610301091123,"h":0.01488704258237794},{"conf":0.30000001192092896,"x":0.09978768048347476,"y":0.08575581391427878,"text":"●LinkCut==＞只能回復LinkCut狀態","w":0.4543524522047777,"h":0.01325815470373426},{"conf":1,"x":0.7940552016320148,"y":0.0479651163537671,"text":"017","w":0.046709129443535446,"h":0.01453488364803468}]