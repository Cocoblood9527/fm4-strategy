[{"x":0.4556962064680781,"h":0.026334914721940605,"w":0.1645569539582245,"text":"劇情提要","conf":0.5,"y":0.8938953488944512},{"x":0.1917534683489682,"h":0.027456010642804562,"w":0.7198799515680937,"text":"場景轉回歐洲。葛雷薩准將私下派人爆破『薩夫特拉共和國』運輸管線的","conf":1,"y":0.8187534534950627},{"x":0.1685925912393935,"h":0.026607958894026895,"w":0.742956776038559,"text":"陰謀再度成功，如今『薩夫特拉共和國』的部隊都認為迪蘭達爾眾人就是炸","conf":1,"y":0.7886356898946949},{"x":0.16854671703908916,"h":0.02908389505587128,"w":0.7410207671026626,"text":"毀管線的元兇。在這種情況之下，要深入『薩夫特拉共和國』國境內部進行","conf":1,"y":0.7590017140365541},{"x":0.16869029487066825,"h":0.020565341962011208,"w":0.7406833257197196,"text":"調查已經是不可能的任務。為了逃出該地區，萊多娜建議眾人先前往位於黑","conf":1,"y":0.7328773777381539},{"x":0.16863219805967875,"h":0.023541238747144977,"w":0.5825285262879437,"text":"海旁邊的港都。『尼可拉艾夫市』找她的貿易商伯父幫忙。","conf":0.5,"y":0.7009981046638956},{"x":0.18978336803769758,"h":0.02075806887526266,"w":0.7195983012706967,"text":"愛爾莎一行人抵達尼可拉艾夫之後，萊多娜的伯父•賽魯凱立刻就為眾人","conf":0.5,"y":0.6443458119056789},{"x":0.1687763617705828,"h":0.019000534948549808,"w":0.7405063383334576,"text":"安排船隻出境的相關事宜。就在眾人趁著這個空檔各自休息時候，愛爾莎","conf":1,"y":0.6162790701030363},{"x":0.1687763665767935,"h":0.019096159621288966,"w":0.7405063383334577,"text":"、萊多娜、還有哈米茲無意間發現賽魯凱正在跟一名走私業者（這個人剛好","conf":1,"y":0.5857558141574427},{"x":0.1666666546272255,"h":0.020559210526315708,"w":0.742616057111426,"text":"就是那個姓張的私梟！）洽談非法機甲買賣，令人不敢置信的是，這名姓","conf":0.5,"y":0.5550986844029888},{"x":0.1666666591002702,"h":0.017680921052631637,"w":0.6054852469724231,"text":"張的私梟所兜售的赫然就是之前神祕敵人所使用的雷霆機甲。","conf":1,"y":0.5275493420356363},{"x":0.18769275061525362,"h":0.020379118229213455,"w":0.7195536538353968,"text":"萊多娜見狀立刻跳出來質問姓張的為什麼會擁有這台機甲，姓張的私梟心","conf":1,"y":0.4667977158527803},{"x":0.16666666195080662,"h":0.01746098540331187,"w":0.7405063383334577,"text":"虛的表示，這台機體是他在南美洲的委內瑞拉無意間拿到的（編註：這架機","conf":1,"y":0.4389534881375009},{"x":0.16657217596026005,"h":0.021078679122422894,"w":0.7406988394288857,"text":"甲其實就是奇佛當初在船上用火箭砲打倒的那一台）。就在此時，神秘的敵","conf":1,"y":0.40760905377279966},{"x":0.16447650531720684,"h":0.020490398532465925,"w":0.742764930451969,"text":"軍再度出現，對方追蹤到機甲的信號之後立刻衝進倉庫裡頭、同時一陣亂槍","conf":1,"y":0.3781431747903323},{"x":0.1645569698220764,"h":0.017441860939327092,"w":0.4704641191942311,"text":"掃射就把機甲打爆，毀滅證據的意圖非常明顯。","conf":1,"y":0.3502906974417177},{"x":0.18767584641839324,"h":0.020313121770557552,"w":0.7174734329551387,"text":"眼看證據又被敵人搶先一步消滅，再加上敵軍已經發現眾人的行蹤，吉德","conf":1,"y":0.2898315766565416},{"x":0.16432649351383277,"h":0.027662277221679688,"w":0.7409762653359935,"text":"立刻就叫大家登上姓張私枭走私船離開『薩夫特拉共和國』。在航行途中","conf":1,"y":0.25752821042575613},{"x":0.1666666760757921,"h":0.017441860939327092,"w":0.7362869007775209,"text":"，愛爾莎從姓張的口中得知他取得神祕機甲的經過，為了瞭解詳情，眾人開","conf":1,"y":0.23255813930075475},{"x":0.1624472455966378,"h":0.01903878466079101,"w":0.742616057111426,"text":"始嘗試用衛星通訊連絡達利爾一行人，可惜的是，目前在駐紮在委內瑞拉","conf":1,"y":0.2018914476995327},{"x":0.1644457445518829,"h":0.024564035628971248,"w":0.740788279968116,"text":"USN部隊正面臨敗戰逃亡的危機，U S N部隊甚至連達利爾一行人已經『","conf":0.5,"y":0.1702715532395459},{"x":0.16244725260706083,"h":0.02055921052631582,"w":0.7405063383334577,"text":"逃兵』了都還不知道。另外，由於U S N跟歐聯之間關係已經緊繃到最高","conf":0.5,"y":0.14226973701090107},{"x":0.1624472526339566,"h":0.019000534948549697,"w":0.7405063383334576,"text":"點，雙方現在已經在大西洋海域集結了大批的軍隊。如今能夠解開雙方誤會","conf":1,"y":0.1147203950870006},{"x":0.16244725041121008,"h":0.016036184210526327,"w":0.5400844018612956,"text":"白唯一希望，似乎全部維繫在迪蘭達爾眾人身上了⋯⋯","conf":0.30000001192092896,"y":0.08717105272683134},{"x":0.166666667387098,"h":0.014802631578947345,"w":0.05274261438192218,"text":"096","conf":1,"y":0.05222039458906025}]