[{"h":0.028324795396704405,"x":0.3647406147058197,"conf":0.5,"text":"移動時的AP消耗量","y":0.8816980803966606,"w":0.33591463002498506},{"h":0.02383014716600118,"x":0.17910310091134807,"conf":0.5,"text":"基本上，機體在戰場上每移動一格就會消耗一點A P點數。但如果玩家機","y":0.8130153512525798,"w":0.7198331919376492},{"h":0.02324242184036651,"x":0.15385196825873773,"conf":0.5,"text":"體上裝備了噴射背包．．一類的輔助裝備的話，那機體移動時消耗的AP","y":0.7825159289107789,"w":0.7408325632318392},{"h":0.02115899716552927,"x":0.15586086767233467,"conf":1,"text":"值就會根據背包的能力相對地增加。","y":0.7536851042201305,"w":0.35913067728921166},{"h":0.03905512784656717,"x":0.3189521596982953,"conf":0.30000001192092896,"text":"戰鬥選單","y":0.6033891028055209,"w":0.18739688481806577},{"h":0.02332372414438344,"x":0.17279149392525334,"conf":1,"text":"當機體結束移動之後（或是在移動前直接把游標移到機體上按下〇鈕），","y":0.5327586546889085,"w":0.7156008627078982},{"h":0.02171543318974334,"x":0.14955721478688716,"conf":1,"text":"畫面上就會顯示如下所示的戰鬥選單：","y":0.5066012416252632,"w":0.3802110403420533},{"h":0.013234394161324659,"x":0.22362869281879788,"conf":0.5,"text":"選單指令","y":0.45058139538751585,"w":0.07172995592358572},{"h":0.014534882808986516,"x":0.6139240506102351,"conf":1,"text":"效果","y":0.44767441920597195,"w":0.03797468308332708},{"h":0.017312647480713705,"x":0.3795962157559765,"conf":1,"text":"利用本指令就可以以裝備中的武器攻擊射程範圍內的敵人","y":0.4265638152477216,"w":0.437007785696972},{"h":0.010336979831519821,"x":0.16877637129856846,"conf":0.5,"text":"Attack","y":0.4329769737406316,"w":0.09915611795138632},{"h":0.017772912979125977,"x":0.3795469440175015,"conf":0.5,"text":"利用本指令可以詳細檢查機體與駕駛員的情報","y":0.40476534567413214,"w":0.3505920555824881},{"h":0.0117332535354715,"x":0.16865970079864148,"conf":0.5,"text":"Status","y":0.41053918104850706,"w":0.1015505551722852},{"h":0.01323439416132477,"x":0.1666666672685402,"conf":0.5,"text":"End","y":0.38808139549789,"w":0.05063290926038791},{"h":0.0145348843775297,"x":0.3776371286262922,"conf":1,"text":"結束本機體行動回合","y":0.38517441829452015,"w":0.17721519379171957},{"h":0.017346913877286485,"x":0.32475020481714184,"conf":0.5,"text":"一以下僅有裝備特定背包時才能使用相對應的指令一","y":0.3413817414196001,"w":0.39690677761178034},{"h":0.011873531106271318,"x":0.16605558266492487,"conf":0.30000001192092896,"text":"Ttem","y":0.30694665451721115,"w":0.06879819264559872},{"h":0.015161741721002708,"x":0.37754803321946445,"conf":1,"text":"可以使用道具","y":0.30346564078257643,"w":0.10566342702059872},{"h":0.011924342105263164,"x":0.16666666799643273,"conf":0.5,"text":"Repairs","y":0.2861842105713507,"w":0.1160337498193709},{"h":0.01818853773568807,"x":0.3774646573078933,"conf":1,"text":"可以幫範圍內的我方機體恢復HP，修復破損零件，回復異常狀態","y":0.27908360174844093,"w":0.5066648496932802},{"h":0.012802765557640483,"x":0.16413612963049834,"conf":0.30000001192092896,"text":"EMP","y":0.2628798927899041,"w":0.049306678316758196},{"h":0.01736876054813985,"x":0.37745423509110376,"conf":1,"text":"可以針對一定範圍內的敵人進行狀態異常攻擊","y":0.2582560038649855,"w":0.34847359668667965},{"h":0.01959789348276042,"x":0.3753061322420346,"conf":1,"text":"利用本指令，可以幫助我方友機無視飛彈原本的射程發射飛彈，然","y":0.23503979278602438,"w":0.5067689663470503},{"h":0.014586880018836568,"x":0.16609647873202393,"conf":0.5,"text":"Sensors","y":0.22843940799165074,"w":0.1150100453087709},{"h":0.017316137489519656,"x":0.3753703470511903,"conf":1,"text":"後準確誘導該飛彈命中本機體周圍一定範圍內之敵機","y":0.21470303317552653,"w":0.4032558177137717},{"h":0.018273954328737685,"x":0.3753393215544163,"conf":1,"text":"裝有通信背包的機體可以利用本指令呼叫航空部隊進行爆擊任務。","y":0.19258049482847062,"w":0.5045662017312426},{"h":0.01383575012809346,"x":0.16426255520721353,"conf":0.30000001192092896,"text":"Air Support","y":0.18642542733237866,"w":0.18620232921227067},{"h":0.0198098891659787,"x":0.37320054620911447,"conf":1,"text":"基本上在本作中只有デュランダル部隊能執行本指令","y":0.17059571481204305,"w":0.4034323680941415},{"h":0.013215268913068345,"x":0.14135021240156784,"conf":1,"text":"※請注意：","y":0.11759868457383593,"w":0.0864978872221808},{"h":0.01954899806725352,"x":0.13909470977145927,"conf":1,"text":"●根據玩家的機體整備與操作者技能配置狀況的不同，選單中也可能會多出一些指揮型的應用指","y":0.08663604993006535,"w":0.7344638578647078},{"h":0.013263081249437758,"x":0.15822784860096778,"conf":1,"text":"令。","y":0.07267441871632863,"w":0.033755272840258616},{"h":0.013157894344706267,"x":0.1476793238190578,"conf":0.5,"text":"014","y":0.04358552635933377,"w":0.04852320869099838}]