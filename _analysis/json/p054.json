[{"h":0.021054802756560465,"x":0.156028819076853,"y":0.9002304494941931,"conf":1,"w":0.7428066645146554,"text":"有價值的情報，眾人只好先回收敵方機甲的殘骸然後返回德國。在返航的途"},{"h":0.02976016621840627,"x":0.15587863807120367,"y":0.8658813806269435,"conf":1,"w":0.7410385386756042,"text":"中，哈米茲從殘骸上發現了敵方機甲腳部所使用的『步行安定控制程式』。"},{"h":0.021981113051113388,"x":0.1560121447530592,"y":0.8373168046052792,"conf":1,"w":0.7407211995636933,"text":"經過資料分析之後，哈米茲認為敵方所使用的雷霆機甲很有可能是由一家名"},{"h":0.02773152527056233,"x":0.15592895026011216,"y":0.8038952225336233,"conf":1,"w":0.7408884271517004,"text":"叫『多米特里公社』的企業所製造的。不過根據吉德的瞭解，『多米特里公"},{"h":0.023255814062921543,"x":0.15400842400230383,"y":0.7761627907883066,"conf":1,"w":0.7426160571114261,"text":"社』是設在『薩夫特拉共和國』（位於俄羅斯地區的新興小國）裡頭的一家"},{"h":0.021357904923589577,"x":0.1538983995661006,"y":0.7451390384109311,"conf":1,"w":0.7428361624123656,"text":"公司，而且這家企業並沒有對外出口雷霆機甲，為什麼該公司生產的機甲會"},{"h":0.024824050696272693,"x":0.1561181494735202,"y":0.7136627912866016,"conf":1,"w":0.15611813347208758,"text":"出現在德國呢？"},{"h":0.021578845224882404,"x":0.17707503900663024,"y":0.651559293202878,"conf":1,"w":0.717585087960546,"text":"眾人返回德國基地與瓦古納小隊長交談，正當他們討論到有關敵軍機甲的"},{"h":0.021875052075637003,"x":0.1517787543241652,"y":0.6202649234616155,"conf":1,"w":0.7428631111090395,"text":"線索同時，基地內突然發生了大爆炸，神祕敵軍不知道從什麼地方冒出來"},{"h":0.022299995547846674,"x":0.1538540841947919,"y":0.5887849678707453,"conf":0.5,"w":0.7408077995646256,"text":"開始攻擊眾人。面對突如其來的攻擊，哈米茲直覺的反應就是一一他們被敵"},{"h":0.02160426660587922,"x":0.1517749375495601,"y":0.5581482365730418,"conf":1,"w":0.7407648273185784,"text":"軍跟蹤了，但愛爾莎直呼不可能，因為敵軍的前進據點裡頭並沒有運輸機可"},{"h":0.0218604599174701,"x":0.15176951837452002,"y":0.5269140843023485,"conf":1,"w":0.7407799768561679,"text":"以讓他們使用。無論如何，現在並不是討論問題的好時機，在吉德的指示之"},{"h":0.022549718618392944,"x":0.15175071403775267,"y":0.4953131930285297,"conf":1,"w":0.7408187247119258,"text":"下，眾人紛紛搭乘機甲出來抗敵。奇怪的是，當眾人好不容易才將敵軍擊退"},{"h":0.02101765808306233,"x":0.14966215346966935,"y":0.46385115401257127,"conf":0.30000001192092896,"w":0.7365667302170346,"text":"之後，愛爾莎卻赫然發現一一瓦古納小隊長眼睛竟然變成了紅色⋯⋯⋯？"},{"h":0.024262393775739133,"x":0.17288181363203914,"y":0.40239682553026224,"conf":1,"w":0.7175538420392676,"text":"更令人不解的事情還在後頭，當愛爾莎將他們發現的證據交給『布拉尼貝"},{"h":0.02034883750112426,"x":0.1497890235782313,"y":0.3720930231475861,"conf":1,"w":0.7405063383334577,"text":"爾』部隊的葛雷薩准將之後，葛雷薩竟然要愛爾莎眾人先回英國待命。由於"},{"h":0.022423334811863094,"x":0.14962119393263767,"y":0.33935820467369815,"conf":1,"w":0.7408173408599343,"text":"愛爾莎擔心他們發現的證據可能不夠充份，因此愛爾莎一直向葛雷薩表示一"},{"h":0.02160533164676859,"x":0.14545120180979362,"y":0.308695463163174,"conf":0.5,"w":0.7449579716866794,"text":"一希望葛雷薩能夠對議會的成員多加勸說，等證據足夠之後再發表出來，以"},{"h":0.02917635127117757,"x":0.1474231469133214,"y":0.2744782100364752,"conf":1,"w":0.7431229111118363,"text":"免讓世人誤以為『多米特里公社』跟『薩夫特拉共和國』就是這次事件的幕"},{"h":0.027578807190844934,"x":0.1474614389747629,"y":0.2452298807558826,"conf":1,"w":0.74097007441919,"text":"後黑手。然而葛雷薩准將竟然表示：『查證的工作那是政治家事情！軍人"},{"h":0.023339462907690733,"x":0.1454323106350179,"y":0.21434767145149092,"conf":0.5,"w":0.7429059376864559,"text":"只要聽命令行事、將發現的東西全部交給上面去處理就行了！』。 看到葛"},{"h":0.02257400280550903,"x":0.14750780970400998,"y":0.18438890429596755,"conf":1,"w":0.7387272873471061,"text":"雷薩准將如此生氣咆哮的樣子，吉德與愛爾莎也很不悅的離開調查本部了，"},{"h":0.022547148560222774,"x":0.1454177882457776,"y":0.15341984770821693,"conf":1,"w":0.7408195258893944,"text":"就在他們準備返回英國的同時，愛爾莎遇見了一個名叫弗雷迪瑞克的自由新"},{"h":0.0145635714656428,"x":0.1455696212439818,"y":0.12787828935372836,"conf":1,"w":0.10970463900691288,"text":"聞記者⋯・"},{"h":0.014802631578947345,"x":0.14978903049136522,"y":0.04934210493298741,"conf":1,"w":0.05063290926038791,"text":"054"}]