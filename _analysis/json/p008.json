[{"w":0.31718830846090024,"text":"開始遊戲的方法","h":0.03675313686069692,"conf":0.5,"x":0.3308572398740814,"y":0.8587969349658183},{"w":0.47710089125894983,"text":"開始新遊戲＜ニューゲーム＞","h":0.028420768286052445,"conf":1,"x":0.2867741500998553,"y":0.7644490952547249},{"w":0.7196573699004325,"text":"只要玩家把遊戲光碟正確裝入PS 2主機中並打開電源，經過公司商標宣","h":0.021946521181809286,"conf":0.5,"x":0.17919852659939278,"y":0.6973260817413207},{"w":0.7428818295280804,"text":"傳畫面之後就會顯示本遊戲的標題畫面。這時如果玩家不做任何動作放置一","h":0.02246928058172526,"conf":1,"x":0.1559697599187675,"y":0.6651220160246165},{"w":0.7408075082273642,"text":"段時間的話，遊戲就會自動進入展示模式。而在展示畫面中，只要玩家按下","h":0.022307698663912356,"conf":1,"x":0.15595926473092375,"y":0.6347321838844164},{"w":0.736599287155989,"text":"START鈕就可以隨時跳回標題畫面。此時如果再按一次S T ART鈕","h":0.021054253766411235,"conf":0.5,"x":0.15806809238771238,"y":0.6032294204050216},{"w":0.3333333454723859,"text":"話，畫面上就會顯示下列的選項：","h":0.01744186093932698,"conf":0.5,"x":0.15400843262870786,"y":0.5755813951181918},{"w":0.07187634379311791,"text":"選項名稱","h":0.01488157479386576,"conf":1,"x":0.2277749081287142,"y":0.4794778172879589},{"w":0.07383966104512008,"text":"選項機能","h":0.0145348843775297,"conf":1,"x":0.6012658233803935,"y":0.47819767411374825},{"w":0.08873162463058437,"text":"開始新遊戲","h":0.014898083711925358,"conf":1,"x":0.3839042295618271,"y":0.4576672372730677},{"w":0.13924050160410295,"text":"NEW GAME","h":0.013157894736842035,"conf":0.5,"x":0.19620253270005822,"y":0.45929276310631995},{"w":0.5086774074945928,"text":"讀取之前保存的遊戲進度。在這之前，玩家必須事先把存有本作紀","h":0.017431776774556984,"conf":1,"x":0.3817404824857406,"y":0.43347356003522375},{"w":0.06774721168390607,"text":"LOAD","h":0.012298294588139247,"conf":0.5,"x":0.23194917885890387,"y":0.4269903876073209},{"w":0.4200347317716102,"text":"錄的P S2專用8MB 記憶卡正確安裝到記憶卡插槽上","h":0.016600272373149316,"conf":0.5,"x":0.3838625698551572,"y":0.4122323063848482},{"w":0.5086767519857548,"text":"讀取之前在戰場上中斷的遊戲進度。在這之前，玩家必須事先把存","h":0.01750012604813822,"conf":1,"x":0.3817443238800473,"y":0.39019832113787045},{"w":0.5065454742504474,"text":"有本作中斷紀錄的P S 2專用8MB記憶卡正確安裝到記憶卡插槽","h":0.016865353835256447,"conf":0.5,"x":0.3838571296705469,"y":0.3686347882170079},{"w":0.13502110046532384,"text":"CONTINUE","h":0.013186581824955135,"conf":0.5,"x":0.19620252983230357,"y":0.37209302328443494},{"w":0.016877636420129294,"text":"上","h":0.013081395312359412,"conf":1,"x":0.3839662449966864,"y":0.35029069782347144},{"w":0.5065355323664045,"text":"調整遊戲音效輸出模式。其中ステレオ為立體聲，モノラル則為","h":0.017004795764621883,"conf":1,"x":0.38176317856038616,"y":0.32552263406007387},{"w":0.08461455570484969,"text":"SOUND","h":0.013792949287514955,"conf":0.5,"x":0.22140580220846798,"y":0.31795817653671643},{"w":0.05311322724335521,"text":"單聲道","h":0.013808369636535645,"conf":1,"x":0.3816712343777243,"y":0.30632255939362774},{"w":0.08661830055400696,"text":"DEV-6","h":0.013464679843501082,"conf":0.30000001192092896,"x":0.17504527999710365,"y":0.28614556707129657},{"w":0.06751055023266189,"text":"INFO","h":0.01323439416132477,"conf":0.30000001192092896,"x":0.2805907163042035,"y":0.28618421050274534},{"w":0.36708859099977637,"text":"可以觀賞本開發小組正在製作中的最新遊戲情報","h":0.014802631578947345,"conf":0.5,"x":0.3818565482758663,"y":0.2833059212575091},{"w":0.08438818665279127,"text":"※請注意：","h":0.013081395312359412,"conf":1,"x":0.14767932429234285,"y":0.18895348840710302},{"w":0.7343939369219868,"text":"調整遊戲音效輸出模式的動作只能在開始新遊戲時執行，遊戲執行中將無法變更音效輸出模式。","h":0.018265543799651285,"conf":1,"x":0.14545947228858638,"y":0.157828612522239},{"w":0.05063290926038794,"text":"008","h":0.013157894736842035,"conf":1,"x":0.1518987351377385,"y":0.0464638156185766}]